    ('NC','NCL','New Caledonia',540,'Oceania'),\n    ('NZ','NZL','New Zealand',554,'Oceania'),\n    ('NI','NIC','Nicaragua',558,'Americas'),\n    ('NE','NER','Niger',562,'Africa'),\n    ('NG','NGA','Nigeria',566,'Africa'),\n    ('NU','NIU','Niue',570,'Oceania'),\n    ('NF','NFK','Norfolk Island',574,'Oceania'),\n    ('MP','MNP','Northern Mariana Islands',580,'Oceania'),\n    ('NO','NOR','Norway',578,'Europe'),\n    ('OM','OMN','Oman',512,'Asia'),\n    ('PK','PAK','Pakistan',586,'Asia'),\n    ('PW','PLW','Palau',585,'Oceania'),\n    ('PS','PSE','Palestinian Territory',275,'Asia'),\n    ('PA','PAN','Panama',591,'Americas'),\n    ('PG','PNG','Papua New Guinea',598,'Oceania'),\n    ('PY','PRY','Paraguay',600,'Americas'),\n    ('PE','PER','Peru',604,'Americas'),\n    ('PH','PHL','Philippines',608,'Asia'),\n    ('PN','PCN','Pitcairn',612,'Oceania'),\n    ('PL','POL','Poland',616,'Europe'),\n    ('PT','PRT','Portugal',620,'Europe'),\n    ('PR','PRI','Puerto Rico',630,'Americas'),\n    ('QA','QAT','Qatar',634,'Asia'),\n    ('RE','REU','Réunion',638,'Africa'),\n    ('RO','ROU','Romania',642,'Europe'),\n    ('RU','RUS','Russian Federation',643,'Europe'),\n    ('RW','RWA','Rwanda',646,'Africa'),\n    ('BL','BLM','Saint Barthélemy',652,'Americas'),\n    ('SH','SHN','Saint Helena',654,'Africa'),\n    ('KN','KNA','Saint Kitts and Nevis',659,'Americas'),\n    ('LC','LCA','Saint Lucia',662,'Americas'),\n    ('MF','MAF','Saint Martin (French part)',663,'Americas'),\n    ('PM','SPM','Saint Pierre and Miquelon',666,'Americas'),\n    ('VC','VCT','Saint Vincent and the Grenadines',670,'Americas'),\n    ('WS','WSM','Samoa',882,'Oceania'),\n    ('SM','SMR','San Marino',674,'Europe'),\n    ('ST','STP','Sao Tome and Principe',678,'Africa'),\n    ('SA','SAU','Saudi Arabia',682,'Asia'),\n    ('SN','SEN','Senegal',686,'Africa'),\n    ('RS','SRB','Serbia',688,'Europe'),\n    ('SC','SYC','Seychelles',690,'Africa'),\n    ('SL','SLE','Sierra Leone',694,'Africa'),\n    ('SG','SGP','Singapore',702,'Asia'),\n    ('SK','SVK','Slovakia',703,'Europe'),\n    ('SI','SVN','Slovenia',705,'Europe'),\n    ('SB','SLB','Solomon Islands',90,'Oceania'),\n    ('SO','SOM','Somalia',706,'Africa'),\n    ('ZA','ZAF','South Africa',710,'Africa'),\n    ('GS','SGS','South Georgia and the South Sandwich Islands',239,'Antarctica'),\n    ('ES','ESP','Spain',724,'Europe'),\n    ('LK','LKA','Sri Lanka',144,'Asia'),\n    ('SD','SDN','Sudan',736,'Africa'),\n    ('SR','SUR','Suriname',740,'Americas'),\n    ('SJ','SJM','Svalbard and Jan Mayen',744,'Europe'),\n    ('SZ','SWZ','Swaziland',748,'Africa'),\n    ('SE','SWE','Sweden',752,'Europe'),\n    ('CH','CHE','Switzerland',756,'Europe'),\n    ('SY','SYR','Syrian Arab Republic',760,'Asia'),\n    ('TW','TWN','Taiwan',158,'Asia'),\n    ('TJ','TJK','Tajikistan',762,'Asia'),\n    ('TZ','TZA','Tanzania',834,'Africa'),\n    ('TH','THA','Thailand',764,'Asia'),\n    ('TL','TLS','Timor-Leste',626,'Asia'),\n    ('TG','TGO','Togo',768,'Africa'),\n    ('TK','TKL','Tokelau',772,'Oceania'),\n    ('TO','TON','Tonga',776,'Oceania'),\n    ('TT','TTO','Trinidad and Tobago',780,'Americas'),\n    ('TN','TUN','Tunisia',788,'Africa'),\n    ('TR','TUR','Turkey',792,'Asia'),\n    ('TM','TKM','Turkmenistan',795,'Asia'),\n    ('TC','TCA','Turks and Caicos Islands',796,'Americas'),\n    ('TV','TUV','Tuvalu',798,'Oceania'),\n    ('UG','UGA','Uganda',800,'Africa'),\n    ('UA','UKR','Ukraine',804,'Europe'),\n    ('AE','ARE','United Arab Emirates',784,'Asia'),\n    ('GB','GBR','United Kingdom',826,'Europe'),\n    ('US','USA','United States',840,'Americas'),\n    ('UM','UMI','United States Minor Outlying Islands',581,'Oceania'),\n    ('UY','URY','Uruguay',858,'Americas'),\n    ('UZ','UZB','Uzbekistan',860,'Asia'),\n    ('VU','VUT','Vanuatu',548,'Oceania'),\n    ('VE','VEN','Venezuela',862,'Americas'),\n    ('VN','VNM','Viet Nam',704,'Asia'),\n    ('VG','VGB','Virgin Islands, British',92,'Americas'),\n    ('VI','VIR','Virgin Islands, U.S.',850,'Americas'),\n    ('WF','WLF','Wallis and Futuna',876,'Oceania'),\n    ('EH','ESH','Western Sahara',732,'Africa'),\n    ('YE','YEM','Yemen',887,'Asia'),\n    ('ZM','ZMB','Zambia',894,'Africa'),\n    ('ZW','ZWE','Zimbabwe',716,'Africa');\n\n  SELECT * FROM tmp_countries;\n#+end\n","platform":null}},{"fqn":"/retail/landing_ai/_config","id":"d70d80d6-a139-11f1-b6b0-6f90300261de","folder_id":"d70bfa31-a139-11f1-b6b0-6f90300261de","name":"_config","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+const\n  numStores = 100;\n  openDateStart = \"2021-01-01\";\n  openDateEnd = \"2022-12-31\";\n  closingDateEnd = \"2023-09-01\";\n  lastRemodelDateEnd = \"2023-09-01\";\n\n  numCustomers = 1000;\n\n  numProducts = 100;\n\n  numSalesTransations = 5000;\n  transactionsStartDate = \"2021-01-01\";\n  transactionsEndDate = \"2023-10-01\";\n\n  -- LLM pool sizes — keep bounded so each LLM block stays within token limits\n  namePoolSize = 200;\n  addrPoolSize = 100;\n  storeLocPoolSize = 100;\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_ai","id":"d71a2a53-a139-11f1-b6b0-6f90300261de","folder_id":"d71918dc-a139-11f1-b6b0-6f90300261de","name":"reports_ai","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/base/offering","id":"d7145dd0-a139-11f1-b6b0-6f90300261de","folder_id":"d71018f4-a139-11f1-b6b0-6f90300261de","name":"offering","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/reports/reports_ai/store_performance_narratives","id":"d71a7874-a139-11f1-b6b0-6f90300261de","folder_id":"d71a2a53-a139-11f1-b6b0-6f90300261de","name":"store_performance_narratives","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/print\"\n#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/mart\"\n\n-- Store Performance Narratives\n-- Computes sales performance metrics per active store, selects the top-10 and bottom-10\n-- by total revenue, then asks the LLM to generate a performance narrative and a specific\n-- operational recommendation for each store.\n-- Useful for operations reviews and district manager briefings.\n\n#+src sql StorePerformance()\n#+meta {\n  :doc \"Aggregates sales metrics per active store (revenue, basket size, revenue per size unit) and filters to the top-10 and bottom-10 performers by total revenue using window functions.\"\n}\n#+begin\n  WITH store_sales AS (\n    SELECT\n      b.business_unit_name,\n      b.market_region_name,\n      b.market_area_name,\n      b.size                                                               AS store_size,\n      b.size_unit_of_measure_code,\n      COUNT(DISTINCT f.transaction_id)                                     AS transaction_count,\n      COUNT(DISTINCT f.persona_key)                                        AS unique_customers,\n      ROUND(SUM(f.gross_sales_amount)::DECIMAL, 2)                         AS total_revenue,\n      ROUND(AVG(f.gross_sales_amount)::DECIMAL, 2)                         AS avg_basket_size,\n      ROUND(\n        SUM(f.gross_sales_amount) / NULLIF(b.size, 0)::DECIMAL, 2\n      )                                                                    AS revenue_per_size_unit\n    FROM {{ mart.FactSalesReturn() }}       AS f\n    JOIN {{ mart.BusinessUnitDimension() }} AS b  ON b.business_unit_key = f.business_unit_key\n    WHERE b.closing_date IS NULL\n    GROUP BY\n      b.business_unit_name,\n      b.market_region_name,\n      b.market_area_name,\n      b.size,\n      b.size_unit_of_measure_code\n  ),\n\n  ranked AS (\n    SELECT\n      *,\n      RANK()  OVER (ORDER BY total_revenue DESC) AS revenue_rank,\n      COUNT(*) OVER ()                           AS total_store_count\n    FROM store_sales\n  )\n\n  SELECT *\n  FROM ranked\n  WHERE revenue_rank        <= 10\n     OR revenue_rank        >  (total_store_count - 10)\n  ORDER BY revenue_rank\n#+end\n\n#+src llm StoreNarratives()\n#+meta {\n  :doc \"LLM block that reads top and bottom store performance metrics and generates a data-driven narrative insight and a specific operational recommendation for each store.\",\n  :schema {\n    :columns [\n      {:name \"business_unit_name\",  :type \"STRING\",\n       :description \"Store name exactly as it appears in the input data — do not alter\"},\n      {:name \"performance_tier\",    :type \"STRING\",\n       :description \"Exactly one of: Star Performer (top-10 stores), Underperformer (bottom-10 stores)\"},\n      {:name \"narrative_insight\",   :type \"STRING\",\n       :description \"2–3 sentence narrative explaining this store's performance using its specific metrics and market region context\"},\n      {:name \"recommended_action\",  :type \"STRING\",\n       :description \"One specific, actionable operational recommendation tailored to this store's metric profile (e.g. 'Expand floor space to capitalize on above-average revenue-per-size-unit', 'Launch targeted loyalty program — unique customer base is large but basket size is low')\"}\n    ]\n  },\n  :cache_results true\n}\n#+begin\nYou are a retail operations analyst preparing briefings for district managers. Below is a list\nof the top-10 and bottom-10 stores ranked by total revenue, with operational metrics.\n\n{{ print.Csv(StorePerformance()) }}\n\nColumn guide:\n- revenue_rank: 1 = highest revenue store in the network\n- avg_basket_size: average transaction value per sale line\n- revenue_per_size_unit: revenue divided by store floor size (SF = sq ft, SM = sq meters)\n- unique_customers: distinct customers who transacted at this store\n\nFor each store, write a fact-based performance narrative and one concrete operational recommendation.\n\nRules:\n- Return exactly one row per store using the exact business_unit_name from the input — no changes.\n- performance_tier: \"Star Performer\" for revenue_rank <= 10, \"Underperformer\" for all others.\n- narrative_insight: reference actual metric values (e.g. \"With X USD total revenue and an avg basket of Y USD...\") and the market region for context.\n- recommended_action: must be concrete and specific — avoid generic advice like \"improve marketing\".\n- Use plain ASCII only. No accented characters or special symbols.\n#+end\n\n#+src sql StorePerformanceNarratives()\n#+meta {\n  :doc \"Final report combining LLM-generated narratives with store performance metrics, ordered by revenue rank. Published to reports_ai.store_performance_narratives.\",\n  :publication {\n    :type  \"table\",\n    :name  \"store_performance_narratives\",\n    :schema \"reports_ai\"\n  }\n}\n#+begin\n  SELECT\n    sn.business_unit_name,\n    sn.performance_tier,\n    sn.narrative_insight,\n    sn.recommended_action,\n    sp.market_region_name,\n    sp.market_area_name,\n    sp.total_revenue,\n    sp.transaction_count,\n    sp.unique_customers,\n    sp.avg_basket_size,\n    sp.revenue_per_size_unit,\n    sp.store_size,\n    sp.size_unit_of_measure_code,\n    sp.revenue_rank,\n    sp.total_store_count\n  FROM {{ StoreNarratives() }}   AS sn\n  JOIN {{ StorePerformance() }}  AS sp  ON sp.business_unit_name = sn.business_unit_name\n  ORDER BY sp.revenue_rank\n#+end\n","platform":null}},{"fqn":"/retail/.actions/run_scripts/landing_ai","id":"d723a06f-a139-11f1-b6b0-6f90300261de","folder_id":"d721f2b4-a139-11f1-b6b0-6f90300261de","name":"landing_ai","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"std/test\"\n#+import \"coginiti.co/foundation/retail/landing\"\n#+import \"coginiti.co/foundation/retail/landing_ai\"\n#+import \"coginiti.co/foundation/retail/sources\"\n\n-- AI-driven landing run script.\n-- Alternative to run_scripts/landing — run one or the other, not both.\n--\n-- Step 1: Publish reference and transactional tables from the original landing package\n--         (countries, phone codes, channels, date calendar, sales).\n--         These are already real data — no benefit from LLM replacement.\n--\n-- Step 2: Publish AI-generated tables from landing_ai, overwriting the\n--         SQL-generated versions of landing.products, landing.customers, landing.stores.\n--         Also publishes the new landing.product_reviews table.\n--\n-- Step 3: Run source data quality tests (same tests as landing run script).\n\n{{ publication.Run(\n\n  blocks=[\n    landing.Countries,\n    landing.CountryPhoneCodes,\n    landing.InboundChannel,\n    landing.Date,\n    landing.Sales\n  ]\n  \n) }};\n\n\n{{ publication.Run(\n  \n  packages=[landing_ai]\n\n) }};\n\n\n{{ test.Run(\n  \n  packages=[sources]\n  \n) }};\n","platform":null}},{"fqn":"/retail/base","id":"d71018f4-a139-11f1-b6b0-6f90300261de","folder_id":"d70b5df0-a139-11f1-b6b0-6f90300261de","name":"base","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}}],"published_projects":[]}