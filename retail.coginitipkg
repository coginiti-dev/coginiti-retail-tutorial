{"entities":[{"fqn":"/retail/base/touchpoint/postal_code","id":"d713e89d-a139-11f1-b6b0-6f90300261de","folder_id":"d71261f3-a139-11f1-b6b0-6f90300261de","name":"postal_code","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base\"\n#+import \"coginiti.co/foundation/retail/sources\"\n\n#+src sql PostalCode()\n#+meta {\n  :doc `The postal or zip code of the address. We store rows for the basic postal code without any extension,\n        as well as the complete postal code with extension. This allows us to have a foreign key reference to\n        more or less granular dimension members and facts without creating completely separate postal code types\n        and adding to the hierarchy.\n        \n        For example, we will have the following Connecticut rows:\n        [\n          {\"POSTAL CODE\":\"06002\", \"POSTAL CODE EXTENSION\":NULL, \"POSTAL CODE fk reference\":\"06002\"},\n          {\"POSTAL CODE\":\"06002\", \"POSTAL CODE EXTENSION\":\"9001\", \"POSTAL CODE fk reference\":\"06002\"}\n        ].`,\n  :publication {\n    :type \"table\",\n    :name \"dim_postal_code\",\n    :schema \"base\"\n  }\n}\n#+begin\n  WITH source_rows AS (\n    SELECT\n      postal_code_nk AS natural_key,\n      postal_code,\n      row_hash\n    FROM\n      {{ sources.Customers() }}\n\n    UNION ALL\n\n    SELECT\n      postal_code_nk AS natural_key,\n      postal_code,\n      row_hash\n    FROM\n      {{ sources.Stores() }}\n  )\n\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS postal_code_key,\n    _t.postal_code,\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      *,\n      ROW_NUMBER() OVER (PARTITION BY natural_key ORDER BY natural_key DESC, row_hash) AS row_num\n    FROM\n      source_rows\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/common","id":"d7180768-a139-11f1-b6b0-6f90300261de","folder_id":"d715e47a-a139-11f1-b6b0-6f90300261de","name":"common","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"b85fe5b3-8448-11f1-a626-557cda040604"}}},{"fqn":"/retail/semantic_layer/customer/persona_dimension.smdl","id":"d720931c-a139-11f1-b6b0-6f90300261de","folder_id":"d72044fa-a139-11f1-b6b0-6f90300261de","name":"persona_dimension.smdl","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"daf4edec-8454-11f1-a626-557cda040604"},"asset_type":"SQL","content":"entity \"persona_dimension\" {\n  label       = \"Customer\"\n  description = \"Customer profile dimension. Each row represents a unique customer persona. Supports a Type-2 SCD pattern at the base layer; the mart layer exposes the current record per customer.\"\n  table_name  = \"persona_dimension\"\n  schema_name = \"mart\"\n  synonyms    = [\"customer\", \"client\", \"shopper\", \"buyer\", \"member\", \"persona\"]\n\n  # --- Surrogate key (used in relationships) ---\n\n  dimension \"persona_key\" {\n    label    = \"Persona Key\"\n    type     = \"text\"\n    expr     = \"persona_key\"\n    synonyms = [\"customer key\", \"persona surrogate key\", \"client key\", \"shopper key\"]\n  }\n\n  # --- Identity ---\n\n  dimension \"customer_id\" {\n    label       = \"Customer ID\"\n    description = \"Natural business key uniquely identifying the customer.\"\n    type        = \"text\"\n    expr        = \"customer_id\"\n    synonyms    = [\"customer id\", \"client id\", \"member id\", \"shopper id\", \"customer number\"]\n  }\n\n  # Helper dimensions required by the compound full_name expression below.\n  # Hidden to avoid exposing raw name parts separately in the UI.\n  dimension \"first_name\" {\n    label    = \"First Name\"\n    type     = \"text\"\n    expr     = \"first_name\"\n    hidden   = true\n    synonyms = [\"first name\", \"given name\", \"forename\"]\n  }\n\n  dimension \"last_name\" {\n    label    = \"Last Name\"\n    type     = \"text\"\n    expr     = \"last_name\"\n    hidden   = true\n    synonyms = [\"last name\", \"surname\", \"family name\"]\n  }\n\n  dimension \"full_name\" {\n    label       = \"Full Name\"\n    description = \"Customer full name. Composed from first_name and last_name — both helper dimensions must be defined in this entity.\"\n    type        = \"text\"\n    expr        = \"first_name || ' ' || last_name\"\n    synonyms    = [\"full name\", \"customer name\", \"client name\", \"name\"]\n  }\n\n  # --- Contact ---\n\n  dimension \"primary_email_address\" {\n    label       = \"Email Address\"\n    description = \"Primary email address on file for the customer.\"\n    type        = \"text\"\n    expr        = \"primary_email_address\"\n    synonyms    = [\"email\", \"email address\", \"contact email\", \"customer email\"]\n  }\n\n  dimension \"primary_complete_phone_number\" {\n    label       = \"Phone Number\"\n    description = \"Primary phone number including country code.\"\n    type        = \"text\"\n    expr        = \"primary_complete_phone_number\"\n    synonyms    = [\"phone number\", \"phone\", \"contact number\", \"mobile number\", \"telephone\"]\n  }\n\n  # --- Measures ---\n\n  measure \"customer_count\" {\n    label            = \"Customer Count\"\n    description      = \"Number of distinct customers.\"\n    type             = \"number\"\n    aggregation_type = \"count_distinct\"\n    expr             = \"persona_key\"\n    synonyms         = [\"number of customers\", \"total customers\", \"distinct customers\", \"client count\", \"shopper count\"]\n  }\n\n  # --- Relationships ---\n\n  # One customer → one RFM record (dimension extension)\n  relationship \"persona_to_rfm\" {\n    label = \"RFM Attributes\"\n    type  = \"one_to_one\"\n    expr  = \"persona_dimension.persona_key = persona_derived_attributes.persona_key\"\n  }\n}\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/product/product_metrics","id":"d71680be-a139-11f1-b6b0-6f90300261de","folder_id":"d71659ad-a139-11f1-b6b0-6f90300261de","name":"product_metrics","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"ed73633c-8448-11f1-a626-557cda040604"},"asset_type":"CSL","content":"-- Product performance metrics over the semantic layer\n-- Demonstrates: joining a fact and two dimension entities through the semantic SQL dialect.\n-- See semantic_csl_reporting/sales/sales_metrics for the read-only / CTE-only constraints\n-- that apply to every block in this reporting layer.\n\n#+src sql AnnualProductPerformance(year)\n#+meta {\n  :doc \"Per-product annual sales performance.\n        $Parameters:\n          - $year: calendar year to evaluate.\"\n}\n#+begin\n  SELECT\n    id.item_name AS item_name,\n    MEASURE(sf.total_quantity)      AS units_sold,\n    MEASURE(sf.total_sales_amount)  AS gross_sales,\n    MEASURE(sf.unique_transactions) AS transactions,\n    MEASURE(sf.avg_line_amount)     AS avg_line_value\n  FROM\n    sale_return_fact AS sf\n  JOIN\n    item_dimension AS id\n  JOIN\n    date_dimension AS dd\n  WHERE\n    dd.calendar_year = {{ year }}\n  GROUP BY\n    id.item_name\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_regular/customer_export_test","id":"d71966fe-a139-11f1-b6b0-6f90300261de","folder_id":"8f049129-a151-11f1-b6b0-6f90300261de","name":"customer_export_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"cdb1a31f-845a-11f1-a626-557cda040604"},"asset_type":"CSL","content":"-- Customer Export — Test Suite\n-- Goal: Validate the CustomerExport() report output before it is delivered to downstream\n--       consumers such as CRM systems or email platforms. Bad data at this stage can\n--       cause duplicate communications or corrupted customer records, so data quality\n--       checks are critical.\n--\n-- Tests included:\n--   1. Test_CustomerExport_HasData        – Fails if the export returns zero rows.\n--                                           Guards against overly restrictive parameter\n--                                           combinations ($min_orders / $min_sales too high,\n--                                           or an export_type that matches no customers).\n--   2. Test_CustomerExport_UniqueCustomer – Fails if any customer_id / first_name / last_name\n--                                           combination appears more than once. Duplicates\n--                                           would cause double-sends in email campaigns and\n--                                           must be resolved before the file is distributed.\n--\n-- Each test returns rows only on failure, so a clean run produces an empty result set.\n\n#+test sql Test_CustomerExport_HasData()\n#+meta {\n  :doc \"Verifies that the customer export contains data\"\n}\n#+begin\n  SELECT\n    COUNT(*) AS row_count\n  FROM\n    {{ CustomerExport() }}\n  HAVING\n    COUNT(*) = 0\n  ;\n#+end\n\n\n#+test sql Test_CustomerExport_UniqueCustomer()\n#+meta {\n  :doc \"Verifies that all exported customers are unique\"\n}\n#+begin\n  SELECT\n    customer_id,\n    first_name,\n    last_name,\n    COUNT(*) AS duplicate_count\n  FROM\n    {{ CustomerExport() }}\n  GROUP BY\n    customer_id,\n    first_name,\n    last_name\n  HAVING\n    COUNT(*) > 1\n  ;\n#+end\n","platform":null}},{"fqn":"/retail/reports","id":"d71918dc-a139-11f1-b6b0-6f90300261de","folder_id":"d70b5df0-a139-11f1-b6b0-6f90300261de","name":"reports","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"a696db4d-3cfe-11f1-a457-d9456ae162d8"}}},{"fqn":"/retail/semantic_layer/channel","id":"d720ba2d-a139-11f1-b6b0-6f90300261de","folder_id":"d71f3383-a139-11f1-b6b0-6f90300261de","name":"channel","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"2a59a0f7-3cff-11f1-a457-d9456ae162d8"}}},{"fqn":"/retail/mart/postal_address_dimension","id":"d71e9740-a139-11f1-b6b0-6f90300261de","folder_id":"d71dacd9-a139-11f1-b6b0-6f90300261de","name":"postal_address_dimension","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base/location\"\n#+import \"coginiti.co/foundation/retail/base/touchpoint\"\n\n#+src sql PostalAddressDimension()\n#+meta {\n  :doc \"This dimension stores a physical postal address. This may be the raw, normalized, or standardized address.\",\n  :publication {\n    :type \"table\",\n    :name \"postal_address_dimension\",\n    :schema \"mart\"\n  }\n}\n#+begin\n  SELECT\n    p.postal_address_key,\n    p.address_line_1,\n    p.address_line_2,\n    p.city_name AS city,\n    pc.postal_code\n  FROM\n    {{ touchpoint.PostalAddress() }} p\n  INNER JOIN {{ touchpoint.PostalCode() }} pc\n    ON pc.postal_code_key = p.postal_code_key\n#+end\n","platform":null}},{"fqn":"/retail/semantic_layer/location/business_unit_dimension.smdl","id":"d71f81a5-a139-11f1-b6b0-6f90300261de","folder_id":"d71f5a94-a139-11f1-b6b0-6f90300261de","name":"business_unit_dimension.smdl","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"81206867-8454-11f1-a626-557cda040604"},"asset_type":"SQL","content":"entity \"business_unit_dimension\" {\n  label       = \"Store\"\n  description = \"Physical store locations with their full denormalized geographic and market hierarchy. Covers all four hierarchy levels: Market Region → Market Area → District → Store Group.\"\n  table_name  = \"business_unit_dimension\"\n  schema_name = \"mart\"\n  synonyms    = [\"store\", \"store_dimension\", \"location\", \"branch\"]\n\n  # --- Surrogate key (used in relationships) ---\n\n  dimension \"business_unit_key\" {\n    label    = \"Store Key\"\n    type     = \"text\"\n    expr     = \"business_unit_key\"\n    synonyms = [\"store key\", \"store surrogate key\", \"branch key\"]\n  }\n\n  # --- Store identity ---\n\n  dimension \"business_unit_id\" {\n    label       = \"Store ID\"\n    description = \"Natural business key for the store (format: STNNNN).\"\n    type        = \"text\"\n    expr        = \"business_unit_id\"\n    synonyms    = [\"store id\", \"store number\", \"branch id\", \"location id\"]\n  }\n\n  dimension \"business_unit_name\" {\n    label       = \"Store Name\"\n    description = \"Display name of the store location.\"\n    type        = \"text\"\n    expr        = \"business_unit_name\"\n    synonyms    = [\"store name\", \"branch name\", \"location name\", \"outlet name\"]\n  }\n\n  # --- Lifecycle dates ---\n\n  dimension \"open_date\" {\n    label       = \"Open Date\"\n    description = \"Calendar date when the store first opened.\"\n    type        = \"date\"\n    expr        = \"open_date\"\n    synonyms    = [\"opening date\", \"store open date\", \"launch date\", \"inception date\"]\n  }\n\n  dimension \"closing_date\" {\n    label       = \"Closing Date\"\n    description = \"Calendar date when the store permanently closed. NULL if the store is still operating.\"\n    type        = \"date\"\n    expr        = \"closing_date\"\n    synonyms    = [\"close date\", \"closure date\", \"store closed date\", \"shutdown date\"]\n  }\n\n  dimension \"last_remodel_date\" {\n    label       = \"Last Remodel Date\"\n    description = \"Date of the most recent store remodel. NULL if the store has never been remodeled.\"\n    type        = \"date\"\n    expr        = \"last_remodel_date\"\n    synonyms    = [\"remodel date\", \"renovation date\", \"last renovation\", \"refurb date\"]\n  }\n\n  # --- Physical attributes ---\n\n  dimension \"size_unit_of_measure_code\" {\n    label       = \"Size Unit\"\n    description = \"Unit of measure used for store area fields. SF = square feet, SM = square meters.\"\n    type        = \"text\"\n    expr        = \"size_unit_of_measure_code\"\n    synonyms    = [\"area unit\", \"unit of measure\", \"size uom\", \"measurement unit\"]\n  }\n\n  dimension \"selling_area_size\" {\n    label       = \"Selling Area Size\"\n    description = \"Customer-facing selling floor area in the unit specified by size_unit_of_measure_code.\"\n    type        = \"float\"\n    expr        = \"selling_area_size\"\n    synonyms    = [\"sales floor size\", \"retail floor area\", \"selling floor\", \"shop floor size\"]\n  }\n\n  dimension \"size\" {\n    label       = \"Total Store Size\"\n    description = \"Total store footprint (including back-of-house) in the configured unit of measure.\"\n    type        = \"float\"\n    expr        = \"size\"\n    synonyms    = [\"store size\", \"total area\", \"floor area\", \"footprint\"]\n  }\n\n  # --- Contact ---\n\n  dimension \"email_address\" {\n    label       = \"Store Email\"\n    description = \"Primary email address for the store location.\"\n    type        = \"text\"\n    expr        = \"email_address\"\n    synonyms    = [\"store email\", \"email\", \"contact email\", \"branch email\"]\n  }\n\n  dimension \"complete_phone_number\" {\n    label       = \"Store Phone\"\n    description = \"Primary phone number for the store location, including country code.\"\n    type        = \"text\"\n    expr        = \"complete_phone_number\"\n    synonyms    = [\"store phone\", \"phone number\", \"contact number\", \"branch phone\"]\n  }\n\n  # --- Market hierarchy level 1: Region ---\n\n  dimension \"market_region_id\" {\n    label    = \"Market Region ID\"\n    type     = \"text\"\n    expr     = \"market_region_id\"\n    hidden   = true\n    synonyms = [\"region id\", \"regional id\", \"geographic region id\"]\n  }\n\n  dimension \"market_region_name\" {\n    label       = \"Market Region\"\n    description = \"Top-level geographic region (e.g., North America, Europe, Asia Pacific).\"\n    type        = \"text\"\n    expr        = \"market_region_name\"\n    synonyms    = [\"region\", \"geographic region\", \"sales region\", \"territory\"]\n  }\n\n  # --- Market hierarchy level 2: Area ---\n\n  dimension \"market_area_id\" {\n    label    = \"Market Area ID\"\n    type     = \"text\"\n    expr     = \"market_area_id\"\n    hidden   = true\n    synonyms = [\"area id\", \"market area id\", \"sub-region id\"]\n  }\n\n  dimension \"market_area_name\" {\n    label       = \"Market Area\"\n    description = \"Second-level geographic grouping within the market region (e.g., Northeast, Western Europe).\"\n    type        = \"text\"\n    expr        = \"market_area_name\"\n    synonyms    = [\"area\", \"market area\", \"sub-region\", \"sales area\"]\n  }\n\n  # --- Market hierarchy level 3: District ---\n\n  dimension \"district_id\" {\n    label    = \"District ID\"\n    type     = \"text\"\n    expr     = \"district_id\"\n    hidden   = true\n    synonyms = [\"district id\", \"zone id\"]\n  }\n\n  dimension \"district_name\" {\n    label       = \"District\"\n    description = \"Third-level geographic grouping within the market area.\"\n    type        = \"text\"\n    expr        = \"district_name\"\n    synonyms    = [\"district\", \"zone\", \"sales district\", \"retail zone\"]\n  }\n\n  # --- Market hierarchy level 4: Store Group ---\n\n  dimension \"store_group_id\" {\n    label    = \"Store Group ID\"\n    type     = \"text\"\n    expr     = \"store_group_id\"\n    hidden   = true\n    synonyms = [\"store group id\", \"cluster id\"]\n  }\n\n  dimension \"store_group_name\" {\n    label       = \"Store Group\"\n    description = \"Lowest-level grouping of stores within a district.\"\n    type        = \"text\"\n    expr        = \"store_group_name\"\n    synonyms    = [\"store group\", \"store cluster\", \"branch group\", \"retail cluster\"]\n  }\n\n  # --- Measures ---\n\n  measure \"store_count\" {\n    label            = \"Store Count\"\n    description      = \"Number of distinct store locations.\"\n    type             = \"number\"\n    aggregation_type = \"count_distinct\"\n    expr             = \"business_unit_key\"\n    synonyms         = [\"number of stores\", \"total stores\", \"branch count\", \"store count\"]\n  }\n\n  measure \"avg_selling_area\" {\n    label            = \"Avg Selling Area\"\n    description      = \"Average customer-facing selling area across stores in the configured unit of measure.\"\n    type             = \"float\"\n    aggregation_type = \"avg\"\n    expr             = \"selling_area_size\"\n    synonyms         = [\"average selling area\", \"mean floor size\", \"avg retail floor\", \"average shop floor\"]\n  }\n\n  measure \"max_store_size\" {\n    label            = \"Largest Store\"\n    description      = \"Total footprint of the largest store in scope.\"\n    type             = \"float\"\n    aggregation_type = \"max\"\n    expr             = \"size\"\n    synonyms         = [\"biggest store\", \"largest store size\", \"maximum store size\", \"largest branch\"]\n  }\n\n  measure \"min_store_size\" {\n    label            = \"Smallest Store\"\n    description      = \"Total footprint of the smallest store in scope.\"\n    type             = \"float\"\n    aggregation_type = \"min\"\n    expr             = \"size\"\n    synonyms         = [\"smallest store size\", \"minimum store size\", \"smallest branch\", \"tiniest store\"]\n  }\n}\n","platform":null}},{"fqn":"/retail/base/offering/offering_item","id":"d71484e1-a139-11f1-b6b0-6f90300261de","folder_id":"d7145dd0-a139-11f1-b6b0-6f90300261de","name":"offering_item","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/base\"\n#+import \"coginiti.co/foundation/retail/sources\"\n\n#+src sql OfferingItem()\n#+meta {\n  :doc \"A dimensional type generally representing the most granular level of the \\\"OFFERING\\\" dimension representing a unique item\n        that can be bought, viewed, downloaded, etc.\",\n  :publication {\n    :type \"table\",\n    :name \"dim_offering_item\",\n    :schema \"base\"\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS offering_item_key,\n    _t.product_id AS item_id,\n    _t.name AS item_name,\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      product_nk AS natural_key,\n      product_id,\n      name AS name,\n      ROW_NUMBER() OVER (PARTITION BY product_id ORDER BY product_id DESC, row_hash) AS row_num\n    FROM\n      {{ sources.Products() }}\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/sources/inbound_channels_test","id":"d71ce984-a139-11f1-b6b0-6f90300261de","folder_id":"d71b89ea-a139-11f1-b6b0-6f90300261de","name":"inbound_channels_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the inbound channels source.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_InboundChannels_UniqueID()\n#+meta {\n  :doc \"Fails if any channel_code appears more than once, indicating a duplicate entry in the inbound channels reference data.\"\n}\n#+begin\n  SELECT\n    channel_code,\n    COUNT(*) AS cnt\n  FROM\n    {{ InboundChannels() }}\n  GROUP BY\n    channel_code\n  HAVING\n    COUNT(*) > 1\n#+end\n","platform":null}},{"fqn":"/retail/base/sales","id":"d7108e27-a139-11f1-b6b0-6f90300261de","folder_id":"d71018f4-a139-11f1-b6b0-6f90300261de","name":"sales","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/.actions/run_scripts/all_reports_ai","id":"1b5c01de-a21a-11f1-b6b0-6f90300261de","folder_id":"d721f2b4-a139-11f1-b6b0-6f90300261de","name":"all_reports_ai","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"std/test\"\n#+import \"coginiti.co/foundation/retail/reports/reports_ai\"\n\n\n{{ publication.Run(\n\n  blocks=[reports_ai.ProductReviewInsights]\n\n) }};\n\n\n{{ test.Run(\n\n  tests=[\n    reports_ai.Test_ProductReviewInsights_HasData,\n    reports_ai.Test_ProductReviewInsights_UniqueProducts,\n    reports_ai.Test_ProductReviewInsights_ValidSentimentLabels,\n    reports_ai.Test_ProductReviewInsights_NoNullInsights,\n    reports_ai.Test_ProductReviewInsights_PositiveRevenue\n  ]\n\n) }};\n\n\n\n{{ publication.Run(\n\n  blocks=[reports_ai.StorePerformanceNarratives]\n\n) }};\n\n\n{{ test.Run(\n\n  tests=[\n    reports_ai.Test_StorePerformanceNarratives_HasData,\n    reports_ai.Test_StorePerformanceNarratives_UniqueStores,\n    reports_ai.Test_StorePerformanceNarratives_ValidPerformanceTiers,\n    reports_ai.Test_StorePerformanceNarratives_NoNullNarratives,\n    reports_ai.Test_StorePerformanceNarratives_PositiveRevenue,\n    reports_ai.Test_StorePerformanceNarratives_RankBounds\n  ]\n\n) }};\n","platform":null}},{"fqn":"/retail/base/touchpoint/phone_number","id":"d713c18c-a139-11f1-b6b0-6f90300261de","folder_id":"d71261f3-a139-11f1-b6b0-6f90300261de","name":"phone_number","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base\"\n#+import \"coginiti.co/foundation/retail/sources\"\n\n#+src sql PhoneNumber()\n#+meta {\n  :doc \"A dimensional type representing an actual complete phone number, including country code and area code.\",\n  :publication {\n    :type \"table\",\n    :name \"dim_phone_number\",\n    :schema \"base\",\n    :primary_key [\"phone_number_key\"],\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS phone_number_key,\n    _t.phone_number AS complete_number,\n    {{ base.SurrogateKey(\"_t.country_nk\") }} AS country_key,\n    FALSE AS mobile_flag,\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      phone_number_nk AS natural_key,\n      phone_number,\n      country_nk,\n      ROW_NUMBER() OVER (PARTITION BY phone_number ORDER BY phone_number DESC, row_hash) AS row_num\n    FROM\n      {{ sources.Customers() }}\n\n    UNION ALL\n\n    SELECT\n      phone_number_nk AS natural_key,\n      phone_number,\n      country_nk,\n      ROW_NUMBER() OVER (PARTITION BY phone_number ORDER BY phone_number DESC, row_hash) AS row_num\n    FROM\n      {{ sources.Stores() }}\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/.actions/retail_action.toml","id":"d721a492-a139-11f1-b6b0-6f90300261de","folder_id":"d7217d81-a139-11f1-b6b0-6f90300261de","name":"retail_action.toml","entity_type":"project_action","entity_version":"cepXb+WJs7iTh1SvXWjbBrONx7GpzRgsC+7LeNmHgFE=","data":{"copied_from_id":null,"asset_type":"PROJECT_ACTION","error":null,"content":"# This file defines a workflow with jobs and their execution steps.\n# Each job can have dependencies and contains a series of steps to execute.\n\n# GENERAL ACTION INFORMATION\n[general]\n  name = \"retail_workflow\"\n  description = \"This test workflow will be used for demo purposes, based on coginiti-retail-tutorial data that can be found here: https://github.com/coginiti-dev/coginiti-retail-tutorial \"\n\n\n# ENVIRONMENT CONFIGURATION\n[environment]\n  id = \"prod\"\n\n\n##################################################################################################################################################################\n\n# SCHEDULE CONFIGURATION\n[schedule]\n  cron = \"0 00 14 * * ?\"  # Daily at 2:00 PM (sec min hour day month dayOfWeek)\n  misfire_policy = \"RUN_IMMEDIATELY\"  # Run immediately if schedule is missed\n  timezone = \"Europe/Helsinki\"  # Explicit timezone for consistency, IANA with DST rules applied\n\n\n# TRIGGER CONFIGURATION\n# Run this action automatically in response to project events (in addition to the schedule above)\n[trigger]\ntypes = [\"review_created\", \"project_hub_published\"]  # Options: review_created, project_hub_published\n\n\n# JOBS CONFIGURATION\n[job.landing]\n  steps = [\"landing\"]\n  landing = { command = \"run_asset\", asset = \".actions/run_scripts/landing\" }\n\n\n[job.base]\n  depends_on = [\"landing\"]\n  steps = [\"base\"]\n  base = { command = \"run_asset\", asset = \".actions/run_scripts/base\" }\n\n\n[job.mart]\n  depends_on = [\"base\"]\n  steps = [\"mart\"]\n  mart = { command = \"run_asset\", asset = \".actions/run_scripts/mart\" }\n\n\n\n[job.reports]\n  depends_on = [\"mart\"]\n  steps = [\"report_daily_snapshot\", \"report_store_rankings\", \"report_customer_export\"]\n  report_daily_snapshot = { command = \"run_asset\", asset = \".actions/run_scripts/report_daily_snapshot\", parameters = { \"$snapshot_date\" = \"2023-10-01\", \"$lookback_days\" = \"30\", \"$snapshot_type\" = \"monthly\" } }\n  report_store_rankings = { command = \"run_asset\", asset = \".actions/run_scripts/report_store_rankings\", parameters = { \"$start_date\" = \"2023-01-01\", \"$end_date\" = \"2023-12-31\", \"$ranking_metric\" = \"sales_amount\", \"$top_n\" = \"50\" } }\n  report_customer_export = { command = \"run_asset\", asset = \".actions/run_scripts/report_customer_export\", parameters = { \"$export_type\" = \"high_value\", \"$min_orders\" = \"10\", \"$min_sales\" = \"5000\", \"$include_contact_info\" = \"true\" } }\n \n\n##################################################################################################################################################################\n\n\n\n# ENVIRONMENT CONFIGURATION (optional)\n# Define which project environment to use for connection setup\n# The environment ID references an environment defined in your project.toml file\n# [environment]\n# id = \"dev\"  # Environment ID from project.toml (e.g., dev, staging, prod)\n\n# SCHEDULE CONFIGURATION (optional)\n# Define when this action should be automatically executed\n# If schedule section is present, cron and misfire_policy are mandatory, timezone is optional\n# [schedule]\n# cron = \"0 0 12 * * ?\"  # Daily at noon (sec min hour day month dayOfWeek)\n# misfire_policy = \"RUN_IMMEDIATELY\"  # Options: SKIP, RUN_IMMEDIATELY\n# timezone = \"GMT+4\"  # Optional: IANA timezone identifier (defaults to user timezone)\n#\n# Common timezone examples:\n#   Americas: America/New_York, America/Chicago, America/Denver, America/Los_Angeles\n#   Europe: Europe/London, Europe/Paris, Europe/Berlin, Europe/Rome\n#   Asia: Asia/Tokyo, Asia/Shanghai, Asia/Kolkata, Asia/Dubai\n#   Australia: Australia/Sydney, Australia/Melbourne\n#   UTC: UTC (Coordinated Universal Time)\n\n#   GMT/UTC offset formats:\n#   GMT+1, GMT+3, GMT-3, GMT-8, GMT-11\n#   UTC+1, UTC+3, UTC-3, UTC-8, UTC-11\n#   +01:00, +03:00, +05:30, +09:30, -03:00, -08:00\n#\n# For the complete list of valid timezone identifiers, see:\n# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones\n\n# JOBS CONFIGURATION\n# Define your jobs below using the following pattern:\n# [job.<job_name>]\n\n# ------------------------------------------\n# Example Job Configuration\n# ------------------------------------------\n# Uncomment and modify the section below to create your first job\n\n# [job.example_job_1]\n# \n# # Job Dependencies (optional)\n# # List all jobs that must complete before this job starts\n# depends_on = [\"example_job\"]\n# \n# # Execution Steps (required)\n# # Steps will be executed in the order specified in this list\n# steps = [\"step1\", \"step2\"]\n# \n# # Step Definitions (required)\n# # Currently supported commands:\n# #   - run_asset: Execute an asset located at the specified path\n# #\n# # Parameters (optional):\n# #   - parameters: Key-value pairs passed to the asset during execution\n# #     If parameters are defined here, they override any external parameters from scheduled events\n# step1 = { command = \"run_asset\", asset = \"/path/to/asset1\" }\n# \n# step2 = { command = \"run_asset\", asset = \"/path/to/asset2\", parameters = { \"$param\" = \"value\", \"$param2\" = \"value2\" } }\n\n# ==========================================\n# ADDITIONAL JOBS\n# ==========================================\n# Add more jobs here following the same pattern:\n\n# [job.your_job_name]\n# steps = [\"init\", \"process\", \"cleanup\"]\n# \n# init = { command = \"run_asset\", asset   = \"/initialize\" }\n# \n# process = { command = \"run_asset\", asset = \"/main_process\", parameters = { \"environment\" = \"production\" } }\n# \n# cleanup = { command = \"run_asset\", asset = \"/cleanup\" }\n"}},{"fqn":"/retail/.actions/run_scripts","id":"d721f2b4-a139-11f1-b6b0-6f90300261de","folder_id":"d7217d81-a139-11f1-b6b0-6f90300261de","name":"run_scripts","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/base/datetime","id":"d7140fae-a139-11f1-b6b0-6f90300261de","folder_id":"d71018f4-a139-11f1-b6b0-6f90300261de","name":"datetime","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/base/touchpoint/email_domain_test","id":"d7132548-a139-11f1-b6b0-6f90300261de","folder_id":"d71261f3-a139-11f1-b6b0-6f90300261de","name":"email_domain_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the email domain dimension.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_EmailDomain_NoDuplicatesInPK()\n#+meta {\n  :doc \"Fails if any email_domain_key appears more than once, indicating a surrogate key collision in the email domain dimension.\"\n}\n#+begin\n  SELECT  \n    email_domain_key,\n    COUNT(*) AS cnt\n  FROM\n    {{ EmailDomain() }}\n  GROUP BY\n    email_domain_key\n  HAVING\n    COUNT(*) > 1\n#+end\n","platform":null}},{"fqn":"/retail/semantic_layer","id":"d71f3383-a139-11f1-b6b0-6f90300261de","folder_id":"d70b5df0-a139-11f1-b6b0-6f90300261de","name":"semantic_layer","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"2a59a0f0-3cff-11f1-a457-d9456ae162d8"}}},{"fqn":"/retail/reports/reports_ai/product_review_insights_test","id":"d71b62d9-a139-11f1-b6b0-6f90300261de","folder_id":"d71a2a53-a139-11f1-b6b0-6f90300261de","name":"product_review_insights_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the product review insights report.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_ProductReviewInsights_HasData()\n#+meta {\n  :doc \"Fails if the report is empty, indicating the LLM or source join produced no rows.\"\n}\n#+begin\n  SELECT \n    COUNT(*) AS row_count\n  FROM \n    {{ ProductReviewInsights() }}\n  HAVING \n    COUNT(*) = 0\n#+end\n\n#+test sql Test_ProductReviewInsights_UniqueProducts()\n#+meta {\n  :doc \"Fails if any product appears more than once, indicating a duplicate join or duplicate LLM output row.\"\n}\n#+begin\n  SELECT \n    item_name, \n    COUNT(*) AS cnt\n  FROM \n    {{ ProductReviewInsights() }}\n  GROUP BY \n    item_name\n  HAVING \n    COUNT(*) > 1\n#+end\n\n#+test sql Test_ProductReviewInsights_ValidSentimentLabels()\n#+meta {\n  :doc \"Fails if the LLM returned a sentiment_label outside the allowed set: Positive, Mixed, Negative.\"\n}\n#+begin\n  SELECT \n    item_name, \n    sentiment_label\n  FROM \n    {{ ProductReviewInsights() }}\n  WHERE \n    sentiment_label NOT IN ('Positive', 'Mixed', 'Negative')\n#+end\n\n#+test sql Test_ProductReviewInsights_NoNullInsights()\n#+meta {\n  :doc \"Fails if any LLM-generated text column (sentiment_label, key_customer_theme, marketing_recommendation) is null.\"\n}\n#+begin\n  SELECT *\n  FROM {{ ProductReviewInsights() }}\n  WHERE sentiment_label       IS NULL\n     OR key_customer_theme    IS NULL\n     OR marketing_recommendation IS NULL\n#+end\n\n#+test sql Test_ProductReviewInsights_PositiveRevenue()\n#+meta {\n  :doc \"Fails if any product row has a non-positive total_revenue, indicating a data join or aggregation error.\"\n}\n#+begin\n  SELECT \n    item_name, \n    total_revenue\n  FROM \n    {{ ProductReviewInsights() }}\n  WHERE \n    total_revenue <= 0\n#+end\n","platform":null}},{"fqn":"/retail/base/location/inbound_channel","id":"d711c6af-a139-11f1-b6b0-6f90300261de","folder_id":"d711788c-a139-11f1-b6b0-6f90300261de","name":"inbound_channel","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base\"\n#+import \"coginiti.co/foundation/retail/sources\"\n\n#+src sql InboundChannel()\n#+meta {\n  :doc \"Describes the channels by which customers can interact such as store, web, mobile app, call center.\",\n  :publication {\n    :type \"table\",\n    :name \"dim_inbound_channel\",\n    :schema \"base\",\n    :primary_key [\"inbound_channel_key\"],\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS inbound_channel_key,\n    _t.channel_code AS inbound_channel_code,\n    _t.channel_name AS inbound_channel_name, \n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      inbound_channel_nk AS natural_key,\n      channel_code,\n      channel_name,\n      ROW_NUMBER() OVER (PARTITION BY inbound_channel_nk ORDER BY inbound_channel_nk DESC, row_hash) AS row_num\n    FROM\n      {{ sources.InboundChannels() }}\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/sales/sales_metrics","id":"d716329c-a139-11f1-b6b0-6f90300261de","folder_id":"d7160b8b-a139-11f1-b6b0-6f90300261de","name":"sales_metrics","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"f5a99751-8448-11f1-a626-557cda040604"},"asset_type":"CSL","content":"-- Sales metrics over the semantic layer\n-- Demonstrates: CSL blocks whose body is semantic SQL (MEASURE(), business entity names)\n--               instead of physical-table SQL.\n--\n-- These blocks run against the semantic layer connection (see the \"semantic_layer_csl\"\n-- environment in project.toml), not the physical \"retail_csl\" database. Two consequences:\n--   1. No :publication metadata anywhere in this package — the semantic layer connection\n--      is read-only (SELECT only, no DDL/DML), so a block can never be materialized as a\n--      table or view. It only exists to be referenced by other CSL blocks or run directly.\n--   2. Every reference to one of these blocks compiles to a CTE. The semantic layer has no\n--      temporary or permanent tables to fall back to, so any chain built on top of these\n--      blocks (see semantic_csl_reporting/reports) must stay inside a single SELECT\n--      statement — one WITH ... chain — all the way through to the final report.\n\n#+src sql MonthlySales(yearFrom)\n#+meta {\n  :doc \"Monthly sales totals from the sale_return_fact entity.\n        $Parameters:\n          - $yearFrom: earliest calendar year (inclusive) to include.\"\n}\n#+begin\n  SELECT\n    dd.calendar_year  AS calendar_year,\n    dd.calendar_month AS calendar_month,\n    MEASURE(sf.total_sales_amount)  AS gross_sales,\n    MEASURE(sf.unique_transactions) AS transactions,\n    MEASURE(sf.total_quantity)      AS units_sold\n  FROM\n    sale_return_fact AS sf\n  JOIN\n    date_dimension AS dd\n  WHERE\n    dd.calendar_year >= {{ yearFrom }}\n  GROUP BY\n    dd.calendar_year,\n    dd.calendar_month\n#+end\n\n#+src sql SalesByChannelFiscalYear(yearFrom, yearTo)\n#+meta {\n  :doc \"Sales aggregated by inbound channel and fiscal year, excluding test channels.\n        $Parameters:\n          - $yearFrom: earliest fiscal year (inclusive)\n          - $yearTo: latest fiscal year (inclusive)\"\n}\n#+begin\n  SELECT\n    dd.fiscal_year          AS fiscal_year,\n    ic.inbound_channel_code AS channel_code,\n    ic.inbound_channel_name AS channel_name,\n    MEASURE(sf.total_sales_amount)  AS gross_sales,\n    MEASURE(sf.unique_transactions) AS transactions,\n    MEASURE(sf.total_quantity)      AS units_sold,\n    MEASURE(sf.avg_line_amount)     AS avg_basket\n  FROM\n    sale_return_fact AS sf\n  JOIN\n    inbound_channel_dimension AS ic\n  JOIN\n    date_dimension AS dd\n  WHERE\n    dd.fiscal_year BETWEEN {{ yearFrom }} AND {{ yearTo }}\n    AND ic.inbound_channel_code NOT LIKE 'TEST%'\n  GROUP BY\n    dd.fiscal_year,\n    ic.inbound_channel_code,\n    ic.inbound_channel_name\n  HAVING\n    MEASURE(sf.total_sales_amount) > 0\n#+end\n\n#+src sql SalesByStoreYear(yearFrom, yearTo)\n#+meta {\n  :doc \"Sales aggregated by store and its market hierarchy, active stores only.\n        $Parameters:\n          - $yearFrom: earliest calendar year (inclusive)\n          - $yearTo: latest calendar year (inclusive)\"\n}\n#+begin\n  SELECT\n    bu.market_region_name AS market_region_name,\n    bu.market_area_name   AS market_area_name,\n    bu.business_unit_id   AS store_id,\n    bu.business_unit_name AS store_name,\n    bu.selling_area_size  AS store_size,\n    MEASURE(sf.total_sales_amount)  AS gross_sales,\n    MEASURE(sf.unique_transactions) AS transaction_count,\n    MEASURE(sf.total_quantity)      AS units_sold\n  FROM\n    sale_return_fact AS sf\n  JOIN\n    business_unit_dimension AS bu\n  JOIN\n    date_dimension AS dd\n  WHERE\n    dd.calendar_year BETWEEN {{ yearFrom }} AND {{ yearTo }}\n    AND bu.closing_date IS NULL\n  GROUP BY\n    bu.market_region_name,\n    bu.market_area_name,\n    bu.business_unit_id,\n    bu.business_unit_name,\n    bu.selling_area_size\n#+end\n","platform":null}},{"fqn":"/retail/sources/sales","id":"d71c4d3f-a139-11f1-b6b0-6f90300261de","folder_id":"d71b89ea-a139-11f1-b6b0-6f90300261de","name":"sales","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+src sql Sales()\n#+begin\n  SELECT\n    transaction_id,\n    transaction_timestamp AS transaction_datetime,\n    line_number,\n    customer_id,\n    store_id,\n    product_id,\n    quantity,\n    product_price AS price,\n    {{ NaturalKey(\"SH^\", [\"transaction_id\"]) }} AS sales_header_nk,\n    {{ NaturalKey(\"SD^\", [\"transaction_id\", \"line_number\"]) }} AS sales_detail_nk,\n    {{ NaturalKey(\"DATE^\", [\"DATE(transaction_timestamp)\"]) }} AS date_nk,\n    {{ NaturalKey(\"PER^\", [\"customer_id\"]) }} AS persona_nk,\n    {{ NaturalKey(\"STORE^\", [\"store_id\"]) }} AS store_nk,\n    {{ NaturalKey(\"PRD^\", [\"product_id\"]) }} AS product_nk\n  FROM\n    landing.sales\n#+end\n\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/product","id":"d71659ad-a139-11f1-b6b0-6f90300261de","folder_id":"d715e47a-a139-11f1-b6b0-6f90300261de","name":"product","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"ccf8b979-8448-11f1-a626-557cda040604"}}},{"fqn":"/retail/landing/date_calendar","id":"d70f559f-a139-11f1-b6b0-6f90300261de","folder_id":"d70e1d18-a139-11f1-b6b0-6f90300261de","name":"date_calendar","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n\n-- Calendar dimension source data.\n-- Generates one row per day from 2020-01-01 for 5000 days (~13.7 years).\n-- Fiscal attributes are derived by applying a +3 month offset to the calendar date.\n\n#+src sql Date()\n#+meta {\n  :doc \"Source data for the calendar. The fiscal attributes is generated by adding a 3 month offset.\",\n  :publication {\n    :type \"table\",\n    :name \"date_calendar\",\n    :schema \"landing\"\n  }\n}\n#+begin\n  SELECT\n    d::DATE                                                                AS business_day_date,\n    EXTRACT(YEAR    FROM d)::INTEGER                                       AS calendar_year,\n    EXTRACT(QUARTER FROM d)::INTEGER                                       AS calendar_quarter,\n    EXTRACT(MONTH   FROM d)::INTEGER                                       AS calendar_month,\n    EXTRACT(WEEK    FROM d)::INTEGER                                       AS calendar_week,\n    EXTRACT(DOW     FROM d)::INTEGER                                       AS calendar_week_day,\n    CASE\n      WHEN d IN (\n        '2020-01-01', '2020-07-04', '2020-12-25',\n        '2021-01-01', '2021-07-04', '2021-12-25',\n        '2022-01-01', '2022-07-04', '2022-12-25'\n      ) THEN TRUE ELSE FALSE\n    END                                                                    AS calendar_holiday_flag,\n    EXTRACT(YEAR    FROM d + '3 months'::INTERVAL)::INTEGER                AS fiscal_year,\n    EXTRACT(QUARTER FROM d + '3 months'::INTERVAL)::INTEGER                AS fiscal_quarter,\n    MOD(EXTRACT(MONTH FROM d + '3 months'::INTERVAL)::INTEGER + 3, 12) + 1 AS fiscal_period,\n    EXTRACT(WEEK    FROM d + '3 months'::INTERVAL)::INTEGER                AS fiscal_week,\n    EXTRACT(DOW     FROM d + '3 months'::INTERVAL)::INTEGER                AS fiscal_week_day,\n    CASE\n      WHEN d IN (\n        '2020-01-01', '2020-07-04', '2020-12-25',\n        '2021-01-01', '2021-07-04', '2021-12-25',\n        '2022-01-01', '2022-07-04', '2022-12-25'\n      ) THEN TRUE ELSE FALSE\n    END::BOOLEAN                                                           AS fiscal_holiday_flag\n  FROM {{ DateSeries(\"2020-01-01\", 5000) }} AS t(d);\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/reports/customer_segment_report_test","id":"d7176b24-a139-11f1-b6b0-6f90300261de","folder_id":"d716a7cf-a139-11f1-b6b0-6f90300261de","name":"customer_segment_report_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the customer RFM segment report.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_CustomerSegmentReport_ValidRiskTier()\n#+meta {\n  :doc \"Fails if risk_tier contains a value outside the tiers defined by common.RfmRiskTier(),\n        indicating an RFM segment that isn't mapped to a risk tier.\"\n}\n#+begin\n  SELECT\n    *\n  FROM\n    {{ CustomerSegmentReport() }}\n  WHERE\n    risk_tier NOT IN ('At Risk', 'Healthy', 'Growth', 'Other')\n#+end\n\n#+test sql Test_CustomerSegmentReport_SharesSumToHundred()\n#+meta {\n  :doc \"Fails if pct_of_customers doesn't sum to ~100% across all segments, indicating a broken\n        common.PctShare() calculation or a change in the underlying customer population.\"\n}\n#+begin\n  SELECT\n    SUM(pct_of_customers) AS total_pct\n  FROM\n    {{ CustomerSegmentReport() }}\n  HAVING\n    SUM(pct_of_customers) NOT BETWEEN 99.5 AND 100.5\n#+end\n","platform":null}},{"fqn":"/retail/mart/fact_sale_return","id":"d71ebe51-a139-11f1-b6b0-6f90300261de","folder_id":"d71dacd9-a139-11f1-b6b0-6f90300261de","name":"fact_sale_return","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base/sales\"\n#+import \"coginiti.co/foundation/retail/base/location\"\n\n#+src sql FactSalesReturn()\n#+meta {\n  :doc \"This is a transaction / item level fact table which should consist of completely additive measures pertaining to sales and returns.\",\n  :publication {\n    :type \"table\",\n    :name \"sale_return_fact\",\n    :schema \"mart\"\n  }\n}\n#+begin\n  SELECT\n    sh.transaction_id,\n    sh.transaction_datetime,\n    sh.transaction_date_key,\n    sd.product_key AS item_key,\n    sh.location_key AS business_unit_key,\n    sh.persona_key,\n    s.site_postal_address_key AS postal_address_key,\n    s.inbound_channel_key,\n    sd.unit_quantity AS sales_quantity,\n    sd.unit_price_amount AS gross_sales_amount\n  FROM\n    {{ sales.SalesDetail() }} AS sd\n  INNER JOIN {{ sales.SalesHeader() }} AS sh\n    ON sh.sales_header_key = sd.sales_header_key\n  INNER JOIN {{ location.Store() }} AS s\n    ON s.store_key = sh.location_key\n#+end","platform":null}},{"fqn":"/retail/semantic_layer/sales/sale_return_fact.smdl","id":"d71fcfc7-a139-11f1-b6b0-6f90300261de","folder_id":"d71fa8b6-a139-11f1-b6b0-6f90300261de","name":"sale_return_fact.smdl","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"b5d59a51-8454-11f1-a626-557cda040604"},"asset_type":"SQL","content":"entity \"sale_return_fact\" {\n  label       = \"Sales Transaction Line\"\n  description = \"Core sales fact at transaction line granularity. Each row represents one item sold within a sales transaction. Additive measures (quantity and amount) can be safely summed across all dimensions.\"\n  table_name  = \"sale_return_fact\"\n  schema_name = \"mart\"\n  synonyms    = [\"sales transaction\", \"transaction line\", \"order line\", \"sales record\"]\n\n  # --- Degenerate dimensions (from the fact itself) ---\n\n  dimension \"transaction_id\" {\n    label       = \"Transaction ID\"\n    description = \"Natural key of the parent sales transaction (header level).\"\n    type        = \"text\"\n    expr        = \"transaction_id\"\n    synonyms    = [\"transaction id\", \"order id\", \"receipt number\", \"sale id\", \"order number\"]\n  }\n\n  dimension \"transaction_datetime\" {\n    label       = \"Transaction Date/Time\"\n    description = \"Full timestamp when the transaction was recorded, including time-of-day.\"\n    type        = \"datetime\"\n    expr        = \"transaction_datetime\"\n    synonyms    = [\"transaction timestamp\", \"sale datetime\", \"order timestamp\", \"purchase time\"]\n  }\n\n  # --- Foreign keys (used in relationships below) ---\n\n  dimension \"transaction_date_key\" {\n    label    = \"Transaction Date Key\"\n    type     = \"text\"\n    expr     = \"transaction_date_key\"\n    synonyms = [\"date key\", \"sale date key\", \"order date key\"]\n  }\n\n  dimension \"item_key\" {\n    label    = \"Item Key\"\n    type     = \"text\"\n    expr     = \"item_key\"\n    synonyms = [\"product key\", \"sku key\", \"item surrogate key\"]\n  }\n\n  dimension \"business_unit_key\" {\n    label    = \"Store Key\"\n    type     = \"text\"\n    expr     = \"business_unit_key\"\n    synonyms = [\"store key\", \"location key\", \"branch key\"]\n  }\n\n  dimension \"persona_key\" {\n    label    = \"Persona Key\"\n    type     = \"text\"\n    expr     = \"persona_key\"\n    synonyms = [\"customer key\", \"customer id\", \"persona id\"]\n  }\n\n  dimension \"inbound_channel_key\" {\n    label    = \"Channel Key\"\n    type     = \"text\"\n    expr     = \"inbound_channel_key\"\n    synonyms = [\"channel key\", \"channel id\", \"sales channel key\"]\n  }\n\n  # --- Measures ---\n\n  # Additive: sum is meaningful across all dimensions\n  measure \"total_quantity\" {\n    label            = \"Total Quantity\"\n    description      = \"Sum of units sold across all transaction lines in scope.\"\n    type             = \"number\"\n    aggregation_type = \"sum\"\n    expr             = \"sales_quantity\"\n    synonyms         = [\"quantity sold\", \"units sold\", \"total units\", \"sales quantity\", \"items sold\"]\n  }\n\n  measure \"total_sales_amount\" {\n    label            = \"Total Sales\"\n    description      = \"Total gross sales revenue. Additive — can be summed across any combination of dimensions.\"\n    type             = \"decimal\"\n    aggregation_type = \"sum\"\n    expr             = \"gross_sales_amount\"\n    synonyms         = [\"total revenue\", \"revenue\", \"gross sales\", \"sales amount\"]\n  }\n\n  # Non-additive: counts\n  measure \"line_count\" {\n    label            = \"Line Count\"\n    description      = \"Total number of transaction lines (rows) in scope.\"\n    type             = \"number\"\n    aggregation_type = \"count\"\n    expr             = \"transaction_id\"\n    synonyms         = [\"number of lines\", \"total lines\", \"row count\", \"line items\"]\n  }\n\n  measure \"unique_transactions\" {\n    label            = \"Unique Transactions\"\n    description      = \"Number of distinct sales transactions (header-level). Use this instead of line_count when measuring transaction volume.\"\n    type             = \"number\"\n    aggregation_type = \"count_distinct\"\n    expr             = \"transaction_id\"\n    synonyms         = [\"distinct transactions\", \"number of transactions\", \"transaction count\", \"order count\", \"total orders\"]\n  }\n\n  # Non-additive: averages and spread\n  measure \"avg_line_amount\" {\n    label            = \"Avg Line Amount\"\n    description      = \"Average gross sales amount per transaction line.\"\n    type             = \"decimal\"\n    aggregation_type = \"avg\"\n    expr             = \"gross_sales_amount\"\n    synonyms         = [\"average line value\", \"avg sale amount\", \"mean line amount\", \"average transaction line\"]\n  }\n\n  measure \"max_line_amount\" {\n    label            = \"Max Line Amount\"\n    description      = \"Highest gross sales amount on a single transaction line.\"\n    type             = \"decimal\"\n    aggregation_type = \"max\"\n    expr             = \"gross_sales_amount\"\n    synonyms         = [\"highest line amount\", \"maximum sale amount\", \"largest transaction line\", \"top line value\"]\n  }\n\n  measure \"min_line_amount\" {\n    label            = \"Min Line Amount\"\n    description      = \"Lowest gross sales amount on a single transaction line.\"\n    type             = \"decimal\"\n    aggregation_type = \"min\"\n    expr             = \"gross_sales_amount\"\n    synonyms         = [\"lowest line amount\", \"minimum sale amount\", \"smallest transaction line\", \"bottom line value\"]\n  }\n\n  # Custom aggregation notes:\n  # - expr must be a single aggregate function call with exactly 1 argument\n  # - Use it for non-standard aggregate functions not covered by the built-in types\n  # - Arithmetic combining multiple aggregates (e.g. SUM(...) / COUNT(...)) is NOT supported\n  # - Computed KPIs of that form should be expressed as derived columns in a CSL query instead\n\n  # --- Relationships: many sales lines → one dimension record ---\n\n  relationship \"sales_to_date\" {\n    label = \"Transaction Date\"\n    type  = \"many_to_one\"\n    expr  = \"sale_return_fact.transaction_date_key = date_dimension.date_key\"\n  }\n\n  relationship \"sales_to_item\" {\n    label = \"Product\"\n    type  = \"many_to_one\"\n    expr  = \"sale_return_fact.item_key = item_dimension.item_key\"\n  }\n\n  relationship \"sales_to_store\" {\n    label = \"Store\"\n    type  = \"many_to_one\"\n    expr  = \"sale_return_fact.business_unit_key = business_unit_dimension.business_unit_key\"\n  }\n\n  relationship \"sales_to_customer\" {\n    label = \"Customer\"\n    type  = \"many_to_one\"\n    expr  = \"sale_return_fact.persona_key = persona_dimension.persona_key\"\n  }\n\n  relationship \"sales_to_channel\" {\n    label = \"Inbound Channel\"\n    type  = \"many_to_one\"\n    expr  = \"sale_return_fact.inbound_channel_key = inbound_channel_dimension.inbound_channel_key\"\n  }\n\n  # Inner-join style relationship: only rows where both sides are non-null are returned.\n  # Achieved by adding IS NOT NULL to the join condition, which forces the engine\n  # to use INNER JOIN semantics instead of the default LEFT JOIN.\n  relationship \"sales_to_active_store\" {\n    label = \"Active Store (inner join)\"\n    type  = \"many_to_one\"\n    expr  = \"sale_return_fact.business_unit_key = business_unit_dimension.business_unit_key AND business_unit_dimension.closing_date IS NULL\"\n  }\n}\n","platform":null}},{"fqn":"/retail/landing/country_phone_codes","id":"d70f2e8e-a139-11f1-b6b0-6f90300261de","folder_id":"d70e1d18-a139-11f1-b6b0-6f90300261de","name":"country_phone_codes","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n\n-- Maps country ISO 2-codes to their international dialling prefixes and\n-- typical phone number lengths.  Used by MobilePhoneNumbers() in customers\n-- and stores to generate realistic phone numbers.\n\n#+src sql CountryPhoneCodes()\n#+meta {\n  :doc \"Returns a mapping between country iso 2 code and mobile phone code.\",\n  :publication {\n    :type \"table\",\n    :name \"country_phone_codes\",\n    :schema \"landing\"\n  }\n}\n#+begin\n  SELECT\n    ROW_NUMBER() OVER (ORDER BY country_name) AS sequence_number,\n    country_codes.*\n  FROM (\n    SELECT 'Singapore'       AS country_name, 'SG' AS iso_2_code, '+65'  AS phone_number_code,  8  AS phone_number_length\n    UNION ALL\n    SELECT 'Malaysia',                        'MY',               '+60',                        9\n    UNION ALL\n    SELECT 'United States',                   'US',               '+1',                         10\n    UNION ALL\n    SELECT 'Ireland',                         'IE',               '+353',                       10\n    UNION ALL\n    SELECT 'United Kingdom',                  'GB',               '+44',                        10\n    UNION ALL\n    SELECT 'Netherlands',                     'NL',               '+31',                        10\n    UNION ALL\n    SELECT 'Germany',                         'DE',               '+49',                        11\n  ) AS country_codes\n#+end\n","platform":null}},{"fqn":"/retail/landing/inbound_channel","id":"d70eb95b-a139-11f1-b6b0-6f90300261de","folder_id":"d70e1d18-a139-11f1-b6b0-6f90300261de","name":"inbound_channel","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n\n-- Static channel reference data: four interaction channels used across\n-- all sales transactions and store assignments.\n\n#+src sql InboundChannel()\n#+meta {\n  :publication {\n    :type \"table\",\n    :name \"inbound_channels\",\n    :schema \"landing\"\n  }\n}\n#+begin\n  SELECT\n    channel_name,\n    channel_code\n  FROM (\n    SELECT 'Store'             AS channel_name, 'STR' AS channel_code\n    UNION ALL\n    SELECT 'Website',                           'WEB'\n    UNION ALL\n    SELECT 'Mobile App',                        'APP'\n    UNION ALL\n    SELECT 'Phone/Call Center',                 'PCC'\n  ) AS channels;\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_regular/store_rankings","id":"d71a0342-a139-11f1-b6b0-6f90300261de","folder_id":"8f049129-a151-11f1-b6b0-6f90300261de","name":"store_rankings","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"f7c4f81f-845a-11f1-a626-557cda040604"},"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/mart\"\n\n-- Store Performance Rankings\n-- Goal: Rank all stores within a user-defined date window by a chosen performance metric\n--       (sales amount, transaction count, or customer count) and surface the top N results.\n--       The output is written to rpt_store_rankings_current and is intentionally overwritten\n--       on each run — the table always holds the most recently requested ranking snapshot\n--       rather than accumulating historical ranking rows.\n--\n-- Parameters:\n--   $start_date      – Start of the evaluation period (inclusive), e.g. '2023-01-01'.\n--   $end_date        – End of the evaluation period (inclusive), e.g. '2023-12-31'.\n--   $ranking_metric  – The KPI used to order stores:\n--                        'sales_amount'      → ranked by total gross sales (default)\n--                        'transaction_count' → ranked by number of distinct transactions\n--                        'customer_count'    → ranked by number of distinct customers\n--   $top_n           – How many top-ranked stores to include in the output.\n--                      All stores are ranked first; the HAVING-equivalent WHERE on store_rank\n--                      then trims the result to the requested N.\n--\n-- Logic overview:\n--   Step 1 (store_metrics CTE) – Aggregate raw fact data at store level within the\n--                                 requested date window. Joins FactSalesReturn to\n--                                 BusinessUnitDimension (store attributes) and\n--                                 DateDimension (date filter).\n--   Step 2 (ranked_stores CTE) – Apply RANK() OVER ORDER BY using the chosen metric via\n--                                 CASE '$ranking_metric'. Audit columns (period_start,\n--                                 period_end, ranking_metric, ranking_generated_at) are\n--                                 added here so every output row is self-describing.\n--   Final SELECT               – Filter to store_rank <= $top_n and sort ascending.\n--\n-- Output grain: one row per store within the top-N cutoff.\n-- Typical consumers: regional operations reviews, store performance dashboards,\n--                    incentive and bonus calculation pipelines.\n\n#+src sql StoreRankings()\n#+meta {\n  :doc \"Store performance rankings - parameterized by metric and time period.\n        This table is intentionally overwritten by design.\n        $Parameters:\n          - $start_date: The date for the start period (e.g., '2023-01-01')\n          - $end_date: The date for the end period (e.g., '2023-01-31')\n          - $ranking_metric: Metric to rank by (sales_amount, transaction_count, customer_count)\n          - $top_n: Number of stores to include\",\n  :publication {\n    :type \"table\",\n    :name \"rpt_store_rankings_current\",\n    :schema \"reports\"\n  }\n}\n#+begin\n  WITH store_metrics AS (\n    -- Step 1: Aggregate all three candidate metrics at store level for the requested window.\n    -- All metrics are computed regardless of $ranking_metric so the output always includes\n    -- the full picture — callers can display whichever columns are relevant.\n    SELECT\n      bu.business_unit_id   AS store_id,\n      bu.business_unit_name AS store_name,\n      bu.market_region_name,\n      bu.market_area_name,\n      COUNT(DISTINCT f.transaction_id) AS transaction_count,\n      COUNT(DISTINCT f.persona_key)    AS customer_count,\n      SUM(f.gross_sales_amount)        AS sales_amount\n    FROM\n      {{ mart.FactSalesReturn() }} f\n    INNER JOIN {{ mart.BusinessUnitDimension() }} bu\n      ON bu.business_unit_key = f.business_unit_key\n    INNER JOIN {{ mart.DateDimension() }} d\n      ON d.date_key = f.transaction_date_key\n    WHERE\n      -- Restrict to the user-supplied evaluation window (both bounds inclusive)\n      d.business_day_date BETWEEN '$start_date'::DATE AND '$end_date'::DATE\n    GROUP BY\n      bu.business_unit_id,\n      bu.business_unit_name,\n      bu.market_region_name,\n      bu.market_area_name\n  ),\n\n  ranked_stores AS (\n    -- Step 2: Apply the chosen ranking metric via CASE expression.\n    -- RANK() is used (rather than ROW_NUMBER) so tied stores receive the same rank;\n    -- gaps in rank sequence signal ties to downstream consumers.\n    SELECT\n      '$start_date'::DATE      AS period_start,        -- audit: window start stored in output\n      '$end_date'::DATE        AS period_end,           -- audit: window end stored in output\n      '$ranking_metric'        AS ranking_metric,       -- audit: which metric was used to rank\n      CURRENT_TIMESTAMP        AS ranking_generated_at, -- audit: when this run was produced\n      store_id,\n      store_name,\n      market_region_name,\n      market_area_name,\n      transaction_count,\n      customer_count,\n      sales_amount,\n      CASE '$ranking_metric'\n        WHEN 'transaction_count' THEN RANK() OVER (ORDER BY transaction_count DESC)\n        WHEN 'customer_count'    THEN RANK() OVER (ORDER BY customer_count DESC)\n        ELSE                          RANK() OVER (ORDER BY sales_amount DESC)  -- default: sales_amount\n      END AS store_rank\n    FROM\n      store_metrics\n  )\n\n  SELECT\n    *\n  FROM\n    ranked_stores\n  WHERE\n    -- Trim to the requested top-N; ties at the boundary are all included\n    store_rank <= $top_n\n  ORDER BY\n    store_rank\n  ;\n#+end","platform":null}},{"fqn":"/retail/sources/products_test","id":"d71bd80c-a139-11f1-b6b0-6f90300261de","folder_id":"d71b89ea-a139-11f1-b6b0-6f90300261de","name":"products_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the products source.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_Products_UniqueID()\n#+meta {\n  :doc \"Fails if any product_id appears more than once, indicating a duplicate record in the products source.\"\n}\n#+begin\n  SELECT\n    product_id,\n    COUNT(*) AS cnt\n  FROM\n    {{ Products() }}\n  GROUP BY\n    product_id\n  HAVING\n    COUNT(*) > 1\n#+end\n","platform":null}},{"fqn":"/retail/base/customer","id":"d7104005-a139-11f1-b6b0-6f90300261de","folder_id":"d71018f4-a139-11f1-b6b0-6f90300261de","name":"customer","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/.actions/retail_action_ai.toml","id":"d721cba3-a139-11f1-b6b0-6f90300261de","folder_id":"d7217d81-a139-11f1-b6b0-6f90300261de","name":"retail_action_ai.toml","entity_type":"project_action","entity_version":"cepXb+WJs7iTh1SvXWjbBrONx7GpzRgsC+7LeNmHgFE=","data":{"copied_from_id":null,"asset_type":"PROJECT_ACTION","error":null,"content":"# This file defines a workflow with jobs and their execution steps.\n# Each job can have dependencies and contains a series of steps to execute.\n\n# GENERAL ACTION INFORMATION\n[general]\nname = \"retail_workflow_ai\"\ndescription = \"AI-enhanced workflow for the coginiti-retail-tutorial project. Uses LLM blocks to generate realistic customer names, addresses, products, and reviews instead of procedurally generated data. Requires an AI Assistant connection. Source: https://github.com/coginiti-dev/coginiti-retail-tutorial\"\n\n\n# ENVIRONMENT CONFIGURATION\n[environment]\nid = \"prod\"\n\n\n##################################################################################################################################################################\n\n# SCHEDULE CONFIGURATION\n[schedule]\ncron = \"0 00 14 * * ?\"  # Daily at 2:00 PM (sec min hour day month dayOfWeek)\nmisfire_policy = \"RUN_IMMEDIATELY\"  # Run immediately if schedule is missed\ntimezone = \"Europe/Helsinki\"  # Explicit timezone for consistency, IANA with DST rules applied\n\n\n# TRIGGER CONFIGURATION\n# Run this action automatically in response to project events (in addition to the schedule above)\n[trigger]\ntypes = [\"review_created\", \"project_hub_published\"]  # Options: review_created, project_hub_published\n\n\n# JOBS CONFIGURATION\n[job.landing]\nsteps = [\"landing_ai\"]\nlanding_ai = { command = \"run_asset\", asset = \".actions/run_scripts/landing_ai\" }\n\n\n[job.base]\ndepends_on = [\"landing\"]\nsteps = [\"base\"]\nbase = { command = \"run_asset\", asset = \".actions/run_scripts/base\" }\n\n\n[job.mart]\ndepends_on = [\"base\"]\nsteps = [\"mart\"]\nmart = { command = \"run_asset\", asset = \".actions/run_scripts/mart\" }\n\n\n\n[job.reports]\ndepends_on = [\"mart\"]\nsteps = [\"report_daily_snapshot\", \"report_store_rankings\", \"report_customer_export\"]\nreport_daily_snapshot = { command = \"run_asset\", asset = \".actions/run_scripts/report_daily_snapshot\", parameters = { \"$snapshot_date\" = \"2023-10-01\", \"$lookback_days\" = \"30\", \"$snapshot_type\" = \"monthly\" } }\nreport_store_rankings = { command = \"run_asset\", asset = \".actions/run_scripts/report_store_rankings\", parameters = { \"$start_date\" = \"2022-01-01\", \"$end_date\" = \"2022-12-31\", \"$ranking_metric\" = \"sales_amount\", \"$top_n\" = \"50\" } }\nreport_customer_export = { command = \"run_asset\", asset = \".actions/run_scripts/report_customer_export\", parameters = { \"$export_type\" = \"high_value\", \"$min_orders\" = \"10\", \"$min_sales\" = \"5000\", \"$include_contact_info\" = \"true\" } }\n\n\n[job.reports_ai]\ndepends_on = [\"mart\"]\nsteps = [\"report_product_review_insights\", \"report_store_performance_narratives\"]\nreport_product_review_insights = { command = \"run_asset\", asset = \".actions/run_scripts/report_product_review_insights\" }\nreport_store_performance_narratives = { command = \"run_asset\", asset = \".actions/run_scripts/report_store_performance_narratives\" }\n\n\n##################################################################################################################################################################\n\n\n\n# ENVIRONMENT CONFIGURATION (optional)\n# Define which project environment to use for connection setup\n# The environment ID references an environment defined in your project.toml file\n# [environment]\n# id = \"dev\"  # Environment ID from project.toml (e.g., dev, staging, prod)\n\n# SCHEDULE CONFIGURATION (optional)\n# Define when this action should be automatically executed\n# If schedule section is present, cron and misfire_policy are mandatory, timezone is optional\n# [schedule]\n# cron = \"0 0 12 * * ?\"  # Daily at noon (sec min hour day month dayOfWeek)\n# misfire_policy = \"RUN_IMMEDIATELY\"  # Options: SKIP, RUN_IMMEDIATELY\n# timezone = \"GMT+4\"  # Optional: IANA timezone identifier (defaults to user timezone)\n#\n# Common timezone examples:\n#   Americas: America/New_York, America/Chicago, America/Denver, America/Los_Angeles\n#   Europe: Europe/London, Europe/Paris, Europe/Berlin, Europe/Rome\n#   Asia: Asia/Tokyo, Asia/Shanghai, Asia/Kolkata, Asia/Dubai\n#   Australia: Australia/Sydney, Australia/Melbourne\n#   UTC: UTC (Coordinated Universal Time)\n\n#   GMT/UTC offset formats:\n#   GMT+1, GMT+3, GMT-3, GMT-8, GMT-11\n#   UTC+1, UTC+3, UTC-3, UTC-8, UTC-11\n#   +01:00, +03:00, +05:30, +09:30, -03:00, -08:00\n#\n# For the complete list of valid timezone identifiers, see:\n# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones\n\n# JOBS CONFIGURATION\n# Define your jobs below using the following pattern:\n# [job.<job_name>]\n\n# ------------------------------------------\n# Example Job Configuration\n# ------------------------------------------\n# Uncomment and modify the section below to create your first job\n\n# [job.example_job_1]\n#\n# # Job Dependencies (optional)\n# # List all jobs that must complete before this job starts\n# depends_on = [\"example_job\"]\n#\n# # Execution Steps (required)\n# # Steps will be executed in the order specified in this list\n# steps = [\"step1\", \"step2\"]\n#\n# # Step Definitions (required)\n# # Currently supported commands:\n# #   - run_asset: Execute an asset located at the specified path\n# #\n# # Parameters (optional):\n# #   - parameters: Key-value pairs passed to the asset during execution\n# #     If parameters are defined here, they override any external parameters from scheduled events\n# step1 = { command = \"run_asset\", asset = \"/path/to/asset1\" }\n#\n# step2 = { command = \"run_asset\", asset = \"/path/to/asset2\", parameters = { \"$param\" = \"value\", \"$param2\" = \"value2\" } }\n\n# ==========================================\n# ADDITIONAL JOBS\n# ==========================================\n# Add more jobs here following the same pattern:\n\n# [job.your_job_name]\n# steps = [\"init\", \"process\", \"cleanup\"]\n#\n# init = { command = \"run_asset\", asset   = \"/initialize\" }\n#\n# process = { command = \"run_asset\", asset = \"/main_process\", parameters = { \"environment\" = \"production\" } }\n#\n# cleanup = { command = \"run_asset\", asset = \"/cleanup\" }\n"}},{"fqn":"/retail/sources/customers","id":"d71c9b62-a139-11f1-b6b0-6f90300261de","folder_id":"d71b89ea-a139-11f1-b6b0-6f90300261de","name":"customers","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+src sql Customers()\n#+begin\n  SELECT\n    id AS customer_id,\n    first_name,\n    last_name,\n    email,\n    address_line_1,\n    address_line_2,\n    city,\n    postal_code,\n    phone_number,\n    SPLIT_PART(email, '@', 2) AS email_domain,\n    {{ NaturalKey(\"PER^\", [\"id\"]) }} AS persona_nk,\n    {{ NaturalKey(\"EML^\", [\"email\"]) }} AS email_address_nk,\n    {{ NaturalKey(\"EML_DMN^\", [\"SPLIT_PART(email, '@', 2)\"]) }} AS email_domain_nk,\n    {{ NaturalKey(\"PADDR^\", [\"address_line_1\", \"address_line_2\", \"city\", \"postal_code\"]) }} AS postal_address_nk,\n    {{ NaturalKey(\"PCODE^\", [\"postal_code\"]) }} AS postal_code_nk,\n    {{ NaturalKey(\"PHONE^\", [\"phone_number\"]) }} AS phone_number_nk,\n    c.iso_2_code AS country_nk,\n    {{ RowHash([\n      \"id\",\n      \"first_name\",\n      \"last_name\",\n      \"email\",\n      \"address_line_1\",\n      \"address_line_2\",\n      \"city\",\n      \"postal_code\",\n      \"phone_number\"\n    ]) }} AS row_hash\n  FROM\n    landing.customers\n  LEFT JOIN {{ CountryPhoneCodes() }} c\n    ON LEFT(phone_number, LENGTH(c.phone_number_code)) = c.phone_number_code\n#+end\n\n\n","platform":null}},{"fqn":"/retail/base/touchpoint/country","id":"d7128904-a139-11f1-b6b0-6f90300261de","folder_id":"d71261f3-a139-11f1-b6b0-6f90300261de","name":"country","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/sources\"\n#+import \"coginiti.co/foundation/retail/base\"\n\n#+src sql Country()\n#+meta {\n  :doc \"A dimensional type representing the geographic country.\",\n  :publication {\n    :type \"table\",\n    :name \"dim_country\",\n    :schema \"base\"\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"_t.iso_2_code\") }} AS country_key,\n    name AS country_name,\n    iso_2_code AS country_code_2char,\n    iso_3_code AS country_code_3char,\n    country_num_code AS country_code_number,\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM\n    {{ sources.Countries() }} AS _t\n  CROSS JOIN {{ base.Batch() }} b\n#+end\n","platform":null}},{"fqn":"/retail/sources/stores_test","id":"d71c4d40-a139-11f1-b6b0-6f90300261de","folder_id":"d71b89ea-a139-11f1-b6b0-6f90300261de","name":"stores_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the stores source.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_Stores_UniqueID()\n#+meta {\n  :doc \"Fails if any store_id appears more than once, indicating a duplicate record in the stores source.\"\n}\n#+begin\n  SELECT\n    store_id,\n    COUNT(*) AS cnt\n  FROM\n    {{ Stores() }}\n  GROUP BY\n    store_id\n  HAVING\n    COUNT(*) > 1\n#+end\n\n#+test sql Test_Stores_UniqueStoreName()\n#+meta {\n  :doc \"Fails if any store_name appears more than once, indicating the landing layer produced duplicate store names.\"\n}\n#+begin\n  SELECT\n    store_name,\n    COUNT(*) AS cnt\n  FROM\n    {{ Stores() }}\n  GROUP BY\n    store_name\n  HAVING\n    COUNT(*) > 1\n#+end\n","platform":null}},{"fqn":"/retail/base/sales/sales_header","id":"d7110359-a139-11f1-b6b0-6f90300261de","folder_id":"d7108e27-a139-11f1-b6b0-6f90300261de","name":"sales_header","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/sources\"\n#+import \"coginiti.co/foundation/retail/base\"\n#+import \"coginiti.co/foundation/retail/base/customer\"\n#+import \"coginiti.co/foundation/retail/base/location\"\n#+import \"coginiti.co/foundation/retail/base/datetime\"\n\n#+src sql SalesHeader()\n#+meta {\n  :doc `Header level information for a sales transaction (a.k.a. order). The presence of \"INBOUND CHANNEL KEY\" implies that\n        this is a multi-channel table, storing sales transactions from all sales channels.`,\n  :publication {\n    :type \"table\",\n    :name \"fact_sales_header\",\n    :schema \"base\"\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS sales_header_key,\n    transaction_id,\n    transaction_datetime,\n    {{ base.SurrogateKey(\"_t.date_nk\") }} AS transaction_date_key,\n    {{ base.SurrogateKey(\"_t.store_nk\") }} AS location_key,\n    {{ base.SurrogateKey(\"_t.persona_nk\") }} AS persona_key,\n    b.batch_number\n  FROM (\n    SELECT\n      sales_header_nk AS natural_key,\n      transaction_id,\n      transaction_datetime,\n      date_nk,\n      store_nk,\n      persona_nk,\n      ROW_NUMBER() OVER (PARTITION BY transaction_id ORDER BY transaction_datetime DESC) AS row_num\n    FROM\n      {{ sources.Sales() }} src\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/base/touchpoint/postal_address","id":"d712fe37-a139-11f1-b6b0-6f90300261de","folder_id":"d71261f3-a139-11f1-b6b0-6f90300261de","name":"postal_address","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base\"\n#+import \"coginiti.co/foundation/retail/sources\"\n\n-- TODO: Add country_key\n#+src sql PostalAddress()\n#+meta {\n  :doc \"A dimensional type representing a postal address. This may be the raw, normalized, or standardized address.\",\n  :publication {\n    :type \"table\",\n    :name \"dim_postal_address\",\n    :schema \"base\"\n  }\n}\n#+begin\n  WITH source_rows AS (\n    SELECT\n      postal_address_nk AS natural_key,\n      address_line_1,\n      address_line_2,\n      city,\n      postal_code_nk,\n      row_hash\n    FROM\n      {{ sources.Customers() }}\n\n    UNION ALL\n\n    SELECT\n      postal_address_nk AS natural_key,\n      address_line_1,\n      address_line_2,\n      city,\n      postal_code_nk,\n      row_hash\n    FROM\n      {{ sources.Stores() }}\n  )\n\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS postal_address_key,\n    _t.address_line_1,\n    _t.address_line_2,\n    {{ base.SurrogateKey(\"_t.postal_code_nk\") }} AS postal_code_key,\n    _t.city AS city_name,\n    -- country_key\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      *,\n      ROW_NUMBER() OVER (PARTITION BY natural_key ORDER BY natural_key DESC, row_hash) AS row_num\n    FROM\n      source_rows  \n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/landing","id":"d70e1d18-a139-11f1-b6b0-6f90300261de","folder_id":"d70b5df0-a139-11f1-b6b0-6f90300261de","name":"landing","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/reports/reports_regular/customer_export","id":"d719b520-a139-11f1-b6b0-6f90300261de","folder_id":"8f049129-a151-11f1-b6b0-6f90300261de","name":"customer_export","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"cda4f8e8-845a-11f1-a626-557cda040604"},"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/mart\"\n\n-- Customer Data Export\n-- Goal: Extract a targeted list of customers for use in CRM systems, email marketing\n--       campaigns, and re-engagement programmes. The export is parameterized so the\n--       same script serves multiple use cases (full list, high-value, at-risk, recent)\n--       without duplicating logic.\n--\n-- The output is written to rpt_customer_export_staging and is intentionally overwritten\n-- on each run — the staging table always holds the most recently requested export cohort.\n--\n-- Parameters:\n--   $export_type          – Cohort filter applied on top of the base eligibility criteria:\n--                             'all'        → no additional filter (everyone who passes min thresholds)\n--                             'high_value' → customers with lifetime sales >= $5,000\n--                             'at_risk'    → RFM segments 'Cannot lose' or 'Potential churners'\n--                             'recent'     → customers who purchased within the last 90 days\n--   $min_orders           – Minimum lifetime order count; excludes one-time or very low-frequency buyers.\n--   $min_sales            – Minimum lifetime sales amount; excludes very low-value accounts.\n--   $include_contact_info – When true, email address and phone number are included in the output.\n--                           Set to false for anonymised or GDPR-constrained exports.\n--\n-- Output grain: one row per customer (customer_id is the natural key).\n-- Typical consumers: CRM platforms, email service providers, customer success teams.\n\n#+src sql CustomerExport()\n#+meta {\n  :doc \"Customer data export - parameterized for different segments and filters.\n        Used for CRM exports, email campaigns, etc.\n        This table is intentionally overwritten by design.\n        $Parameters:\n          - $export_type: Type of export (all, high_value, at_risk, recent),\n          - $min_orders: Minimum order count filter (integer),\n          - $min_sales: Minimum sales amount filter (integer),\n          - $include_contact_info: Boolean to include email/phone (true / false).\",\n  :publication {\n    :type \"table\",\n    :name \"rpt_customer_export_staging\",\n    :schema \"reports\"\n  }\n}\n#+begin\n  WITH customer_data AS (\n    -- Join persona profile to RFM derived attributes.\n    -- Base eligibility is enforced here so all subsequent filters operate on a\n    -- pre-qualified cohort, keeping the final WHERE clause readable.\n    SELECT\n      p.customer_id,\n      p.first_name,\n      p.last_name,\n      #+if $include_contact_info then\n        -- Contact fields are conditionally included; omit when $include_contact_info = false\n        p.primary_email_address,\n        p.primary_complete_phone_number,\n      #+end\n      da.rfm_segment,\n      da.total_orders,\n      da.total_sales,\n      da.recent_order,\n      CURRENT_DATE - da.recent_order::DATE AS days_since_last_order\n    FROM\n      {{ mart.PersonaDimension() }} p\n    INNER JOIN {{ mart.PersonaDerivedAttributes() }} da\n      ON da.persona_key = p.persona_key\n    WHERE\n      -- Apply minimum thresholds to exclude negligible accounts\n      da.total_orders >= $min_orders\n      AND da.total_sales >= $min_sales\n  )\n\n  SELECT\n    '$export_type' AS export_type,          -- tag each row with the requested cohort label\n    CURRENT_TIMESTAMP AS export_generated_at,\n    cd.*\n  FROM\n    customer_data cd\n  WHERE\n    -- Apply the cohort-specific filter selected by $export_type\n    CASE '$export_type'\n      WHEN 'high_value' THEN cd.total_sales >= 5000\n      WHEN 'at_risk'    THEN cd.rfm_segment IN ('Cannot lose', 'Potential churners')\n      WHEN 'recent'     THEN cd.days_since_last_order <= 90\n      ELSE TRUE   -- 'all': no additional restriction beyond base eligibility\n    END\n  ORDER BY\n    cd.total_sales DESC\n  ;\n#+end\n","platform":null}},{"fqn":"/retail/base/sales/sales_detail","id":"d710b538-a139-11f1-b6b0-6f90300261de","folder_id":"d7108e27-a139-11f1-b6b0-6f90300261de","name":"sales_detail","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/sources\"\n#+import \"coginiti.co/foundation/retail/base\"\n#+import \"coginiti.co/foundation/retail/base/offering\"\n\n-- TODO: Add sales_type column for sale returns.\n#+src sql SalesDetail()\n#+meta {\n  :doc `Detail level records for a sales transaction. The \"SALES TYPE\" reference tells us whether the line represents a sale or return.`,\n  :publication {\n    :type \"table\",\n    :name \"fact_sales_detail\",\n    :schema \"base\"\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS sales_detail_key,\n    {{ base.SurrogateKey(\"_t.sales_header_nk\") }} AS sales_header_key,\n    sales_line_number,\n    {{ base.SurrogateKey(\"_t.product_nk\") }} AS product_key,\n    unit_quantity,\n    unit_price_amount,\n    b.batch_number\n  FROM (\n    SELECT\n      sales_detail_nk AS natural_key,\n      sales_header_nk,\n      src.line_number AS sales_line_number,\n      src.transaction_datetime,\n      product_nk,\n      src.quantity AS unit_quantity,\n      src.price AS unit_price_amount\n    FROM\n      {{ sources.Sales() }} src\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_sql_reporting/product_performance","id":"d714fa14-a139-11f1-b6b0-6f90300261de","folder_id":"d714d303-a139-11f1-b6b0-6f90300261de","name":"product_performance","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"e36486b2-3cb1-11f1-a457-d9456ae162d8"},"asset_type":"SQL","content":"-- Product Performance\n-- Demonstrates: explicit JOIN, HAVING with MEASURE(), window functions (ROW_NUMBER, RANK,\n--               DENSE_RANK, NTILE), ORDER BY measure, CASE WHEN, string functions\n--\n-- Returns all products with their annual sales performance ranked by revenue.\n-- Only products that generated at least 100 units are included (HAVING filter).\n\nSELECT\n  item_name,\n  MEASURE(total_quantity)       AS units_sold,\n  MEASURE(total_sales_amount)   AS gross_sales,\n  MEASURE(unique_transactions)  AS transactions,\n  MEASURE(avg_line_amount)      AS avg_line_value,\n\n  -- Ranking functions (non-additive — evaluated after GROUP BY)\n  ROW_NUMBER() OVER (ORDER BY MEASURE(total_sales_amount) DESC) AS sales_rank,\n  RANK()       OVER (ORDER BY MEASURE(total_sales_amount) DESC) AS sales_rank_with_gaps,\n  DENSE_RANK() OVER (ORDER BY MEASURE(total_sales_amount) DESC) AS sales_dense_rank,\n  NTILE(4)     OVER (ORDER BY MEASURE(total_sales_amount) DESC) AS sales_quartile,\n\n  -- Segment label derived from performance quartile\n  CASE NTILE(4) OVER (ORDER BY MEASURE(total_sales_amount) DESC)\n      WHEN 1 THEN 'Top 25%'\n      WHEN 2 THEN 'Upper Mid'\n      WHEN 3 THEN 'Lower Mid'\n      WHEN 4 THEN 'Bottom 25%'\n  END AS performance_tier,\n\n  -- String formatting\n  UPPER(item_name)              AS item_name_upper,\n  LENGTH(item_name)             AS name_length\n\nFROM \n  sale_return_fact AS sf\nJOIN \n  item_dimension AS id\nJOIN \n  date_dimension AS dd\nWHERE\n  dd.calendar_year = 2023\nGROUP BY\n  item_name\nHAVING\n  MEASURE(total_quantity) >= 100\nORDER BY\n  gross_sales DESC\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/customer/customer_segments","id":"d7187c9b-a139-11f1-b6b0-6f90300261de","folder_id":"d718558a-a139-11f1-b6b0-6f90300261de","name":"customer_segments","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"e6967d97-8448-11f1-a626-557cda040604"},"asset_type":"CSL","content":"-- Customer segment metrics over the semantic layer\n-- Demonstrates: aggregating the persona_derived_attributes entity (pre-computed RFM segments).\n-- See semantic_csl_reporting/sales/sales_metrics for the read-only / CTE-only constraints\n-- that apply to every block in this reporting layer.\n\n#+src sql SegmentStats()\n#+meta {\n  :doc \"Per-RFM-segment customer counts and lifetime sales statistics.\"\n}\n#+begin\n  SELECT\n    rfm_segment,\n    MEASURE(pda.customer_count)      AS customer_count,\n    MEASURE(pda.sum_lifetime_sales)  AS segment_total_sales,\n    MEASURE(pda.avg_lifetime_sales)  AS avg_lifetime_sales,\n    MEASURE(pda.max_lifetime_sales)  AS max_lifetime_sales,\n    MEASURE(pda.min_lifetime_sales)  AS min_lifetime_sales,\n    MEASURE(pda.avg_order_frequency) AS avg_orders\n  FROM\n    persona_derived_attributes AS pda\n  GROUP BY\n    rfm_segment\n#+end\n","platform":null}},{"fqn":"/retail/sources","id":"d71b89ea-a139-11f1-b6b0-6f90300261de","folder_id":"d70b5df0-a139-11f1-b6b0-6f90300261de","name":"sources","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/_instructions","id":"3513c200-a21b-11f1-b6b0-6f90300261de","folder_id":"d70b5df0-a139-11f1-b6b0-6f90300261de","name":"_instructions","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base\"\n\n--\n-- Instructions\n--\n\n-- Create a database where retail data will be stored, example: \"retail_csl\"\nCREATE DATABASE retail_csl;\n\n-- Create schemas for landing, stage, base and mart data.\n-- This schemas are explicitly referenced in the CoginitiScript queries. If you decide to change its name, you have to\n-- update scripts which were referencing renamed schemas in the :publication configurations.\nCREATE SCHEMA landing;\nCREATE SCHEMA stage;\nCREATE SCHEMA base;\nCREATE SCHEMA mart;\nCREATE SCHEMA reports;\nCREATE SCHEMA reports_ai;\n\n--\n-- Init base\n-- This will create a sequences for surrogate keys / batches and log table for tracking batches.\n--\n{{ base.Init() }};\n\n--\n-- Standard flow: open \"run_full_refresh\" and run it.\n-- It will execute the complete pipeline:\n-- - populate source tables in the \"landing\" schema (procedurally generated data)\n-- - run source data quality tests\n-- - load the \"base\" layer (full refresh)\n-- - run base consistency tests\n-- - publish the \"mart\" layer\n--\n\n--\n-- AI-enhanced flow: open \"run_full_refresh_ai\" instead.\n-- Requires an AI Assistant connection. Replaces procedurally generated landing data\n-- with LLM-generated realistic names, addresses, products, and reviews:\n-- - landing.stores    — 100 stores with real city/neighborhood names (e.g. \"Chicago Magnificent Mile\")\n-- - landing.customers — realistic customer names and email addresses\n-- - landing.products  — realistic product names and descriptions\n-- - landing.product_reviews — AI-generated customer reviews with sentiment scores\n-- All downstream layers (base, mart) run unchanged on top of AI-generated landing data.\n--\n\n--\n-- AI analytical reports: after running the mart, open and run individual report scripts\n-- from the reports/reports_ai folder, or use \"retail_action_ai\" to schedule the full flow.\n-- Reports use LLM blocks to enrich mart aggregates with natural-language insights:\n-- - reports_ai.product_review_insights      — sentiment labels and marketing recommendations per product\n-- - reports_ai.store_performance_narratives — performance tier, narrative insight, and recommended action per store\n--\n\n--\n-- Use \"retail_action\" to schedule the standard flow with parameterized reports.\n-- Use \"retail_action_ai\" to schedule the AI-enhanced flow including AI analytical reports.\n--\n\n--\n-- Semantic layer: the \"semantic_layer\" folder contains SMDL entity definitions that expose\n-- the mart tables as a governed, queryable data model.\n-- Entities (star schema):\n-- - sale_return_fact           — core sales fact at transaction line granularity\n-- - date_dimension             — calendar and fiscal date attributes (+3 month fiscal offset)\n-- - business_unit_dimension    — store locations with full market hierarchy (Region → Area → District → Group)\n-- - item_dimension             — product catalogue\n-- - persona_dimension          — customer profiles (Type-2 SCD, current record exposed)\n-- - persona_derived_attributes — RFM segment scores and behavioral attributes per customer\n-- - inbound_channel_dimension  — sales channels (Store, Website, Mobile App, Phone/Call Center)\n--\n-- Example analytical queries are in the \"reports/reports_semantic/semantic_sql_reporting\" folder:\n-- - sales_overview         — monthly sales totals and KPIs for the most recent calendar year\n-- - sales_trends           — monthly time series with running totals and 3-month moving average\n-- - product_performance    — all products ranked by annual revenue with window functions\n-- - store_rankings         — stores ranked within market region by gross sales\n-- - customer_rfm_analysis  — RFM segment distribution with per-segment averages\n-- - channel_analysis       — channel mix with percent rank and cumulative distribution\n--\n\n--\n-- CSL on the semantic layer: \"reports/reports_semantic/semantic_csl_reporting\" is an analytics\n-- layer built with CoginitiScript instead of plain SQL, using the semantic layer (not the\n-- physical mart schema) as its base. Run these scripts against the \"semantic_layer_csl\"\n-- environment defined in project.toml. Two limitations of running CSL against the semantic\n-- layer shape everything in this folder:\n-- - No :publication — the semantic layer connection is read-only (SELECT only, no DDL/DML),\n--   so no block here can be materialized as a table or view. Every block only exists to be\n--   referenced by other CSL blocks or run directly.\n-- - CTE-only block chaining — the semantic layer has no temporary/permanent tables, so\n--   CoginitiScript's fallback-to-temp-table materialization strategy is unavailable. Every\n--   chain of block references must stay inside a single SELECT statement (one WITH ... chain)\n--   from the base semantic entity all the way to the final report.\n--\n-- Structure:\n-- - common/    — shared macros (text expansion, not blocks — no CTE involved)\n-- - sales/, customer/, product/ — reusable parameterized blocks wrapping semantic entities\n-- - reports/   — final reports that chain the blocks above into layered analytics:\n--   - sales_trend_report        — MonthlySales() -> WithTrendMetrics() -> MonthlySalesTrendReport()\n--   - channel_mix_report        — SalesByChannelFiscalYear() -> WithChannelRanking() -> ChannelMixReport()\n--   - customer_segment_report   — SegmentStats() -> CustomerSegmentReport()\n--   - product_performance_report — AnnualProductPerformance() -> ProductPerformanceReport()\n--   - store_ranking_report      — SalesByStoreYear() -> WithStoreRanking() -> StoreRankingReport()\n--\n-- Regular reports (parameterized, published to the reports schema) are in \"reports/reports_regular\":\n-- - daily_snapshot    — point-in-time sales summary for a configurable lookback window\n-- - store_rankings    — top-N stores ranked by a chosen metric within a date range\n-- - customer_export   — targeted customer list for CRM and email campaigns\n--\n-- To run all regular reports at once use \".actions/run_scripts/all_reports_regular\".\n--\n-- AI reports (LLM-enriched, published to the reports_ai schema) are in \"reports/reports_ai\":\n-- - product_review_insights      — sentiment labels and marketing recommendations per product\n-- - store_performance_narratives — performance tier, narrative insight, and recommended action per store\n--\n-- To run all AI reports at once use \".actions/run_scripts/all_reports_ai\".\n--\n","platform":null}},{"fqn":"/retail/landing/_config","id":"d70ee06c-a139-11f1-b6b0-6f90300261de","folder_id":"d70e1d18-a139-11f1-b6b0-6f90300261de","name":"_config","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+const\n  numStores = 100;\n  openDateStart = \"2021-01-01\";\n  openDateEnd = \"2022-12-31\";\n  closingDateEnd = \"2023-09-01\";\n  lastRemodelDateEnd = \"2023-09-01\";\n\n  numCustomers = 1000;\n\n  numProducts = 50;\n\n  numSalesTransations = 5000;\n  transactionsStartDate = \"2021-01-01\";\n  transactionsEndDate = \"2023-10-01\";\n#+end\n","platform":null}},{"fqn":"/retail/base/touchpoint/email_address_test","id":"d7134c59-a139-11f1-b6b0-6f90300261de","folder_id":"d71261f3-a139-11f1-b6b0-6f90300261de","name":"email_address_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the email address dimension.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_EmailAddress_NoDuplicatesInPK()\n#+meta {\n  :doc \"Fails if any email_address_key appears more than once, indicating a surrogate key collision in the email address dimension.\"\n}\n#+begin\n  SELECT\n    email_address_key,\n    COUNT(*) AS cnt\n  FROM\n    {{ EmailAddress() }}\n  GROUP BY\n    email_address_key\n  HAVING\n    COUNT(*) > 1\n#+end\n","platform":null}},{"fqn":"/retail/base/_init","id":"d711517b-a139-11f1-b6b0-6f90300261de","folder_id":"d71018f4-a139-11f1-b6b0-6f90300261de","name":"_init","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+src sql Init(): void\n#+meta {\n  :doc \"Initialize a BASE schema with required tables.\"\n}\n#+begin\n  DROP SEQUENCE IF EXISTS base.seq_surrogate_key;\n  CREATE SEQUENCE base.seq_surrogate_key START WITH 1;\n\n  DROP SEQUENCE IF EXISTS base.seq_batch;\n  CREATE SEQUENCE base.seq_batch START WITH 1;\n\n  DROP TABLE IF EXISTS base.batch_log;\n  CREATE TABLE base.batch_log(\n    batch_number BIGINT NOT NULL,\n    system_timestamp TIMESTAMP NOT NULL,\n    PRIMARY KEY (batch_number)\n  );\n\n  DROP TABLE IF EXISTS base.numbers;\n  CREATE TABLE base.numbers AS\n  WITH tmp AS (\n    SELECT 1 AS i\n    UNION ALL SELECT 2\n    UNION ALL SELECT 3\n    UNION ALL SELECT 4\n    UNION ALL SELECT 5\n    UNION ALL SELECT 6\n    UNION ALL SELECT 7\n    UNION ALL SELECT 8\n    UNION ALL SELECT 9\n    UNION ALL SELECT 10\n  )\n  SELECT\n    ROW_NUMBER() OVER () AS id\n  FROM\n    tmp AS a1\n  CROSS JOIN tmp AS a2\n  CROSS JOIN tmp AS a3\n  CROSS JOIN tmp AS a4\n#+end","platform":null}},{"fqn":"/retail/landing_ai/reviews","id":"d70c9673-a139-11f1-b6b0-6f90300261de","folder_id":"d70bfa31-a139-11f1-b6b0-6f90300261de","name":"reviews","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n\n-- New table: landing.product_reviews\n-- Not present in the original landing package — exclusive to landing_ai.\n-- Generates 300 realistic customer reviews referencing products (id 1–100)\n-- and customers (id 1–1000) from the landing schema.\n-- Enables AI sentiment analysis examples in the analytics layer.\n\n#+src llm ProductReviews()\n#+meta {\n  :schema {\n    :columns [\n      {:name \"review_id\",     :type \"INT\",\n       :description \"Sequential ID from 1 to 300\"},\n      {:name \"product_id\",    :type \"INT\",\n       :description \"References a product id between 1 and 100\"},\n      {:name \"customer_id\",   :type \"INT\",\n       :description \"References a customer id between 1 and 1000\"},\n      {:name \"rating\",        :type \"INT\",\n       :description \"Star rating: 1, 2, 3, 4, or 5\"},\n      {:name \"review_text\",   :type \"STRING\",\n       :description \"2–4 sentence review matching the star rating tone\"},\n      {:name \"review_date\",   :type \"DATE\",\n       :description \"Date between 2021-01-01 and 2023-09-30\"},\n      {:name \"helpful_votes\", :type \"INT\",\n       :description \"Number of helpful votes: 0 to 45\"}\n    ]\n  },\n  :publication {\n    :type   \"table\",\n    :name   \"product_reviews\",\n    :schema \"landing\"\n  },\n  :cache_results true\n}\n#+begin\nGenerate exactly 300 realistic product reviews. Assign sequential review_id from 1 to 300.\n\nIMPORTANT: Use plain ASCII letters only in review text. No accented characters or diacritics.\n\nDistribute product_id values across 1 to 100 (approximately 3 reviews per product on average).\nDistribute customer_id values randomly across 1 to 1000 — no customer should have more than 3 reviews.\n\nUse this rating distribution:\n\n- 5% one-star (15 reviews): frustrated, disappointed tone — product broke, wrong item, very poor quality\n- 10% two-star (30 reviews): let down — below expectations, minor defect, not worth the price\n- 25% three-star (75 reviews): mixed — some good points, some bad, neutral tone\n- 35% four-star (105 reviews): satisfied — works well, minor nitpick, would recommend\n- 25% five-star (75 reviews): enthusiastic — exceeded expectations, excellent quality, highly recommend\n\nReview text must match the rating tone. Reviews should reference realistic product attributes\n(quality, value for money, durability, ease of use, packaging, delivery speed).\n\nSpread review_date values evenly across 2021-01-01 to 2023-09-30.\nAssign helpful_votes 0–45; higher-rated reviews tend to get more helpful votes.\n#+end\n","platform":null}},{"fqn":"/retail/.actions","id":"d7217d81-a139-11f1-b6b0-6f90300261de","folder_id":"d70b5df0-a139-11f1-b6b0-6f90300261de","name":".actions","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"PROJECT_ACTIONS","copied_from_id":null}},{"fqn":"/retail/reports/reports_regular","id":"8f049129-a151-11f1-b6b0-6f90300261de","folder_id":"d71918dc-a139-11f1-b6b0-6f90300261de","name":"reports_regular","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/common/report_macros","id":"d7182e79-a139-11f1-b6b0-6f90300261de","folder_id":"d7180768-a139-11f1-b6b0-6f90300261de","name":"report_macros","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"dfe53bd2-8448-11f1-a626-557cda040604"},"asset_type":"CSL","content":"-- Shared macros for the semantic-layer CSL reporting layer\n-- Demonstrates: #+macro — plain text expansion, not a block reference.\n--\n-- Macros never create a block reference, so they never need a CTE and are unaffected by the\n-- \"no temp/permanent tables on the semantic layer connection\" limitation. Use a macro (rather\n-- than a block) for small reusable expressions like these.\n\n#+macro PctShare(numeratorExpr, denominatorExpr)\n#+meta {\n  :doc \"Percentage share with a zero-denominator guard, rounded to 2 decimals.\"\n}\n#+begin\n  CASE\n    WHEN {{ denominatorExpr }} = 0 THEN NULL\n    ELSE ROUND({{ numeratorExpr }} * 100.0 / {{ denominatorExpr }}, 2)\n  END\n#+end\n\n#+macro RfmRiskTier(segmentField)\n#+meta {\n  :doc \"Business risk classification derived from an RFM segment label\n        (see semantic/customer/persona_derived_attributes.smdl for segment definitions).\"\n}\n#+begin\n  CASE\n    WHEN {{ segmentField }} IN ('Cannot lose', 'Potential churners') THEN 'At Risk'\n    WHEN {{ segmentField }} = 'Active fans'                          THEN 'Healthy'\n    WHEN {{ segmentField }} = 'Promising newbies'                    THEN 'Growth'\n    ELSE 'Other'\n  END\n#+end\n","platform":null}},{"fqn":"/retail/base/touchpoint/email_address","id":"d7139a7b-a139-11f1-b6b0-6f90300261de","folder_id":"d71261f3-a139-11f1-b6b0-6f90300261de","name":"email_address","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/sources\"\n#+import \"coginiti.co/foundation/retail/base\"\n\n#+src sql EmailAddress()\n#+meta {\n  :doc \"A dimensional type representing an actual email address.\",\n  :publication {\n    :type \"table\",\n    :name \"dim_email_address\",\n    :schema \"base\",\n    :primary_key [\"email_address_key\"]\n  }\n}\n#+begin\n  WITH source_rows AS (\n    SELECT\n      email_address_nk AS natural_key,\n      email AS email_address,\n      email_domain_nk,\n      row_hash\n    FROM\n      {{ sources.Customers() }}\n\n    UNION ALL\n\n    SELECT\n      email_address_nk AS natural_key,\n      email_address,\n      email_domain_nk,\n      row_hash\n    FROM\n      {{ sources.Stores() }}\n  )\n\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS email_address_key,\n    _t.email_address,\n    {{ base.SurrogateKey(\"_t.email_domain_nk\") }} AS email_domain_key,\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      *,\n      ROW_NUMBER() OVER (PARTITION BY natural_key ORDER BY natural_key DESC, row_hash) AS row_num\n    FROM\n      source_rows\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/.actions/run_scripts/report_store_rankings","id":"53ebb98a-a157-11f1-b6b0-6f90300261de","folder_id":"d721f2b4-a139-11f1-b6b0-6f90300261de","name":"report_store_rankings","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"std/test\"\n#+import \"coginiti.co/foundation/retail/reports/reports_regular\"\n\n\n{{ publication.Run(\n\n  blocks=[reports_regular.StoreRankings]\n\n) }};\n\n\n{{ test.Run(\n\n  tests=[\n    reports_regular.Test_StoreRankings_HasData,\n    reports_regular.Test_StoreRankings_UniqueRanks\n    \n  ]\n) }};\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/reports/store_ranking_report","id":"11f00a00-a152-11f1-b6b0-6f90300261de","folder_id":"d716a7cf-a139-11f1-b6b0-6f90300261de","name":"store_ranking_report","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/reports/reports_semantic/semantic_csl_reporting/sales\"\n\n-- Store Ranking Report\n-- Demonstrates: RANK()/DENSE_RANK() within nested partitions and a top-N filter layered on\n--               top of sales.SalesByStoreYear().\n\n#+src sql WithStoreRanking(yearFrom, yearTo)\n#+meta {\n  :doc \"Adds region/area ranking and share-of-region-sales to sales.SalesByStoreYear().\"\n}\n#+begin\n  SELECT\n    market_region_name,\n    market_area_name,\n    store_id,\n    store_name,\n    gross_sales,\n    transaction_count,\n    units_sold,\n    RANK() OVER (\n      PARTITION BY market_region_name\n      ORDER BY gross_sales DESC\n    ) AS region_rank,\n    DENSE_RANK() OVER (\n      PARTITION BY market_region_name, market_area_name\n      ORDER BY gross_sales DESC\n    ) AS area_rank,\n    SUM(gross_sales) OVER (PARTITION BY market_region_name) AS region_total_sales,\n    gross_sales / NULLIF(store_size, 0) AS sales_per_size_unit\n  FROM\n    {{ sales.SalesByStoreYear(yearFrom, yearTo) }}\n#+end\n\n#+src sql StoreRankingReport(yearFrom, yearTo, topN)\n#+meta {\n  :doc \"Top $topN stores per market region by gross sales.\n        $Parameters:\n          - $yearFrom: earliest calendar year (inclusive)\n          - $yearTo: latest calendar year (inclusive)\n          - $topN: number of top stores to keep per region\"\n}\n#+begin\n  SELECT\n    market_region_name,\n    market_area_name,\n    store_id,\n    store_name,\n    region_rank,\n    area_rank,\n    ROUND(gross_sales, 2) AS gross_sales,\n    transaction_count,\n    units_sold,\n    ROUND(gross_sales / NULLIF(region_total_sales, 0) * 100, 2) AS pct_of_region_sales,\n    ROUND(sales_per_size_unit, 2) AS sales_per_size_unit\n  FROM\n    {{ WithStoreRanking(yearFrom, yearTo) }}\n  WHERE\n    region_rank <= {{ topN }}\n  ORDER BY\n    market_region_name ASC,\n    region_rank ASC\n#+end\n\n-- Runnable example\nSELECT * FROM {{ StoreRankingReport(2022, 2023, 10) }};\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/reports/customer_segment_report","id":"11942e54-a152-11f1-b6b0-6f90300261de","folder_id":"d716a7cf-a139-11f1-b6b0-6f90300261de","name":"customer_segment_report","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/reports/reports_semantic/semantic_csl_reporting/customer\"\n#+import \"coginiti.co/foundation/retail/reports/reports_semantic/semantic_csl_reporting/common\"\n\n-- Customer RFM Segment Report\n-- Demonstrates: layering benchmark comparisons and a shared macro-driven risk classification\n--               on top of customer.SegmentStats().\n\n#+src sql CustomerSegmentReport()\n#+meta {\n  :doc \"RFM segment distribution with per-segment share of customers, a spend index versus the\n        cross-segment average, and a business risk tier.\"\n}\n#+begin\n  SELECT\n    rfm_segment,\n    {{ common.RfmRiskTier(segmentField=\"rfm_segment\") }} AS risk_tier,\n    customer_count,\n    {{ common.PctShare(numeratorExpr=\"customer_count\", denominatorExpr=\"SUM(customer_count) OVER ()\") }} AS pct_of_customers,\n    ROUND(segment_total_sales, 2) AS segment_total_sales,\n    ROUND(avg_lifetime_sales, 2)  AS avg_lifetime_sales,\n    ROUND(max_lifetime_sales, 2)  AS max_lifetime_sales,\n    ROUND(min_lifetime_sales, 2)  AS min_lifetime_sales,\n    ROUND(avg_lifetime_sales / NULLIF(AVG(avg_lifetime_sales) OVER (), 0) * 100, 1) AS spend_index,\n    ROUND(avg_orders, 1) AS avg_orders\n  FROM\n    {{ customer.SegmentStats() }}\n  ORDER BY\n    avg_lifetime_sales DESC\n#+end\n\n-- Runnable example\nSELECT * FROM {{ CustomerSegmentReport() }};\n","platform":null}},{"fqn":"/retail/base/location/market_area","id":"d7123ae2-a139-11f1-b6b0-6f90300261de","folder_id":"d711788c-a139-11f1-b6b0-6f90300261de","name":"market_area","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/sources\"\n#+import \"coginiti.co/foundation/retail/base\"\n\n#+src sql MarketArea()\n#+meta {\n  :doc \"A dimensional type representing the second level of geographical grouping of stores within a Market Region used for aggregating data.\",\n  :publication {\n    :type \"table\",\n    :name \"dim_market_area\",\n    :schema \"base\",\n    :primary_key [\"market_area_key\"],\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS market_area_key,\n    _t.market_area_code AS market_area_id,\n    _t.market_area AS market_area_name,\n    {{ base.SurrogateKey(\"_t.market_region_nk\") }} AS market_region_key,\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      market_area_nk AS natural_key,\n      market_area_code,\n      market_area,\n      market_region_nk,\n      ROW_NUMBER() OVER (PARTITION BY market_area_code ORDER BY market_area_code DESC, row_hash) AS row_num\n    FROM\n      {{ sources.Stores() }}\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/base/offering/offering_review","id":"fb631742-a140-11f1-b6b0-6f90300261de","folder_id":"d7145dd0-a139-11f1-b6b0-6f90300261de","name":"offering_review","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/base\"\n#+import \"coginiti.co/foundation/retail/landing_ai\"\n\n#+src sql OfferingReview()\n#+meta {\n  :doc \"Fact table representing customer product reviews sourced from the AI-generated landing layer.\n        Captures review sentiment, rating, and engagement metrics at the product-customer level.\",\n  :publication {\n    :type \"table\",\n    :name \"fct_reviews\",\n    :schema \"base\"\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"r.review_id\") }} AS review_key,\n    r.review_id,\n    r.product_id,\n    r.customer_id,\n    r.rating,\n    r.review_text,\n    r.review_date,\n    r.helpful_votes,\n    b.system_timestamp                     AS start_datetime,\n    b.batch_number                         AS batch_number\n  FROM {{ landing_ai.ProductReviews() }} r\n  CROSS JOIN {{ base.Batch() }} b\n#+end\n","platform":null}},{"fqn":"/retail/mart/business_unit_dimension","id":"d71dfafb-a139-11f1-b6b0-6f90300261de","folder_id":"d71dacd9-a139-11f1-b6b0-6f90300261de","name":"business_unit_dimension","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base/location\"\n#+import \"coginiti.co/foundation/retail/base/touchpoint\"\n\n#+src sql BusinessUnitDimension()\n#+meta {\n    :doc \"This dimension stores the INTERACTION LOCATION, representing a location with which customers can interact\n        such as a brick and mortal store, web site, call center, or mobile app. As well, the STORE hierarchy is de-normalized.\",\n    :publication {\n    :type \"table\",\n    :name \"business_unit_dimension\",\n    :schema \"mart\"\n  }\n}\n#+begin\n  SELECT\n    s.store_key AS business_unit_key,\n    s.business_unit_id,\n    s.business_unit_name,\n    s.size_unit_of_measure_code,\n    s.open_date,\n    s.closing_date,\n    s.selling_area_size,\n    s.size,\n    s.last_remodel_date,\n    s.site_postal_address_key AS postal_address_key,\n    e.email_address,\n    pn.complete_number AS complete_phone_number,\n    mr.market_region_id,\n    mr.market_region_name,\n    ma.market_area_id,\n    ma.market_area_name,\n    d.district_id,\n    d.district_name,\n    sg.store_group_id,\n    sg.store_group_name\n  FROM\n    {{ location.Store() }} s\n  INNER JOIN {{ touchpoint.EmailAddress() }} e\n    ON e.email_address_key = s.email_address_key\n  INNER JOIN {{ touchpoint.PhoneNumber() }} pn\n    ON pn.phone_number_key = s.phone_number_key\n  INNER JOIN {{ location.StoreGroup() }} sg\n    ON sg.store_group_key = s.store_group_key\n  INNER JOIN {{ location.District() }} d\n    ON d.district_key = sg.district_key\n  INNER JOIN {{ location.MarketArea() }} ma\n    ON ma.market_area_key = d.market_area_key\n  INNER JOIN {{ location.MarketRegion() }} mr\n    ON mr.market_region_key = ma.market_region_key\n#+end\n","platform":null}},{"fqn":"/retail/landing_ai","id":"d70bfa31-a139-11f1-b6b0-6f90300261de","folder_id":"d70b5df0-a139-11f1-b6b0-6f90300261de","name":"landing_ai","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/base/location/store","id":"d7119f9e-a139-11f1-b6b0-6f90300261de","folder_id":"d711788c-a139-11f1-b6b0-6f90300261de","name":"store","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/base\"\n#+import \"coginiti.co/foundation/retail/base/touchpoint\"\n#+import \"coginiti.co/foundation/retail/sources\"\n\n#+src sql Store()\n#+meta {\n  :doc \"A dimensional type representing a physical brick-and-mortar location at which customers can interact.\",\n  :publication {\n    :type \"table\",\n    :name \"dim_store\",\n    :schema \"base\"\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS store_key,\n    {{ base.SurrogateKey(\"_t.inbound_channel_nk\") }} AS inbound_channel_key,\n    store_id AS business_unit_id,\n    store_name AS business_unit_name,\n    {{ base.SurrogateKey(\"_t.postal_address_nk\") }} AS site_postal_address_key,\n    open_date,\n    closing_date,\n    size_unit_of_measure_code,\n    selling_area_size,\n    size,\n    last_remodel_date,\n    {{ base.SurrogateKey(\"_t.email_address_nk\") }} AS email_address_key,\n    {{ base.SurrogateKey(\"_t.phone_number_nk\") }} AS phone_number_key,\n    {{ base.SurrogateKey(\"_t.store_group_nk\") }} AS store_group_key,\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      store_nk AS natural_key,\n      store_id,\n      store_name,\n      open_date,\n      closing_date,\n      size_unit_of_measure_code,\n      selling_area_size,\n      size,\n      last_remodel_date,\n      email_address_nk,\n      phone_number_nk,\n      postal_address_nk,\n      inbound_channel_nk,\n      store_group_nk,\n      ROW_NUMBER() OVER (PARTITION BY store_id ORDER BY store_id DESC, row_hash) AS row_num\n    FROM\n      {{ sources.Stores() }}\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/sources/inbound_channels","id":"d71c262e-a139-11f1-b6b0-6f90300261de","folder_id":"d71b89ea-a139-11f1-b6b0-6f90300261de","name":"inbound_channels","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+src sql InboundChannels()\n#+begin\n  SELECT\n    channel_name,\n    channel_code,\n    {{ NaturalKey(\"IC^\", [\"channel_code\"]) }} AS inbound_channel_nk,\n    {{ RowHash([\n      \"channel_name\",\n      \"channel_code\"\n    ])}} AS row_hash\n  FROM\n    landing.inbound_channels\n#+end\n","platform":null}},{"fqn":"/retail/landing/stores","id":"d70f077d-a139-11f1-b6b0-6f90300261de","folder_id":"d70e1d18-a139-11f1-b6b0-6f90300261de","name":"stores","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n\n-- Store master data — randomly generated for demo purposes.\n-- Produces numStores records with geographic hierarchy, operating dates, and\n-- size attributes. Countries are limited to US, CA, GB, FR, DE, ES, IT.\n\n/**\nTODO:\n- generate country_code for address which is consistent with store region / area\n- generate phone number with phone code which is consistent with store region / area\n*/\n\n-- Returns the static 14-row geographic hierarchy (market region → area → district → store group).\n#+src sql RegionsHierarchy()\n#+begin\n  SELECT * FROM (\n    SELECT 'NA' AS market_region_code, 'North America' AS market_region,\n           'NE' AS market_area_code,   'Northeast'     AS market_area,\n           'NE' AS district_code,      'New England'   AS district,\n           'US' AS store_group_code,   'Urban Stores'  AS store_group\n    UNION ALL SELECT 'NA','North America','NE','Northeast',   'NE','New England',   'SS','Suburban Stores'\n    UNION ALL SELECT 'NA','North America','SE','Southeast',   'SA','South Atlantic', 'RS','Rural Stores'\n    UNION ALL SELECT 'NA','North America','WC','West Coast',  'PA','Pacific',        'FS','Flagship Stores'\n    UNION ALL SELECT 'EU','Europe',       'NEU','Northern Europe','UKI','UK & Ireland', 'UKS','UK Stores'\n    UNION ALL SELECT 'EU','Europe',       'NEU','Northern Europe','UKI','UK & Ireland', 'IRS','Ireland Stores'\n    UNION ALL SELECT 'EU','Europe',       'WEU','Western Europe', 'DACH','DACH',         'GES','Germany Stores'\n    UNION ALL SELECT 'EU','Europe',       'WEU','Western Europe', 'DACH','DACH',         'SWS','Switzerland Stores'\n    UNION ALL SELECT 'EU','Europe',       'BNLX','Benelux',       'BNLX','Benelux',      'BES','Belgium Stores'\n    UNION ALL SELECT 'EU','Europe',       'BNLX','Benelux',       'BNLX','Benelux',      'NLS','Netherlands Stores'\n    UNION ALL SELECT 'AP','Asia Pacific', 'SEA','Southeast Asia', 'SNM','Singapore & Malaysia','SGS','Singapore Stores'\n    UNION ALL SELECT 'AP','Asia Pacific', 'SEA','Southeast Asia', 'SNM','Singapore & Malaysia','MAS','Malaysia Stores'\n    UNION ALL SELECT 'AP','Asia Pacific', 'NA','North Asia',      'JPN','Japan',           'US','Urban Stores'\n    UNION ALL SELECT 'AP','Asia Pacific', 'NA','North Asia',      'JPN','Japan',           'SS','Suburban Stores'\n  ) AS t;\n#+end\n\n#+src sql Stores()\n#+meta {\n  :publication {\n    :type \"table\",\n    :name \"stores\",\n    :schema \"landing\"\n  }\n}\n#+begin\n  WITH countries AS (\n    SELECT\n      row_number() OVER ()  AS country_id,\n      country_code_2,\n      country_name,\n      continent_name\n    FROM (\n      SELECT 'US' AS country_code_2, 'USA'            AS country_name, 'North America' AS continent_name\n      UNION ALL SELECT 'CA', 'Canada',         'North America'\n      UNION ALL SELECT 'GB', 'United Kingdom', 'Europe'\n      UNION ALL SELECT 'FR', 'France',         'Europe'\n      UNION ALL SELECT 'DE', 'Germany',        'Europe'\n      UNION ALL SELECT 'ES', 'Spain',          'Europe'\n      UNION ALL SELECT 'IT', 'Italy',          'Europe'\n    ) AS countries\n  ),\n\n  stores AS (\n    SELECT\n      row_number() OVER ()                                                             AS seq_number,\n      'ST' || row_number() OVER ()                                                     AS store_id,\n      'Store ' || row_number() OVER ()                                                 AS store_name,\n      (random() * (SELECT COUNT(*) - 1 FROM countries))::int + 1                      AS country_id,\n      '{{ openDateStart }}'::TIMESTAMPTZ\n        + random() * ('{{ openDateEnd }}'::TIMESTAMPTZ\n                    - '{{ openDateStart }}'::TIMESTAMPTZ)                             AS open_date,\n      (random() * 10000)::int + 100                                                    AS size,\n      (random() * (SELECT COUNT(*) - 1 FROM {{ RegionsHierarchy() }}))::INT + 1       AS region_hierarchy_id\n    FROM {{ Series(numStores) }} s\n  ),\n\n  regions_hierarchy AS (\n    SELECT\n      row_number() OVER () AS id,\n      *\n    FROM {{ RegionsHierarchy() }}\n  ),\n\n  phone_numbers AS (\n    SELECT\n      ROW_NUMBER() OVER () AS seq_number,\n      *\n    FROM {{ MobilePhoneNumbers(numStores) }}\n  )\n\n  SELECT\n    s.store_id,\n    s.store_name,\n    c.country_code_2,\n    c.continent_name,\n    s.open_date,\n    CASE\n      WHEN random() < 0.25 THEN\n        open_date + INTERVAL '1 year' + random() * INTERVAL '1 year'\n    END                                                                                 AS closing_date,\n    CASE\n      WHEN c.country_code_2 = 'US' THEN 'SF'\n      WHEN c.country_code_2 = 'CA' THEN 'SF'\n      ELSE 'SM'\n    END                                                                                 AS size_unit_of_measure_code,\n    (size - (random() * size / 2))::INT                                                 AS selling_area_size,\n    size,\n    CASE\n      WHEN random() < 0.1 THEN\n        open_date + INTERVAL '1 year' + random() * INTERVAL '1 year'\n    END                                                                                 AS last_remodel_date,\n    LOWER(REPLACE(s.store_name, ' ', '_')) || '@rcorp.com'                             AS email_address,\n    pn.phone_number,\n    rh.market_region_code,\n    rh.market_region,\n    rh.market_area_code,\n    rh.market_area,\n    rh.district_code,\n    rh.district,\n    rh.store_group_code,\n    rh.store_group,\n    concat(\n      substring('abcdefghijklmnopqrstuvwxyz', (random()*26+1)::int, 1), ' ',\n      substring('abcdefghijklmnopqrstuvwxyz', (random()*26+1)::int, 1), ' ',\n      (random()*1000)::int\n    )                                                                                   AS address_line_1,\n    concat(\n      substring('abcdefghijklmnopqrstuvwxyz', (random()*26+1)::int, 1), ' ',\n      substring('abcdefghijklmnopqrstuvwxyz', (random()*26+1)::int, 1), ' ',\n      (random()*1000)::int\n    )                                                                                   AS address_line_2,\n    concat(\n      substring('abcdefghijklmnopqrstuvwxyz', (random()*26+1)::int, 1), ' ',\n      substring('abcdefghijklmnopqrstuvwxyz', (random()*26+1)::int, 1)\n    )                                                                                   AS city,\n    (random()*90000+10000)::CHAR(5)                                                    AS postal_code,\n    CASE\n      WHEN random() < 0.50 THEN 'STR'\n      WHEN random() < 0.75 THEN 'WEB'\n      WHEN random() < 0.90 THEN 'APP'\n      ELSE 'PCC'\n    END                                                                                 AS inbound_channel_code\n  FROM stores s\n  INNER JOIN countries c\n    ON c.country_id = s.country_id\n  INNER JOIN regions_hierarchy rh\n    ON rh.id = s.region_hierarchy_id\n  INNER JOIN phone_numbers pn\n    ON pn.seq_number = s.seq_number\n#+end\n","platform":null}},{"fqn":"/retail/base/touchpoint/email_domain","id":"d712b015-a139-11f1-b6b0-6f90300261de","folder_id":"d71261f3-a139-11f1-b6b0-6f90300261de","name":"email_domain","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/sources\"\n#+import \"coginiti.co/foundation/retail/base\"\n\n#+src sql EmailDomain()\n#+meta {\n  :doc \"The internet domain (e.g. google.com).\",\n  :publication {\n    :type \"table\",\n    :name \"dim_email_domain\",\n    :schema \"base\",\n    :primary_key [\"email_domain_key\"]\n  }\n}\n#+begin\n  WITH source_rows AS (\n    SELECT\n      email_domain_nk AS natural_key,\n      email_domain AS domain,\n      row_hash\n    FROM\n      {{ sources.Customers() }}\n\n    UNION ALL\n\n    SELECT\n      email_domain_nk AS natural_key,\n      email_domain AS domain,\n      row_hash\n    FROM\n      {{ sources.Stores() }}\n  )\n\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS email_domain_key,\n    _t.domain,\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      *,\n      ROW_NUMBER() OVER (PARTITION BY natural_key ORDER BY natural_key DESC, row_hash) AS row_num\n    FROM\n      source_rows\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/base/utils","id":"d714abf2-a139-11f1-b6b0-6f90300261de","folder_id":"d71018f4-a139-11f1-b6b0-6f90300261de","name":"utils","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"std/time\"\n\n#+macro SurrogateKey(field)\n#+begin\n  MD5(COALESCE({{ field }}::TEXT, ''))::TEXT\n#+end\n\n#+macro SurrogateKeyFromFields(fields)\n#+begin\n  MD5(CONCAT(\n    #+for f : fields separator \",'|', \" do\n      COALESCE({{ f }}::TEXT, '')\n    #+end\n  ))\n#+end\n\n#+src sql Batch()\n#+meta {\n  :doc \"Generate a new batch record.\",\n  :publication {\n    :type \"table\",\n    :name \"batch_\" + time.Format(time.NowUTC(), \"yyyy_MM_dd_HH_mm_ss\"),\n    :schema \"stage\"\n  }\n}\n#+begin\n  SELECT\n    NEXTVAL('base.seq_batch') AS batch_number,\n    CURRENT_TIMESTAMP AS system_timestamp\n#+end\n\n#+src sql EndBatch(): void\n#+meta {\n  :doc \"Save batch record into the log table.\"\n}\n#+begin\n  INSERT INTO base.batch_log(\n    batch_number,\n    system_timestamp\n  )\n  SELECT\n    *\n  FROM\n    {{ Batch() }}\n  ;\n\n  DROP TABLE {{ Batch() }};\n#+end","platform":null}},{"fqn":"/retail/semantic_layer/customer","id":"d72044fa-a139-11f1-b6b0-6f90300261de","folder_id":"d71f3383-a139-11f1-b6b0-6f90300261de","name":"customer","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"2a59a0f9-3cff-11f1-a457-d9456ae162d8"}}},{"fqn":"/retail/sources/customers_test","id":"d71bff1d-a139-11f1-b6b0-6f90300261de","folder_id":"d71b89ea-a139-11f1-b6b0-6f90300261de","name":"customers_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the customers source.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_Customers_UniqueID()\n#+meta {\n  :doc \"Fails if any customer_id appears more than once, indicating a duplicate record in the customers source.\"\n}\n#+begin\n  SELECT\n    customer_id,\n    COUNT(*) AS cnt\n  FROM\n    {{ Customers() }}\n  GROUP BY\n    customer_id\n  HAVING\n    COUNT(*) > 1\n#+end\n\n#+test sql Test_Customers_ValidEmail()\n#+meta {\n  :doc \"Fails if any customer has a malformed email address, indicating a data quality issue in the source or email generation logic.\"\n}\n#+begin\n  -- Email must contain exactly one @ sign with a non-empty local part and domain\n  SELECT\n    customer_id,\n    email\n  FROM\n    {{ Customers() }}\n  WHERE\n    email !~* '^[A-Za-z0-9._%-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$'\n#+end\n","platform":null}},{"fqn":"/retail/sources/utils","id":"d71cc273-a139-11f1-b6b0-6f90300261de","folder_id":"d71b89ea-a139-11f1-b6b0-6f90300261de","name":"utils","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+macro NaturalKey(prefix, fields)\n#+begin\n  '{{ prefix }}' || #+for f : fields separator \"|| '|' ||\" do COALESCE({{ f }}::TEXT, '') #+end\n#+end\n\n#+macro RowHash(fields)\n#+begin\n  MD5(CONCAT(\n    #+for f : fields separator \", '|',\" do\n      COALESCE({{ f }}::VARCHAR(512), '')\n    #+end\n  ))\n#+end","platform":null}},{"fqn":"/retail/sources/products","id":"d71bb0fb-a139-11f1-b6b0-6f90300261de","folder_id":"d71b89ea-a139-11f1-b6b0-6f90300261de","name":"products","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+src sql Products()\n#+begin\n  SELECT\n    id AS product_id,\n    name,\n    category_code,\n    category_name,\n    {{ NaturalKey(\"PRD^\", [\"id\"]) }} AS product_nk,\n    {{ RowHash([\n      \"id\",\n      \"name\",\n      \"category_code\",\n      \"category_name\"\n    ]) }} AS row_hash\n  FROM\n    landing.products\n#+end\n","platform":null}},{"fqn":"/retail/derived_attributes","id":"d723ee91-a139-11f1-b6b0-6f90300261de","folder_id":"d70b5df0-a139-11f1-b6b0-6f90300261de","name":"derived_attributes","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/landing_ai/stores","id":"d70d32b5-a139-11f1-b6b0-6f90300261de","folder_id":"d70bfa31-a139-11f1-b6b0-6f90300261de","name":"stores","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/landing\"\n\n-- AI-driven store records.\n-- An LLM block generates exactly 100 unique store location entries (pool_id 1–100),\n-- one per store. SQL joins each store to its pool entry 1:1 (pool_id = seq_number),\n-- guaranteeing a unique store_name for every row.\n-- Country distribution is determined by pool layout: 28 US, 10 CA, 19 GB, 12 FR,\n-- 14 DE, 10 ES, 7 IT. All other attributes (dates, sizes, hierarchy, phone numbers)\n-- mirror landing/stores exactly.\n-- Publishes to the same landing.stores table as landing/stores.\n\n-- Pool of realistic store location names, one per country bucket.\n#+src llm StoreLocationPool()\n#+meta {\n  :schema {\n    :columns [\n      {:name \"pool_id\",       :type \"INT\",\n       :description \"Sequential ID from 1 to 100\"},\n      {:name \"location_name\", :type \"STRING\",\n       :description \"Short neighborhood or landmark name, 2–3 words — must be unique across all 100 rows (e.g. 'Magnificent Mile', 'Mitte', 'Oxford Street', 'Marina Bay')\"},\n      {:name \"street_name\",   :type \"STRING\",\n       :description \"Realistic street name for this city (e.g. 'Michigan Avenue', 'Karl-Marx-Strasse', 'Oxford Street')\"},\n      {:name \"city\",          :type \"STRING\",\n       :description \"Real city name\"},\n      {:name \"country_code\",  :type \"STRING\",\n       :description \"ISO 2-letter code — must be one of: US, CA, GB, FR, DE, ES, IT\"}\n    ]\n  },\n  :cache_results true\n}\n#+begin\nGenerate exactly 100 retail store location entries. Assign sequential pool_id from 1 to 100.\n\nIMPORTANT: Use plain ASCII letters only. No accented characters, diacritics, or special letters\n(e.g. write \"Champs-Elysees\" not \"Champs-Elysees\", \"Gran Via\" not \"Gran Via\",\n\"Kurfurstendamm\" not \"Kurfurstendamm\", \"Ile de la Cite\" not \"Ile de la Cite\").\n\nDistribute by country:\n- US (28 entries, pool_id 1–28): cities — New York, Los Angeles, Chicago, Houston, Phoenix,\n  Seattle, Boston, Miami, Denver, Atlanta, Dallas, San Francisco, Las Vegas, Portland, Nashville.\n  Use real neighborhood and district names (e.g. \"Times Square\", \"Beverly Hills\", \"Navy Pier\").\n- CA (10 entries, pool_id 29–38): cities — Toronto, Vancouver, Montreal, Calgary, Ottawa, Edmonton.\n  (e.g. \"Yorkville\", \"Gastown\", \"Old Montreal\")\n- GB (19 entries, pool_id 39–57): cities — London, Manchester, Birmingham, Edinburgh, Bristol,\n  Leeds, Glasgow, Cardiff.\n  (e.g. \"Oxford Street\", \"Northern Quarter\", \"Bullring\", \"Royal Mile\")\n- FR (12 entries, pool_id 58–69): cities — Paris, Lyon, Marseille, Toulouse, Bordeaux, Nice.\n  (e.g. \"Champs-Elysees\", \"Presqu'ile\", \"Vieux-Port\")\n- DE (14 entries, pool_id 70–83): cities — Berlin, Munich, Hamburg, Frankfurt, Cologne, Stuttgart.\n  (e.g. \"Mitte\", \"Marienplatz\", \"Hafencity\", \"Sachsenhausen\")\n- ES (10 entries, pool_id 84–93): cities — Madrid, Barcelona, Valencia, Seville, Bilbao.\n  (e.g. \"Gran Via\", \"Las Ramblas\", \"Ciudad de las Artes\")\n- IT (7 entries, pool_id 94–100): cities — Milan, Rome, Florence, Naples, Turin, Venice.\n  (e.g. \"Quadrilatero della Moda\", \"Trastevere\", \"Santa Croce\")\n\nEach location_name should be the neighborhood/district only (no city prefix — the store name\nwill be built as city + location_name in the query).\nEvery location_name value must be unique across all 100 rows — do not repeat the same neighborhood name even across different cities.\nUse real, recognizable street names for each city.\n#+end\n\n-- Each store maps 1:1 to a pool entry (pool_id = seq_number), guaranteeing unique store_name.\n-- Country comes from the pool entry; dates, sizes, region hierarchy, and channel are random.\n#+src sql Stores()\n#+meta {\n  :publication {\n    :type   \"table\",\n    :name   \"stores\",\n    :schema \"landing\"\n  }\n}\n#+begin\n  WITH\n  loc_pool AS (\n    SELECT pool_id, location_name, street_name, city, country_code\n    FROM {{ StoreLocationPool() }}\n  ),\n\n  -- Map each store country to the valid rows in RegionsHierarchy()\n  -- Rows 1–4:  NA (US, CA)\n  -- Rows 5–6:  EU/NEU/UKI — UK & Ireland (GB)\n  -- Rows 7–8:  EU/WEU/DACH — Germany (DE)\n  -- Rows 9–10: EU/BNLX — used for FR, ES, IT (closest available EU grouping)\n  country_region_map (country_code, min_rh_id, max_rh_id, continent_name) AS (\n    VALUES\n      ('US', 1, 4,  'North America'),\n      ('CA', 1, 4,  'North America'),\n      ('GB', 5, 6,  'Europe'),\n      ('DE', 7, 8,  'Europe'),\n      ('FR', 9, 10, 'Europe'),\n      ('ES', 9, 10, 'Europe'),\n      ('IT', 9, 10, 'Europe')\n  ),\n\n  regions_hierarchy AS (\n    SELECT row_number() OVER () AS id, *\n    FROM {{ landing.RegionsHierarchy() }}\n  ),\n\n  phone_numbers AS (\n    SELECT ROW_NUMBER() OVER () AS seq_number, phone_number\n    FROM {{ landing.MobilePhoneNumbers(numStores) }}\n  ),\n\n  -- Each store maps 1:1 to a pool entry; country comes from the pool\n  stores AS (\n    SELECT\n      gs.id                                                              AS seq_number,\n      'ST' || gs.id                                                      AS store_id,\n      lp.country_code,\n      lp.location_name,\n      lp.street_name,\n      lp.city,\n      '{{ openDateStart }}'::TIMESTAMPTZ\n        + random() * ('{{ openDateEnd }}'::TIMESTAMPTZ\n                    - '{{ openDateStart }}'::TIMESTAMPTZ)                AS open_date,\n      (random() * 10000)::INT + 100                                      AS size\n    FROM generate_series(1, {{ numStores }}) AS gs(id)\n    JOIN loc_pool lp ON lp.pool_id = gs.id\n  ),\n\n  stores_expanded AS (\n    SELECT\n      s.*,\n      crm.continent_name,\n      crm.min_rh_id,\n      crm.max_rh_id,\n      (FLOOR(random() * (crm.max_rh_id - crm.min_rh_id + 1))::INT\n        + crm.min_rh_id)                                                 AS region_hierarchy_id\n    FROM stores s\n    JOIN country_region_map crm ON crm.country_code = s.country_code\n  )\n\n  SELECT\n    s.store_id,\n    s.city || ' ' || s.location_name                                    AS store_name,\n    s.country_code                                                       AS country_code_2,\n    s.continent_name,\n    s.open_date,\n    CASE\n      WHEN random() < 0.25\n        THEN s.open_date + INTERVAL '1 year' + random() * INTERVAL '1 year'\n    END                                                                  AS closing_date,\n    CASE\n      WHEN s.country_code IN ('US', 'CA') THEN 'SF'\n      ELSE 'SM'\n    END                                                                  AS size_unit_of_measure_code,\n    (s.size - (random() * s.size / 2))::INT                             AS selling_area_size,\n    s.size,\n    CASE\n      WHEN random() < 0.1\n        THEN s.open_date + INTERVAL '1 year' + random() * INTERVAL '1 year'\n    END                                                                  AS last_remodel_date,\n    LOWER(REPLACE(s.city || ' ' || s.location_name, ' ', '_'))\n      || '@rcorp.com'                                                    AS email_address,\n    pn.phone_number,\n    rh.market_region_code,\n    rh.market_region,\n    rh.market_area_code,\n    rh.market_area,\n    rh.district_code,\n    rh.district,\n    rh.store_group_code,\n    rh.store_group,\n    (s.seq_number % 999 + 1)::TEXT || ' ' || s.street_name             AS address_line_1,\n    NULL::VARCHAR                                                        AS address_line_2,\n    s.city,\n    LPAD(((s.seq_number * 97) % 90000 + 10000)::TEXT, 5, '0')          AS postal_code,\n    CASE\n      WHEN random() < 0.50 THEN 'STR'\n      WHEN random() < 0.75 THEN 'WEB'\n      WHEN random() < 0.90 THEN 'APP'\n      ELSE 'PCC'\n    END                                                                  AS inbound_channel_code\n  FROM      stores_expanded    s\n  JOIN      regions_hierarchy  rh  ON rh.id = s.region_hierarchy_id\n  JOIN      phone_numbers      pn  ON pn.seq_number = s.seq_number\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/customer","id":"d718558a-a139-11f1-b6b0-6f90300261de","folder_id":"d715e47a-a139-11f1-b6b0-6f90300261de","name":"customer","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"c833b756-8448-11f1-a626-557cda040604"}}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting","id":"d715e47a-a139-11f1-b6b0-6f90300261de","folder_id":"764740bf-a151-11f1-b6b0-6f90300261de","name":"semantic_csl_reporting","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"a1bdd469-8448-11f1-a626-557cda040604"}}},{"fqn":"/retail/mart/item_dimension","id":"d71e702e-a139-11f1-b6b0-6f90300261de","folder_id":"d71dacd9-a139-11f1-b6b0-6f90300261de","name":"item_dimension","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base/offering\"\n\n-- TODO: add offering hierarchy\n#+src sql ItemDimension()\n#+meta {\n  :doc `This dimension stores the entire \"ITEM SEGMENT\" hierarchy with the lowest grain being the actual item (retailer SKU).`,\n  :publication {\n    :type \"table\",\n    :name \"item_dimension\",\n    :schema \"mart\"\n  }\n}\n#+begin\n  SELECT\n    o.offering_item_key AS item_key,\n    o.item_id,\n    o.item_name\n  FROM\n    {{ offering.OfferingItem() }} o\n#+end\n","platform":null}},{"fqn":"/retail/landing/customers","id":"d70e6b39-a139-11f1-b6b0-6f90300261de","folder_id":"d70e1d18-a139-11f1-b6b0-6f90300261de","name":"customers","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n\n-- Customer master data — randomly generated for demo purposes.\n-- Uses first/last name lists and country phone codes to produce\n-- 1000 realistic-looking customer records (count driven by numCustomers in _config).\n\n-- Generate n random full names by drawing from static first/last name lists.\n#+src sql fullNames(n)\n#+meta {\n  :doc \"Generate n rows of random first_name / last_name pairs.\"\n}\n#+begin\n  WITH\n  first_names AS (\n    SELECT ROW_NUMBER() OVER () AS idx, first_name FROM (\n      SELECT 'James'     AS first_name UNION ALL SELECT 'John'       UNION ALL SELECT 'Robert'\n      UNION ALL SELECT 'Michael'     UNION ALL SELECT 'William'     UNION ALL SELECT 'David'\n      UNION ALL SELECT 'Richard'     UNION ALL SELECT 'Joseph'      UNION ALL SELECT 'Thomas'\n      UNION ALL SELECT 'Charles'     UNION ALL SELECT 'Mary'        UNION ALL SELECT 'Patricia'\n      UNION ALL SELECT 'Jennifer'    UNION ALL SELECT 'Linda'       UNION ALL SELECT 'Barbara'\n      UNION ALL SELECT 'Elizabeth'   UNION ALL SELECT 'Susan'       UNION ALL SELECT 'Jessica'\n      UNION ALL SELECT 'Sarah'       UNION ALL SELECT 'Karen'\n    ) fn\n  ),\n  last_names AS (\n    SELECT ROW_NUMBER() OVER () AS idx, last_name FROM (\n      SELECT 'Smith'     AS last_name  UNION ALL SELECT 'Johnson'    UNION ALL SELECT 'Williams'\n      UNION ALL SELECT 'Brown'       UNION ALL SELECT 'Jones'       UNION ALL SELECT 'Garcia'\n      UNION ALL SELECT 'Miller'      UNION ALL SELECT 'Davis'       UNION ALL SELECT 'Wilson'\n      UNION ALL SELECT 'Martinez'    UNION ALL SELECT 'Anderson'    UNION ALL SELECT 'Taylor'\n      UNION ALL SELECT 'Thomas'      UNION ALL SELECT 'Hernandez'   UNION ALL SELECT 'Moore'\n      UNION ALL SELECT 'Martin'      UNION ALL SELECT 'Jackson'     UNION ALL SELECT 'Thompson'\n      UNION ALL SELECT 'White'       UNION ALL SELECT 'Lopez'\n    ) ln\n  )\n  SELECT\n    fn.first_name,\n    ln.last_name\n  FROM generate_series(1, {{ n }}) gs(id)\n  JOIN first_names fn ON fn.idx = (gs.id % 20) + 1\n  JOIN last_names  ln ON ln.idx = ((gs.id / 20) % 20) + 1\n#+end\n\n-- Generate n random phone numbers using CountryPhoneCodes prefix + random digits.\n#+src sql MobilePhoneNumbers(n)\n#+meta {\n  :doc \"Generate a random set of phone numbers.\"\n}\n#+begin\n  WITH entries AS (\n    SELECT\n      (random() * (SELECT COUNT(*) - 1 FROM {{ CountryPhoneCodes() }}))::INT + 1 AS sequence_number\n    FROM {{ Series(n) }}\n  )\n  SELECT\n    c.phone_number_code\n      || FLOOR(random() * POWER(10, c.phone_number_length))::TEXT AS phone_number\n  FROM entries e\n  INNER JOIN {{ CountryPhoneCodes() }} c\n    ON c.sequence_number = e.sequence_number\n#+end\n\n-- Map a phone number back to its ISO 2 country code via prefix matching.\n#+src sql PhoneNumberToCountryCode()\n#+begin\n  SELECT p.phone_number, c.iso_2_code\n  FROM {{ MobilePhoneNumbers(numCustomers) }} p\n  LEFT JOIN {{ CountryPhoneCodes() }} c\n    ON LEFT(p.phone_number, LENGTH(c.phone_number_code)) = c.phone_number_code\n#+end\n\n#+macro email_address(firstname, lastname)\n#+begin\n  LOWER({{ firstname }}) || '_' || LOWER({{ lastname }}) || CAST(RANDOM() * 1000 AS INT) || '@' || (\n    CASE CAST(RANDOM() * 3 AS INT)\n      WHEN 0 THEN 'gmail'\n      WHEN 1 THEN 'hotmail'\n      WHEN 2 THEN 'yahoo'\n      WHEN 3 THEN 'outlook.com'\n    END\n  ) || '.com'\n#+end\n\n#+src sql Customers()\n#+meta {\n  :publication {\n    :type \"table\",\n    :name \"customers\",\n    :schema \"landing\"\n  }\n}\n#+begin\n  WITH phone_numbers AS (\n    SELECT\n      ROW_NUMBER() OVER () AS sequence_number,\n      *\n    FROM {{ MobilePhoneNumbers(numCustomers) }}\n  ),\n\n  entries AS (\n    SELECT\n      ROW_NUMBER() OVER ()                                AS sequence_number,\n      first_name,\n      last_name,\n      {{ email_address(\"first_name\", \"last_name\") }}      AS email\n    FROM {{ fullNames(numCustomers) }}\n  )\n\n  SELECT\n    c.sequence_number                                     AS id,\n    first_name,\n    last_name,\n    email,\n    concat(\n      substring('abcdefghijklmnopqrstuvwxyz', (random()*26+1)::int, 1), ' ',\n      substring('abcdefghijklmnopqrstuvwxyz', (random()*26+1)::int, 1), ' ',\n      (random()*1000)::int\n    )                                                     AS address_line_1,\n    concat(\n      substring('abcdefghijklmnopqrstuvwxyz', (random()*26+1)::int, 1), ' ',\n      substring('abcdefghijklmnopqrstuvwxyz', (random()*26+1)::int, 1), ' ',\n      (random()*1000)::int\n    )                                                     AS address_line_2,\n    concat(\n      substring('abcdefghijklmnopqrstuvwxyz', (random()*26+1)::int, 1), ' ',\n      substring('abcdefghijklmnopqrstuvwxyz', (random()*26+1)::int, 1)\n    )                                                     AS city,\n    (random()*90000+10000)::CHAR(5)                       AS postal_code,\n    pn.phone_number\n  FROM entries c\n  INNER JOIN phone_numbers pn\n    ON pn.sequence_number = c.sequence_number\n#+end\n","platform":null}},{"fqn":"/retail/.actions/run_scripts/report_store_performance_narratives","id":"1ef13e17-a153-11f1-b6b0-6f90300261de","folder_id":"d721f2b4-a139-11f1-b6b0-6f90300261de","name":"report_store_performance_narratives","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"std/test\"\n#+import \"coginiti.co/foundation/retail/reports/reports_ai\"\n\n\n{{ publication.Run(\n\n  blocks=[reports_ai.StorePerformanceNarratives]\n\n) }};\n\n\n{{ test.Run(\n\n  tests=[\n    reports_ai.Test_StorePerformanceNarratives_HasData,\n    reports_ai.Test_StorePerformanceNarratives_UniqueStores,\n    reports_ai.Test_StorePerformanceNarratives_ValidPerformanceTiers,\n    reports_ai.Test_StorePerformanceNarratives_NoNullNarratives,\n    reports_ai.Test_StorePerformanceNarratives_PositiveRevenue,\n    reports_ai.Test_StorePerformanceNarratives_RankBounds\n  ]\n\n) }};\n","platform":null}},{"fqn":"/retail/landing/series","id":"d70f7cb0-a139-11f1-b6b0-6f90300261de","folder_id":"d70e1d18-a139-11f1-b6b0-6f90300261de","name":"series","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Utility helpers for generating numeric and date sequences.\n\n#+src sql Series(n)\n#+meta {\n  :doc \"Generate a sequence of integers from 1 to n.\"\n}\n#+begin\n  SELECT generate_series(1, {{ n }}) AS id\n#+end\n\n#+src sql DateSeries(startDate, numDays)\n#+meta {\n  :doc \"Generate a sequence of dates starting from startDate for numDays days.\"\n}\n#+begin\n  SELECT\n    '{{ startDate }}'::DATE + generate_series(0, {{ numDays }} - 1) * INTERVAL '1 day' AS date_day\n#+end\n","platform":null}},{"fqn":"/retail/semantic_layer/sales","id":"d71fa8b6-a139-11f1-b6b0-6f90300261de","folder_id":"d71f3383-a139-11f1-b6b0-6f90300261de","name":"sales","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"2a59a0f3-3cff-11f1-a457-d9456ae162d8"}}},{"fqn":"/retail/.actions/run_scripts/all_reports_regular","id":"5416e83f-a157-11f1-b6b0-6f90300261de","folder_id":"d721f2b4-a139-11f1-b6b0-6f90300261de","name":"all_reports_regular","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"std/test\"\n#+import \"coginiti.co/foundation/retail/reports/reports_regular\"\n\n\n{{ publication.Run(\n\n  blocks=[reports_regular.CustomerExport]\n\n) }};\n\n\n{{ test.Run(\n\n  tests=[\n    reports_regular.Test_CustomerExport_HasData,\n    reports_regular.Test_CustomerExport_UniqueCustomer\n    \n  ]\n) }};\n\n\n\n{{ publication.Run(\n\n  blocks=[reports_regular.DailySnapshot]\n  \n) }};\n\n\n{{ test.Run(\n\n  tests=[\n    reports_regular.Test_DailySnapshot_HasData,\n    reports_regular.Test_DailySnapshot_NoNullDates\n  ]\n  \n) }};\n\n\n\n\n{{ publication.Run(\n\n  blocks=[reports_regular.StoreRankings]\n\n) }};\n\n\n{{ test.Run(\n\n  tests=[\n    reports_regular.Test_StoreRankings_HasData,\n    reports_regular.Test_StoreRankings_UniqueRanks\n    \n  ]\n) }};\n","platform":null}},{"fqn":"/retail/.actions/run_scripts/report_product_review_insights","id":"1ec4d6e2-a153-11f1-b6b0-6f90300261de","folder_id":"d721f2b4-a139-11f1-b6b0-6f90300261de","name":"report_product_review_insights","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"std/test\"\n#+import \"coginiti.co/foundation/retail/reports/reports_ai\"\n\n\n{{ publication.Run(\n\n  blocks=[reports_ai.ProductReviewInsights]\n\n) }};\n\n\n{{ test.Run(\n\n  tests=[\n    reports_ai.Test_ProductReviewInsights_HasData,\n    reports_ai.Test_ProductReviewInsights_UniqueProducts,\n    reports_ai.Test_ProductReviewInsights_ValidSentimentLabels,\n    reports_ai.Test_ProductReviewInsights_NoNullInsights,\n    reports_ai.Test_ProductReviewInsights_PositiveRevenue\n  ]\n\n) }};\n","platform":null}},{"fqn":"/retail/base/touchpoint","id":"d71261f3-a139-11f1-b6b0-6f90300261de","folder_id":"d71018f4-a139-11f1-b6b0-6f90300261de","name":"touchpoint","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/base/datetime/date","id":"d71436bf-a139-11f1-b6b0-6f90300261de","folder_id":"d7140fae-a139-11f1-b6b0-6f90300261de","name":"date","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/sources\"\n#+import \"coginiti.co/foundation/retail/base\"\n\n#+src sql Date()\n#+meta {\n  :doc `A dimensional type representing the actual date. Its sub-types will be \"GREGORIAN DATE\" and \"FISCAL DATE\".`,\n  :publication {\n    :type \"table\",\n    :name \"dim_date\",\n    :schema \"base\"\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS date_key,\n    _t.business_day_date,\n    _t.calendar_year,\n    _t.calendar_quarter,\n    _t.calendar_month,\n    _t.calendar_week,\n    _t.calendar_week_day,\n    _t.calendar_holiday_flag,\n    _t.fiscal_year,\n    _t.fiscal_quarter,\n    _t.fiscal_period,\n    _t.fiscal_week,\n    _t.fiscal_week_day,\n    _t.fiscal_holiday_flag,\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      date_nk AS natural_key,\n      business_day_date,\n      calendar_year,\n      calendar_quarter,\n      calendar_month,\n      calendar_week,\n      calendar_week_day,\n      calendar_holiday_flag,\n      fiscal_year,\n      fiscal_quarter,\n      fiscal_period,\n      fiscal_week,\n      fiscal_week_day,\n      fiscal_holiday_flag\n    FROM\n      {{ sources.DateCalendar() }}\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n#+end\n","platform":null}},{"fqn":"/retail/.actions/run_scripts/report_customer_export","id":"5389753e-a157-11f1-b6b0-6f90300261de","folder_id":"d721f2b4-a139-11f1-b6b0-6f90300261de","name":"report_customer_export","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"std/test\"\n#+import \"coginiti.co/foundation/retail/reports/reports_regular\"\n\n\n{{ publication.Run(\n\n  blocks=[reports_regular.CustomerExport]\n\n) }};\n\n\n{{ test.Run(\n\n  tests=[\n    reports_regular.Test_CustomerExport_HasData,\n    reports_regular.Test_CustomerExport_UniqueCustomer\n    \n  ]\n) }};\n","platform":null}},{"fqn":"/retail/mart","id":"d71dacd9-a139-11f1-b6b0-6f90300261de","folder_id":"d70b5df0-a139-11f1-b6b0-6f90300261de","name":"mart","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/.actions/run_scripts/report_daily_snapshot","id":"53bdf2c5-a157-11f1-b6b0-6f90300261de","folder_id":"d721f2b4-a139-11f1-b6b0-6f90300261de","name":"report_daily_snapshot","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"std/test\"\n#+import \"coginiti.co/foundation/retail/reports/reports_regular\"\n\n\n{{ publication.Run(\n\n  blocks=[reports_regular.DailySnapshot]\n  \n) }};\n\n\n{{ test.Run(\n\n  tests=[\n    reports_regular.Test_DailySnapshot_HasData,\n    reports_regular.Test_DailySnapshot_NoNullDates\n  ]\n  \n) }};\n","platform":null}},{"fqn":"/retail/base/sales/sales_header_test","id":"d7112a6a-a139-11f1-b6b0-6f90300261de","folder_id":"d7108e27-a139-11f1-b6b0-6f90300261de","name":"sales_header_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the sales header fact.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_SalesHeader_NoDuplicatesInTransactionID()\n#+meta {\n  :doc \"Fails if any transaction_id appears more than once, indicating a deduplication error in the sales header.\"\n}\n#+begin\n  SELECT  \n    transaction_id,\n    COUNT(*) AS cnt\n  FROM\n    {{ SalesHeader() }}\n  GROUP BY\n    transaction_id\n  HAVING\n    COUNT(*) > 1\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/sales","id":"d7160b8b-a139-11f1-b6b0-6f90300261de","folder_id":"d715e47a-a139-11f1-b6b0-6f90300261de","name":"sales","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"d8385cff-8448-11f1-a626-557cda040604"}}},{"fqn":"/retail/sources/stores","id":"d71d37a6-a139-11f1-b6b0-6f90300261de","folder_id":"d71b89ea-a139-11f1-b6b0-6f90300261de","name":"stores","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"\n#+src sql Stores()\n#+begin\n  SELECT\n    store_id,\n    store_name,\n    country_code_2,\n    continent_name,\n    open_date,\n    closing_date,\n    size_unit_of_measure_code,\n    selling_area_size,\n    size,\n    last_remodel_date,\n    email_address,\n    phone_number,\n    market_region_code,\n    market_region,\n    market_area_code,\n    market_area,\n    district_code,\n    district,\n    store_group_code,\n    store_group,\n    address_line_1,\n    address_line_2,\n    city,\n    postal_code,\n    inbound_channel_code,\n    SPLIT_PART(email_address, '@', 2) AS email_domain,\n    {{ NaturalKey(\"STORE^\", [\"store_id\"]) }} AS store_nk,\n    {{ NaturalKey(\"EMAIL^\", [\"email_address\"]) }} AS email_address_nk,\n    {{ NaturalKey(\"EML_DMN^\", [\"SPLIT_PART(email_address, '@', 2)\"]) }} AS email_domain_nk,\n    {{ NaturalKey(\"PHONE^\", [\"phone_number\"]) }} AS phone_number_nk,\n    {{ NaturalKey(\"MREGION^\", [\"market_region_code\"]) }} AS market_region_nk,\n    {{ NaturalKey(\"MAREA^\", [\"market_area_code\"]) }} AS market_area_nk,\n    {{ NaturalKey(\"DISTRICT^\", [\"district_code\"]) }} AS district_nk,\n    {{ NaturalKey(\"SGROUP^\", [\"store_group_code\"]) }} AS store_group_nk,\n    c.iso_2_code AS country_nk,\n    {{ NaturalKey(\"PADDR^\", [\"address_line_1\", \"address_line_2\", \"city\", \"postal_code\"]) }} AS postal_address_nk,\n    {{ NaturalKey(\"PCODE^\", [\"postal_code\"]) }} AS postal_code_nk,\n    {{ NaturalKey(\"IC^\", [\"inbound_channel_code\"]) }} AS inbound_channel_nk,\n    {{ RowHash([\n        \"store_id\",\n        \"store_name\",\n        \"country_code_2\",\n        \"continent_name\",\n        \"open_date\",\n        \"closing_date\",\n        \"size_unit_of_measure_code\",\n        \"selling_area_size\",\n        \"size\",\n        \"last_remodel_date\",\n        \"email_address\",\n        \"phone_number\",\n        \"market_region_code\",\n        \"market_region\",\n        \"market_area_code\",\n        \"market_area\",\n        \"district_code\",\n        \"district\",\n        \"store_group_code\",\n        \"store_group\",\n        \"address_line_1\",\n        \"address_line_2\",\n        \"city\",\n        \"postal_code\",\n        \"inbound_channel_code\"\n    ]) }} AS row_hash\n  FROM\n    landing.stores\n  LEFT JOIN {{ CountryPhoneCodes() }} c\n    ON LEFT(phone_number, LENGTH(c.phone_number_code)) = c.phone_number_code    \n  ;\n#+end\n\n#+src sql CountryPhoneCodes()\n#+begin\n  SELECT\n    iso_2_code,\n    phone_number_code,\n    phone_number_length\n  FROM\n    landing.country_phone_codes\n#+end\n\n","platform":null}},{"fqn":"/retail/mart/persona_derived_attributes","id":"d71e220c-a139-11f1-b6b0-6f90300261de","folder_id":"d71dacd9-a139-11f1-b6b0-6f90300261de","name":"persona_derived_attributes","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base/customer\"\n#+import \"coginiti.co/foundation/retail/derived_attributes\"\n\n#+src sql PersonaDerivedAttributes()\n#+meta {\n  :doc \"Stores derived attributes for the personas.\",\n  :publication {\n    :type \"table\",\n    :name \"persona_derived_attributes\",\n    :schema \"mart\"\n  }\n}\n#+begin\n  SELECT\n    p.persona_key,\n    rfm_values.first_order,\n    rfm_values.recent_order,\n    rfm_values.total_orders,\n    rfm_values.total_sales,\n    rfm_segments.rfm_recency,\n    rfm_segments.rfm_frequency,\n    rfm_segments.rfm_monetary,\n    rfm_segments.rfm_cell,\n    rfm_segments.rfm_segment\n  FROM\n    {{ customer.Persona() }} p\n  LEFT JOIN {{ derived_attributes.PersonaRFMValues() }} AS rfm_values\n    ON rfm_values.persona_key = p.persona_key\n  LEFT JOIN {{ derived_attributes.PersonaRFMSegments() }} AS rfm_segments\n    ON rfm_segments.persona_key = p.persona_key\n#+end","platform":null}},{"fqn":"/retail/run_full_refresh","id":"d71d85c8-a139-11f1-b6b0-6f90300261de","folder_id":"d70b5df0-a139-11f1-b6b0-6f90300261de","name":"run_full_refresh","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"std/test\"\n#+import \"coginiti.co/foundation/retail/landing\"\n#+import \"coginiti.co/foundation/retail/sources\"\n#+import \"coginiti.co/foundation/retail/base\"\n#+import \"coginiti.co/foundation/retail/base/location\"\n#+import \"coginiti.co/foundation/retail/base/touchpoint\"\n#+import \"coginiti.co/foundation/retail/base/customer\"\n#+import \"coginiti.co/foundation/retail/base/offering\"\n#+import \"coginiti.co/foundation/retail/base/datetime\"\n#+import \"coginiti.co/foundation/retail/base/sales\"\n#+import \"coginiti.co/foundation/retail/mart\"\n\n-- seed landing\n{{ publication.Run(packages=[landing]) }};\n\n-- run tests to verify source data\n{{ test.Run(\n  packages=[sources]\n) }};\n\n-- load base\n{{ publication.Run(\n  packages=[location, touchpoint, customer, offering, datetime, sales],\n  blocks=[base.Batch],\n  fullRefresh=true\n) }};\n\n{{ base.EndBatch() }};\n\n-- run tests to verify base consistency\n{{ test.Run(\n  packages=[location, touchpoint, customer, offering, datetime, sales]\n) }};\n\n-- publish mart in another batch\n{{ publication.Run(packages=[mart], fullRefresh=true) }};\n\n","platform":null}},{"fqn":"/retail/base/touchpoint/postal_address_test","id":"d713736a-a139-11f1-b6b0-6f90300261de","folder_id":"d71261f3-a139-11f1-b6b0-6f90300261de","name":"postal_address_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the postal address dimension.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_PostalAddress_NoDuplicatesInPK()\n#+meta {\n  :doc \"Fails if any postal_address_key appears more than once, indicating a surrogate key collision in the postal address dimension.\"\n}\n#+begin\n  SELECT\n    postal_address_key,\n    COUNT(*) AS cnt\n  FROM\n    {{ PostalAddress() }}\n  GROUP BY\n    postal_address_key\n  HAVING\n    COUNT(*) > 1\n#+end\n","platform":null}},{"fqn":"/retail/base/location/store_group","id":"d71213d1-a139-11f1-b6b0-6f90300261de","folder_id":"d711788c-a139-11f1-b6b0-6f90300261de","name":"store_group","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/sources\"\n#+import \"coginiti.co/foundation/retail/base\"\n\n#+src sql StoreGroup()\n#+meta {\n  :doc \"A dimensional type representing the fourth level of geographical grouping of stores within a District used for aggregating data.\",\n  :publication {\n    :type \"table\",\n    :name \"dim_store_group\",\n    :schema \"base\",\n    :primary_key [\"store_group_key\"],\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS store_group_key,\n    _t.store_group_code AS store_group_id,\n    _t.store_group AS store_group_name,\n    {{ base.SurrogateKey(\"_t.district_nk\") }} AS district_key,\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      store_group_nk AS natural_key,\n      store_group_code,\n      store_group,\n      district_nk,\n      ROW_NUMBER() OVER (PARTITION BY store_group_code ORDER BY store_group_code DESC, row_hash) AS row_num\n    FROM\n      {{ sources.Stores() }}\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/reports/store_ranking_report_test","id":"d717b946-a139-11f1-b6b0-6f90300261de","folder_id":"d716a7cf-a139-11f1-b6b0-6f90300261de","name":"store_ranking_report_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the store ranking report.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_StoreRankingReport_HasData()\n#+meta {\n  :doc \"Fails if the report returns no rows for the default 2022–2023 / top-10 parameters.\"\n}\n#+begin\n  SELECT\n    COUNT(*) AS row_count\n  FROM\n    {{ StoreRankingReport(2022, 2023, 10) }}\n  HAVING\n    COUNT(*) = 0\n#+end\n\n#+test sql Test_StoreRankingReport_UniqueRankPerRegion()\n#+meta {\n  :doc \"Fails if the same region_rank appears twice within a market region, indicating a\n        ranking or grouping error in WithStoreRanking().\"\n}\n#+begin\n  SELECT\n    market_region_name,\n    region_rank,\n    COUNT(*) AS duplicate_count\n  FROM\n    {{ StoreRankingReport(2022, 2023, 10) }}\n  GROUP BY\n    market_region_name,\n    region_rank\n  HAVING\n    COUNT(*) > 1\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_sql_reporting/channel_analysis","id":"d7152125-a139-11f1-b6b0-6f90300261de","folder_id":"d714d303-a139-11f1-b6b0-6f90300261de","name":"channel_analysis","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"e36486b5-3cb1-11f1-a457-d9456ae162d8"},"asset_type":"SQL","content":"-- Channel Mix Analysis\n-- Demonstrates: CTEs (WITH), UNION ALL with subquery wrapper, PERCENT_RANK() and CUME_DIST()\n--               window functions, SUM() OVER PARTITION BY, CASE WHEN division guard,\n--               HAVING with compound MEASURE() conditions, NOT LIKE filter,\n--               CONCAT_WS and UPPER string functions, fiscal calendar dimensions\n--\n-- Three-CTE pipeline: aggregates channel sales for fiscal years 2022–2023 (excluding test channels\n-- and zero-revenue rows), computes running cumulative sales and percentile ranking per year,\n-- then derives percentage shares using CASE WHEN to guard against zero denominators.\n-- Final output via UNION ALL combines per-channel detail rows for each fiscal year with a\n-- grand-total summary row, ordered by fiscal year then revenue descending.\n\nWITH channel_by_fiscal_year AS (\n\n  -- Aggregate by channel and fiscal year\n  SELECT\n    dd.fiscal_year                           AS fiscal_year,\n    ic.inbound_channel_code                  AS channel_code,\n    ic.inbound_channel_name                  AS channel_name,\n    MEASURE(sf.total_sales_amount)           AS gross_sales,\n    MEASURE(sf.unique_transactions)          AS transactions,\n    MEASURE(sf.total_quantity)               AS units_sold,\n    MEASURE(sf.avg_line_amount)              AS avg_basket,\n    MEASURE(sf.line_count)                   AS line_count\n  FROM \n    sale_return_fact AS sf\n  JOIN \n    inbound_channel_dimension AS ic\n  JOIN \n    date_dimension AS dd\n  WHERE\n    dd.fiscal_year IN (2022, 2023)\n    AND ic.inbound_channel_code NOT LIKE 'TEST%'\n  GROUP BY\n    dd.fiscal_year,\n    ic.inbound_channel_code,\n    ic.inbound_channel_name\n  HAVING\n    MEASURE(sf.total_sales_amount) > 0\n    AND MEASURE(sf.unique_transactions) >= 10\n\n), ranked AS (\n\n  -- Add window aggregates and ranking; materialise year_total to avoid repeated expressions\n  SELECT\n    fiscal_year,\n    channel_code,\n    channel_name,\n    gross_sales,\n    transactions,\n    units_sold,\n    avg_basket,\n    line_count,\n\n    -- Year total — used in the next CTE to compute shares without division guards inline\n    SUM(gross_sales) OVER (PARTITION BY fiscal_year) AS year_total,\n\n    -- Cumulative sales within fiscal year ordered by descending revenue\n    SUM(gross_sales) OVER (\n        PARTITION BY fiscal_year\n        ORDER BY gross_sales DESC\n        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n    ) AS cumulative_sales,\n\n    -- Percentile rank within fiscal year (0.0–1.0)\n    PERCENT_RANK() OVER (\n        PARTITION BY fiscal_year\n        ORDER BY gross_sales\n    ) AS percentile_rank,\n\n    -- Cumulative distribution (fraction of values ≤ current)\n    CUME_DIST() OVER (\n        PARTITION BY fiscal_year\n        ORDER BY gross_sales\n    ) AS cume_dist,\n\n    -- Human-readable channel label with code\n    CONCAT_WS(' — ', UPPER(channel_code), channel_name) AS channel_label\n\n  FROM \n    channel_by_fiscal_year\n\n), with_pct AS (\n\n  -- Compute percentage shares using CASE WHEN to guard against zero denominator\n  SELECT\n    fiscal_year,\n    channel_code,\n    channel_name,\n    channel_label,\n    gross_sales,\n    transactions,\n    units_sold,\n    avg_basket,\n    line_count,\n    percentile_rank,\n    cume_dist,\n\n    CASE\n        WHEN year_total = 0 THEN NULL\n        ELSE ROUND(gross_sales / year_total * 100, 2)\n    END AS pct_of_year_sales,\n\n    CASE\n        WHEN year_total = 0 THEN NULL\n        ELSE ROUND(cumulative_sales / year_total * 100, 2)\n    END AS cumulative_pct\n\n  FROM \n    ranked\n\n)\n\nSELECT\n  fiscal_year,\n  channel_code,\n  channel_label,\n  gross_sales,\n  transactions,\n  units_sold,\n  avg_basket,\n  pct_of_year_sales,\n  cumulative_pct,\n  percentile_rank,\n  cume_dist,\n  row_type\nFROM\n  (\n\n  -- Grand total row — one summary record per fiscal year\n  SELECT\n    fiscal_year,\n    'ALL' AS channel_code,\n    'All Channels' AS channel_label,\n    ROUND(SUM(gross_sales), 2)     AS gross_sales,\n    SUM(transactions)              AS transactions,\n    SUM(units_sold)                AS units_sold,\n    ROUND(AVG(avg_basket), 2)      AS avg_basket,\n    CAST('100.00' AS NUMERIC)      AS pct_of_year_sales,\n    CAST('100.00' AS NUMERIC)      AS cumulative_pct,\n    NULL AS percentile_rank,\n    NULL AS cume_dist,\n    'total' AS row_type\n  FROM \n    channel_by_fiscal_year\n  GROUP BY \n    fiscal_year\n\nUNION ALL\n\n  -- Fiscal year 2022 rows\n  SELECT\n    fiscal_year,\n    channel_code,\n    channel_label,\n    ROUND(gross_sales, 2) AS gross_sales,\n    transactions,\n    units_sold,\n    ROUND(avg_basket, 2) AS avg_basket,\n    pct_of_year_sales,\n    cumulative_pct,\n    ROUND(percentile_rank, 3) AS percentile_rank,\n    ROUND(cume_dist, 3) AS cume_dist,\n    'detail' AS row_type\n  FROM \n    with_pct\n  WHERE\n    fiscal_year = 2022\n\n  UNION ALL\n\n  -- Fiscal year 2023 rows\n  SELECT\n    fiscal_year,\n    channel_code,\n    channel_label,\n    ROUND(gross_sales, 2),\n    transactions,\n    units_sold,\n    ROUND(avg_basket, 2),\n    pct_of_year_sales,\n    cumulative_pct,\n    ROUND(percentile_rank, 3),\n    ROUND(cume_dist, 3),\n    'detail' AS row_type\n  FROM \n    with_pct\n  WHERE \n    fiscal_year = 2023\n\n) AS total\nORDER BY\n  fiscal_year  ASC,\n  row_type     DESC, -- 'total' sorts after 'detail'\n  gross_sales  DESC\n","platform":null}},{"fqn":"/retail/semantic_layer/channel/inbound_channel_dimension.smdl","id":"d720e13e-a139-11f1-b6b0-6f90300261de","folder_id":"d720ba2d-a139-11f1-b6b0-6f90300261de","name":"inbound_channel_dimension.smdl","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"b5c6f44b-8454-11f1-a626-557cda040604"},"asset_type":"SQL","content":"entity \"inbound_channel_dimension\" {\n  label       = \"Inbound Channel\"\n  description = \"Sales channel through which a transaction was placed. Available channels: Store (STR), Website (WEB), Mobile App (APP), Phone / Call Center (PCC).\"\n  table_name  = \"inbound_channel_dimension\"\n  schema_name = \"mart\"\n  synonyms    = [\"sales channel\", \"channel\", \"order channel\", \"purchase channel\"]\n\n  # --- Surrogate key (used in relationships) ---\n\n  dimension \"inbound_channel_key\" {\n    label    = \"Channel Key\"\n    type     = \"text\"\n    expr     = \"inbound_channel_key\"\n    synonyms = [\"channel key\", \"channel id\", \"channel identifier\"]\n  }\n\n  # --- Descriptive dimensions ---\n\n  dimension \"inbound_channel_code\" {\n    label       = \"Channel Code\"\n    description = \"Short code identifying the channel (STR, WEB, APP, PCC).\"\n    type        = \"text\"\n    expr        = \"inbound_channel_code\"\n    synonyms    = [\"channel code\", \"channel abbreviation\", \"channel type code\"]\n  }\n\n  dimension \"inbound_channel_name\" {\n    label       = \"Channel Name\"\n    description = \"Human-readable sales channel name.\"\n    type        = \"text\"\n    expr        = \"inbound_channel_name\"\n    synonyms    = [\"channel name\", \"channel\", \"sales channel\", \"channel description\"]\n  }\n}\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_sql_reporting/sales_trends","id":"d7159658-a139-11f1-b6b0-6f90300261de","folder_id":"d714d303-a139-11f1-b6b0-6f90300261de","name":"sales_trends","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"e36486b4-3cb1-11f1-a457-d9456ae162d8"},"asset_type":"SQL","content":"-- Sales Trends with Time Intelligence\n-- Demonstrates: LAG() navigation function, running SUM() OVER window, YTD SUM() OVER PARTITION BY,\n--               AVG() OVER sliding window frame, ROWS BETWEEN frame specification, CASE WHEN, ROUND\n--\n-- Produces a monthly time series of sales with running totals, 3-month moving average,\n-- month-over-month change, and year-over-year comparison.\n\nWITH monthly_sales AS (\n\n    -- Monthly aggregation: one row per (year, month)\n  SELECT\n    dd.calendar_year,\n    dd.calendar_month,\n    MEASURE(sf.total_sales_amount)           AS gross_sales,\n    MEASURE(sf.unique_transactions)          AS transactions,\n    MEASURE(sf.total_quantity)               AS units_sold\n  FROM \n    sale_return_fact AS sf\n  JOIN \n    date_dimension AS dd\n  WHERE\n    dd.calendar_year >= 2021\n    AND dd.calendar_holiday_flag IS NOT TRUE\n  GROUP BY\n    dd.calendar_year,\n    dd.calendar_month\n\n), trends AS (\n\n  SELECT\n      calendar_year,\n      calendar_month,\n      gross_sales,\n      transactions,\n      units_sold,\n\n      -- Running cumulative total from the beginning of the dataset\n      SUM(gross_sales) OVER (\n          ORDER BY calendar_year, calendar_month\n          ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n      ) AS running_total_sales,\n\n      -- Year-to-date total (resets each calendar year)\n      SUM(gross_sales) OVER (\n          PARTITION BY calendar_year\n          ORDER BY calendar_month\n          ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n      ) AS ytd_sales,\n\n      -- 3-month centred moving average (1 preceding + current + 1 following)\n      AVG(gross_sales) OVER (\n          ORDER BY calendar_year, calendar_month\n          ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING\n      ) AS ma3_sales,\n\n      -- Previous month's sales (LAG with default 0 for the first row)\n      LAG(gross_sales, 1, 0) OVER (\n          ORDER BY calendar_year, calendar_month\n      ) AS prev_month_sales\n\n  FROM \n    monthly_sales\n\n)\n\nSELECT\n  calendar_year,\n  calendar_month,\n\n  -- Derive quarter from month (no date function needed)\n  CASE\n      WHEN calendar_month <= 3  THEN 1\n      WHEN calendar_month <= 6  THEN 2\n      WHEN calendar_month <= 9  THEN 3\n      ELSE 4\n  END AS calendar_quarter,\n\n  ROUND(gross_sales, 2)                                AS gross_sales,\n  ROUND(running_total_sales, 2)                        AS running_total,\n  ROUND(ytd_sales, 2)                                  AS ytd_sales,\n  ROUND(ma3_sales, 2)                                  AS ma3_sales,\n  ROUND(prev_month_sales, 2)                           AS prev_month_sales,\n  transactions,\n  units_sold\n\nFROM \n  trends\nORDER BY\n  calendar_year ASC,\n  calendar_month ASC\n","platform":null}},{"fqn":"/retail/.actions/run_scripts/landing","id":"d723524e-a139-11f1-b6b0-6f90300261de","folder_id":"d721f2b4-a139-11f1-b6b0-6f90300261de","name":"landing","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"std/test\"\n#+import \"coginiti.co/foundation/retail/landing\"\n#+import \"coginiti.co/foundation/retail/sources\"\n\n\n{{ publication.Run(\n\n  packages=[landing]\n\n) }};\n\n\n{{ test.Run(\n\n  packages=[sources]\n  \n) }};","platform":null}},{"fqn":"/retail/semantic_layer/location","id":"d71f5a94-a139-11f1-b6b0-6f90300261de","folder_id":"d71f3383-a139-11f1-b6b0-6f90300261de","name":"location","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"2a59a0fc-3cff-11f1-a457-d9456ae162d8"}}},{"fqn":"/retail/reports/reports_regular/store_rankings_test","id":"d7198e0f-a139-11f1-b6b0-6f90300261de","folder_id":"8f049129-a151-11f1-b6b0-6f90300261de","name":"store_rankings_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"f7d12d24-845a-11f1-a626-557cda040604"},"asset_type":"CSL","content":"-- Store Rankings — Test Suite\n-- Goal: Validate the StoreRankings() report output before it is consumed by downstream\n--       dashboards or incentive pipelines. Ranking data feeds store-level bonuses and\n--       operational reviews, so correctness is business-critical — errors here have\n--       direct financial and reputational impact.\n--\n-- Tests included:\n--   1. Test_StoreRankings_HasData      – Fails if the rankings report returns zero rows.\n--                                        Guards against parameter combinations that produce\n--                                        no results (e.g. a date window with no transactions,\n--                                        or $top_n = 0). An empty ranking table would cause\n--                                        silent data gaps in dashboards.\n--\n--   2. Test_StoreRankings_UniqueRanks  – Fails if any store_rank value appears more than once.\n--                                        Because RANK() can produce ties, this test catches\n--                                        the case where two stores share a rank but are\n--                                        expected to be distinct in the output (e.g. when\n--                                        downstream consumers assume a strict 1-per-rank\n--                                        structure). If ties are intentional, this test\n--                                        should be disabled or adapted with a note.\n--\n-- Each test returns rows only on failure (HAVING filters out the success state),\n-- so a passing run produces an empty result set.\n\n#+test sql Test_StoreRankings_HasData()\n#+meta {\n  :doc \"Verifies that the store rankings contains data\"\n}\n#+begin\n  SELECT\n    COUNT(*) AS row_count\n  FROM\n    {{ StoreRankings() }}\n  HAVING\n    COUNT(*) = 0\n  ;\n#+end\n\n\n#+test sql Test_StoreRankings_UniqueRanks()\n#+meta {\n  :doc \"Verifies that store ranks are unique (no duplicates)\"\n}\n#+begin\n  -- Groups by store_rank and surfaces any value that appears more than once.\n  -- A non-empty result means tied stores exist; investigate whether the ranking\n  -- metric has sufficient cardinality or whether a tie-breaking column is needed.\n  SELECT\n    store_id,\n    store_rank,\n    COUNT(*) AS duplicate_count\n  FROM\n    {{ StoreRankings() }}\n  GROUP BY\n    store_id,\n    store_rank\n  HAVING\n    COUNT(*) > 1\n  ;\n#+end\n","platform":null}},{"fqn":"/retail/project.toml","id":"d723c780-a139-11f1-b6b0-6f90300261de","folder_id":"d70b5df0-a139-11f1-b6b0-6f90300261de","name":"project.toml","entity_type":"project_manifest","entity_version":"DT257D7ax2bSoa9k/FTiUUd7P8JsIvK8RCFsNV7UAAs=","data":{"copied_from_id":null,"asset_type":"PROJECT_MANIFEST","content":"[general]\nname = 'coginiti.co/foundation/retail'\ndescription = 'Retail Foundation implements data transformation for base and mart layers of the retail model.'\nversion = '1.0.0'\n\n[environment]\ndefault = \"prod\"\n\n[environment.prod]\nname = \"Production\"\nconnection = { name=\"coginiti_retail_demo\", overrides = { database=\"retail_csl\" } }\n\n\n# Semantic Layer Project Configuration\n# Defines named semantic model sets that map to entity definition paths.\n\n[semantic]\ndefault = \"all\"\n\n[semantic.all]\nname        = \"Retail Analytics\"\npath        = \"semantic_layer\"\nenvironment = \"prod\"\n\n[semantic.sales]\nname        = \"Sales Domain\"\npath        = \"semantic_layer/sales\"\nenvironment = \"prod\"\n\n[semantic.customers]\nname        = \"Customer Domain\"\npath        = \"semantic_layer/customer\"\nenvironment = \"prod\"\n"}},{"fqn":"/retail/run_full_refresh_ai","id":"d71f0c72-a139-11f1-b6b0-6f90300261de","folder_id":"d70b5df0-a139-11f1-b6b0-6f90300261de","name":"run_full_refresh_ai","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"std/test\"\n#+import \"coginiti.co/foundation/retail/landing\"\n#+import \"coginiti.co/foundation/retail/landing_ai\"\n#+import \"coginiti.co/foundation/retail/sources\"\n#+import \"coginiti.co/foundation/retail/base\"\n#+import \"coginiti.co/foundation/retail/base/location\"\n#+import \"coginiti.co/foundation/retail/base/touchpoint\"\n#+import \"coginiti.co/foundation/retail/base/customer\"\n#+import \"coginiti.co/foundation/retail/base/offering\"\n#+import \"coginiti.co/foundation/retail/base/datetime\"\n#+import \"coginiti.co/foundation/retail/base/sales\"\n#+import \"coginiti.co/foundation/retail/mart\"\n\n-- Full refresh using AI-generated landing data.\n-- Use this instead of run_full_refresh when an AI Assistant connection is available.\n-- LLM blocks produce realistic names, addresses, products and reviews\n-- instead of the procedurally generated data in the standard landing package.\n\n-- seed landing: publish static reference and transactional tables first,\n-- then overwrite products / customers / stores with AI-generated versions\n-- and add the new product_reviews table\n{{ \n  publication.Run(blocks=\n  [\n    landing.Countries,\n    landing.CountryPhoneCodes,\n    landing.InboundChannel,\n    landing.Date,\n    landing.Sales\n  ]\n) \n}};\n\n{{ publication.Run(packages=[landing_ai]) }};\n\n-- run tests to verify source data\n{{ test.Run(\n  packages=[sources]\n) }};\n\n-- load base\n{{ publication.Run(\n  packages=[location, touchpoint, customer, offering, datetime, sales],\n  blocks=[base.Batch],\n  fullRefresh=true\n) }};\n\n{{ base.EndBatch() }};\n\n-- run tests to verify base consistency\n{{ test.Run(\n  packages=[location, touchpoint, customer, offering, datetime, sales]\n) }};\n\n-- publish mart in another batch\n{{ publication.Run(packages=[mart], fullRefresh=true) }};\n","platform":null}},{"fqn":"/retail/mart/persona_dimension","id":"d71e491d-a139-11f1-b6b0-6f90300261de","folder_id":"d71dacd9-a139-11f1-b6b0-6f90300261de","name":"persona_dimension","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base/touchpoint\"\n#+import \"coginiti.co/foundation/retail/base/customer\"\n\n#+src sql PersonaDimension()\n#+meta {\n  :doc \"This dimension stores the customer as it is known to a source system.\",\n  :publication {\n    :type \"table\",\n    :name \"persona_dimension\",\n    :schema \"mart\"\n  }\n}\n#+begin\n  SELECT\n    p.persona_key,\n    p.customer_id,\n    p.first_name,\n    p.last_name,\n    p.postal_address_key AS primary_postal_address_key,\n    e.email_address AS primary_email_address,\n    pn.complete_number AS primary_complete_phone_number\n  FROM\n    {{ customer.Persona() }} p\n  INNER JOIN {{ touchpoint.EmailAddress() }} e\n    ON e.email_address_key = p.email_address_key\n  INNER JOIN {{ touchpoint.PhoneNumber() }} pn\n    ON pn.phone_number_key = p.phone_number_key\n#+end\n","platform":null}},{"fqn":"/retail/base/touchpoint/postal_code_test","id":"d712d726-a139-11f1-b6b0-6f90300261de","folder_id":"d71261f3-a139-11f1-b6b0-6f90300261de","name":"postal_code_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the postal code dimension.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_PostalCode_NoDuplicatesInPK()\n#+meta {\n  :doc \"Fails if any postal_code_key appears more than once, indicating a surrogate key collision in the postal code dimension.\"\n}\n#+begin\n  SELECT  \n    postal_code_key,\n    COUNT(*) AS cnt\n  FROM    \n    {{ PostalCode() }}\n  GROUP BY\n    postal_code_key\n  HAVING\n    COUNT(*) > 1\n#+end\n","platform":null}},{"fqn":"/retail/semantic_layer/customer/persona_derived_attributes.smdl","id":"d7206c0b-a139-11f1-b6b0-6f90300261de","folder_id":"d72044fa-a139-11f1-b6b0-6f90300261de","name":"persona_derived_attributes.smdl","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"db00adc0-8454-11f1-a626-557cda040604"},"asset_type":"SQL","content":"# This entity demonstrates the `query` style of entity definition.\n# Use `query` instead of `table_name` when you need to:\n#   - Expose only a subset of columns from a physical table\n#   - Apply a fixed filter at the model level\n#   - Join or transform source tables before exposing them as dimensions\n\nentity \"persona_derived_attributes\" {\n  label       = \"Customer RFM Segment\"\n  description = \"RFM (Recency, Frequency, Monetary) segmentation attributes per customer. Scores are calculated as quintiles (1–5) across the full customer base. Uses a custom query to expose only the relevant segmentation columns.\"\n  synonyms    = [\"rfm segment\", \"customer segment\", \"customer scoring\", \"rfm attributes\", \"customer lifetime value\"]\n\n  query = <<-EOF\n    SELECT\n        persona_key,\n        rfm_segment,\n        rfm_cell,\n        rfm_recency,\n        rfm_frequency,\n        rfm_monetary,\n        total_orders,\n        total_sales,\n        first_order,\n        recent_order\n    FROM mart.persona_derived_attributes\n  EOF\n\n  # --- Surrogate key (used in relationships) ---\n\n  dimension \"persona_key\" {\n    label    = \"Persona Key\"\n    type     = \"text\"\n    expr     = \"persona_key\"\n    synonyms = [\"customer key\", \"client key\", \"persona surrogate key\", \"shopper key\"]\n  }\n\n  # --- Segmentation dimensions ---\n\n  dimension \"rfm_segment\" {\n    label       = \"RFM Segment\"\n    description = \"Named customer segment derived from the RFM cell code. Possible values: Active fans, Cannot lose, Promising newbies, Potential churners, Other.\"\n    type        = \"text\"\n    expr        = \"rfm_segment\"\n    synonyms    = [\"customer segment\", \"segment\", \"customer group\", \"customer tier\", \"rfm category\"]\n  }\n\n  dimension \"rfm_cell\" {\n    label       = \"RFM Cell\"\n    description = \"Three-digit RFM score code. Each digit is a quintile (1 = lowest, 5 = highest) for Recency, Frequency, and Monetary value respectively.\"\n    type        = \"text\"\n    expr        = \"rfm_cell\"\n    synonyms    = [\"rfm code\", \"rfm score code\", \"rfm bucket\", \"scoring cell\"]\n  }\n\n  dimension \"rfm_recency\" {\n    label       = \"Recency Score\"\n    description = \"Recency quintile. 5 = purchased most recently, 1 = purchased least recently.\"\n    type        = \"integer\"\n    expr        = \"rfm_recency\"\n    synonyms    = [\"recency\", \"recency score\", \"recency quintile\", \"days since last purchase score\"]\n  }\n\n  dimension \"rfm_frequency\" {\n    label       = \"Frequency Score\"\n    description = \"Frequency quintile. 5 = most frequent buyer, 1 = least frequent buyer.\"\n    type        = \"integer\"\n    expr        = \"rfm_frequency\"\n    synonyms    = [\"frequency\", \"frequency score\", \"purchase frequency score\", \"order frequency quintile\"]\n  }\n\n  dimension \"rfm_monetary\" {\n    label       = \"Monetary Score\"\n    description = \"Monetary value quintile. 5 = highest lifetime spend, 1 = lowest lifetime spend.\"\n    type        = \"integer\"\n    expr        = \"rfm_monetary\"\n    synonyms    = [\"monetary score\", \"spend score\", \"value score\", \"monetary quintile\", \"lifetime value score\"]\n  }\n\n  # --- Lifetime value dimensions ---\n\n  dimension \"total_orders\" {\n    label       = \"Total Orders\"\n    description = \"Lifetime total number of orders placed by the customer.\"\n    type        = \"integer\"\n    expr        = \"total_orders\"\n    synonyms    = [\"lifetime orders\", \"order count\", \"number of orders\", \"total purchases\", \"purchase count\"]\n  }\n\n  dimension \"first_order\" {\n    label       = \"First Order Date\"\n    description = \"Date of the customer's first-ever purchase.\"\n    type        = \"date\"\n    expr        = \"first_order\"\n    synonyms    = [\"first purchase date\", \"acquisition date\", \"first buy date\", \"customer since\"]\n  }\n\n  dimension \"recent_order\" {\n    label       = \"Most Recent Order Date\"\n    description = \"Date of the customer's most recent purchase.\"\n    type        = \"date\"\n    expr        = \"recent_order\"\n    synonyms    = [\"last order date\", \"last purchase date\", \"most recent purchase\", \"latest order date\"]\n  }\n\n  # --- Measures — demonstrates all available aggregation types ---\n\n  measure \"customer_count\" {\n    label            = \"Customer Count\"\n    description      = \"Number of distinct customers in the group.\"\n    type             = \"number\"\n    aggregation_type = \"count_distinct\"\n    expr             = \"persona_key\"\n    synonyms         = [\"number of customers\", \"distinct customers\", \"total customers\", \"client count\"]\n  }\n\n  measure \"total_customers\" {\n    label            = \"Total Rows\"\n    description      = \"Total count of rows — useful for verifying row-level granularity.\"\n    type             = \"number\"\n    aggregation_type = \"count\"\n    expr             = \"persona_key\"\n    synonyms         = [\"row count\", \"total records\", \"record count\", \"total rows\"]\n  }\n\n  measure \"sum_lifetime_sales\" {\n    label            = \"Sum Lifetime Sales\"\n    description      = \"Combined lifetime sales across all customers in scope.\"\n    type             = \"decimal\"\n    aggregation_type = \"sum\"\n    expr             = \"total_sales\"\n    synonyms         = [\"total lifetime revenue\", \"lifetime sales\", \"total lifetime spend\", \"cumulative sales\"]\n  }\n\n  measure \"avg_lifetime_sales\" {\n    label            = \"Avg Lifetime Sales\"\n    description      = \"Average lifetime gross sales per customer.\"\n    type             = \"decimal\"\n    aggregation_type = \"avg\"\n    expr             = \"total_sales\"\n    synonyms         = [\"average lifetime spend\", \"avg customer value\", \"mean lifetime sales\", \"average revenue per customer\"]\n  }\n\n  measure \"max_lifetime_sales\" {\n    label            = \"Max Lifetime Sales\"\n    description      = \"Highest lifetime sales amount observed in the customer group.\"\n    type             = \"decimal\"\n    aggregation_type = \"max\"\n    expr             = \"total_sales\"\n    synonyms         = [\"highest lifetime spend\", \"top customer value\", \"maximum lifetime sales\", \"best customer spend\"]\n  }\n\n  measure \"min_lifetime_sales\" {\n    label            = \"Min Lifetime Sales\"\n    description      = \"Lowest lifetime sales amount observed in the customer group.\"\n    type             = \"decimal\"\n    aggregation_type = \"min\"\n    expr             = \"total_sales\"\n    synonyms         = [\"lowest lifetime spend\", \"minimum lifetime sales\", \"smallest customer value\", \"least customer spend\"]\n  }\n\n  measure \"avg_order_frequency\" {\n    label            = \"Avg Order Frequency\"\n    description      = \"Average number of lifetime orders per customer in scope.\"\n    type             = \"number\"\n    aggregation_type = \"avg\"\n    expr             = \"total_orders\"\n    synonyms         = [\"average purchase frequency\", \"mean order count\", \"avg orders per customer\", \"average number of orders\"]\n  }\n}\n","platform":null}},{"fqn":"/retail/base/location/market_region","id":"d711788d-a139-11f1-b6b0-6f90300261de","folder_id":"d711788c-a139-11f1-b6b0-6f90300261de","name":"market_region","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/sources\"\n#+import \"coginiti.co/foundation/retail/base\"\n\n#+src sql MarketRegion()\n#+meta {\n  :doc \"A dimensional type representing the largest geographical grouping of store locations used for aggregating data.\",\n  :publication {\n    :type \"table\",\n    :name \"dim_market_region\",\n    :schema \"base\",\n    :primary_key [\"market_region_key\"],\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS market_region_key,\n    _t.market_region_code AS market_region_id,\n    _t.market_region AS market_region_name,\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      market_region_nk AS natural_key,\n      market_region_code,\n      market_region,\n      ROW_NUMBER() OVER (PARTITION BY market_region_code ORDER BY market_region_code DESC, row_hash) AS row_num\n    FROM\n      {{ sources.Stores() }}\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/.actions/run_scripts/mart","id":"d722b609-a139-11f1-b6b0-6f90300261de","folder_id":"d721f2b4-a139-11f1-b6b0-6f90300261de","name":"mart","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/mart\"\n\n\n{{ publication.Run(\n\n  packages=[mart]\n\n) }};","platform":null}},{"fqn":"/retail/reports/reports_regular/daily_snapshot_test","id":"d719dc31-a139-11f1-b6b0-6f90300261de","folder_id":"8f049129-a151-11f1-b6b0-6f90300261de","name":"daily_snapshot_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"cd99d551-845a-11f1-a626-557cda040604"},"asset_type":"CSL","content":"-- Daily Snapshot — Test Suite\n-- Goal: Validate the DailySnapshot() report output before it is consumed downstream.\n--       Tests are intentionally lightweight — they detect the most common failure modes\n--       (empty result, missing date values) without re-implementing business logic.\n--\n-- Tests included:\n--   1. Test_DailySnapshot_HasData       – Fails if the snapshot returns zero rows.\n--                                         Guards against misconfigured parameters\n--                                         (e.g. a snapshot_date with no sales data).\n--   2. Test_DailySnapshot_NoNullDates   – Fails if any row has a NULL snapshot_date\n--                                         or sale_date. Both fields are required for\n--                                         the output to be usable by downstream dashboards.\n--\n-- Each test returns rows only on failure (HAVING / WHERE filters out the success state),\n-- so a passing run produces an empty result set.\n\n#+test sql Test_DailySnapshot_HasData()\n#+meta {\n  :doc \"Verifies that the daily snapshot contains data\"\n}\n#+begin\n  SELECT\n    COUNT(*) AS row_count\n  FROM\n    {{ DailySnapshot() }}\n  HAVING\n    COUNT(*) = 0\n  ;\n#+end;\n\n\n#+test sql Test_DailySnapshot_NoNullDates()\n#+meta {\n  :doc \"Verifies that all date fields are populated\"\n}\n#+begin\n  SELECT\n    snapshot_date,\n    sale_date\n  FROM\n    {{ DailySnapshot() }}\n  WHERE\n    snapshot_date IS NULL\n    OR sale_date IS NULL\n  ;\n#+end;\n","platform":null}},{"fqn":"/retail/mart/inbound_channel_dimension","id":"d71dd3ea-a139-11f1-b6b0-6f90300261de","folder_id":"d71dacd9-a139-11f1-b6b0-6f90300261de","name":"inbound_channel_dimension","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base/location\"\n\n#+src sql InboundChannelDimension()\n#+meta {\n  :doc \"A dimension representing the channel through which interactions may occur. For example store, web, call center, mobile app.\",\n  :publication {\n    :type \"table\",\n    :name \"inbound_channel_dimension\",\n    :schema \"mart\"\n  }\n}\n#+begin\n  SELECT\n    i.inbound_channel_key,\n    i.inbound_channel_code,\n    i.inbound_channel_name\n  FROM\n    {{ location.InboundChannel() }} i\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/reports","id":"d716a7cf-a139-11f1-b6b0-6f90300261de","folder_id":"d715e47a-a139-11f1-b6b0-6f90300261de","name":"reports","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"d33fa0ac-8448-11f1-a626-557cda040604"}}},{"fqn":"/retail/reports/reports_semantic/semantic_sql_reporting/sales_overview","id":"d7156f47-a139-11f1-b6b0-6f90300261de","folder_id":"d714d303-a139-11f1-b6b0-6f90300261de","name":"sales_overview","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"e36486b3-3cb1-11f1-a457-d9456ae162d8"},"asset_type":"SQL","content":"-- Sales Overview\n-- Demonstrates: SELECT with MEASURE(), implicit JOIN, GROUP BY, ORDER BY, LIMIT\n--\n-- Returns monthly sales totals with key KPIs for the most recent full calendar year.\n-- Uses an implicit JOIN to date_dimension via the relationship defined on sale_return_fact.\n\nSELECT\n  dd.calendar_year,\n  dd.calendar_month,\n  dd.calendar_quarter,\n  MEASURE(srf.total_quantity)      AS units_sold,\n  MEASURE(srf.total_sales_amount)  AS gross_sales,\n  MEASURE(srf.unique_transactions) AS transactions,\n  MEASURE(srf.avg_line_amount)     AS avg_line_value\nFROM \n  sale_return_fact AS srf\nJOIN \n  date_dimension AS dd\nWHERE \n  dd.calendar_year = 2023\nGROUP BY\n  dd.calendar_year,\n  dd.calendar_month,\n  dd.calendar_quarter\nORDER BY\n  dd.calendar_year ASC,\n  dd.calendar_month ASC\n","platform":null}},{"fqn":"/retail","id":"d70b5df0-a139-11f1-b6b0-6f90300261de","folder_id":"bb6de4af-1aad-493e-a9ee-b3e75cf58ed7","name":"retail","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"PROJECT","copied_from_id":null}},{"fqn":"/retail/semantic_layer/time/date_dimension.smdl","id":"d7201de9-a139-11f1-b6b0-6f90300261de","folder_id":"d71ff6d8-a139-11f1-b6b0-6f90300261de","name":"date_dimension.smdl","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"812d39ab-8454-11f1-a626-557cda040604"},"asset_type":"SQL","content":"entity \"date_dimension\" {\n  label       = \"Date\"\n  description = \"Calendar and fiscal date attributes. Each row represents one business day. Supports dual-calendar analysis with a fiscal calendar offset of +3 months relative to the standard calendar.\"\n  table_name  = \"date_dimension\"\n  schema_name = \"mart\"\n  synonyms    = [\"date\", \"calendar\", \"time\", \"day\"]\n\n  # --- Surrogate key (used in relationships) ---\n\n  dimension \"date_key\" {\n    label    = \"Date Key\"\n    type     = \"text\"\n    expr     = \"date_key\"\n    synonyms = [\"date key\", \"day key\", \"date surrogate key\"]\n  }\n\n  # --- Calendar dimensions ---\n\n  dimension \"business_day_date\" {\n    label       = \"Date\"\n    description = \"Full calendar date of the business day.\"\n    type        = \"date\"\n    expr        = \"business_day_date\"\n    synonyms    = [\"date\", \"business date\", \"calendar date\", \"day\"]\n  }\n\n  dimension \"calendar_year\" {\n    label       = \"Calendar Year\"\n    description = \"Four-digit calendar year (e.g., 2023).\"\n    type        = \"integer\"\n    expr        = \"calendar_year\"\n    synonyms    = [\"year\", \"cal year\", \"annual period\", \"reporting year\"]\n  }\n\n  dimension \"calendar_quarter\" {\n    label       = \"Calendar Quarter\"\n    description = \"Quarter number within the calendar year (1–4).\"\n    type        = \"integer\"\n    expr        = \"calendar_quarter\"\n    synonyms    = [\"quarter\", \"cal quarter\", \"quarterly period\", \"Q\"]\n  }\n\n  dimension \"calendar_month\" {\n    label       = \"Calendar Month\"\n    description = \"Month number within the calendar year (1–12).\"\n    type        = \"integer\"\n    expr        = \"calendar_month\"\n    synonyms    = [\"month\", \"cal month\", \"monthly period\", \"month number\"]\n  }\n\n  dimension \"calendar_week\" {\n    label       = \"Calendar Week\"\n    description = \"ISO week number within the calendar year (1–53).\"\n    type        = \"integer\"\n    expr        = \"calendar_week\"\n    synonyms    = [\"week\", \"week number\", \"iso week\", \"cal week\"]\n  }\n\n  dimension \"calendar_week_day\" {\n    label       = \"Day of Week\"\n    description = \"Day of the week (1 = Monday, 7 = Sunday).\"\n    type        = \"integer\"\n    expr        = \"calendar_week_day\"\n    synonyms    = [\"weekday\", \"day of week\", \"day number\", \"weekday number\"]\n  }\n\n  dimension \"calendar_holiday_flag\" {\n    label       = \"Public Holiday\"\n    description = \"True if the date is a designated public calendar holiday.\"\n    type        = \"bool\"\n    expr        = \"calendar_holiday_flag\"\n    synonyms    = [\"holiday\", \"public holiday\", \"bank holiday\", \"is holiday\"]\n  }\n\n  # --- Fiscal calendar dimensions ---\n\n  dimension \"fiscal_year\" {\n    label       = \"Fiscal Year\"\n    description = \"Fiscal year number. The fiscal calendar is offset +3 months from the standard calendar.\"\n    type        = \"integer\"\n    expr        = \"fiscal_year\"\n    synonyms    = [\"fiscal year\", \"financial year\", \"FY\", \"budget year\"]\n  }\n\n  dimension \"fiscal_quarter\" {\n    label       = \"Fiscal Quarter\"\n    description = \"Quarter number within the fiscal year (1–4).\"\n    type        = \"integer\"\n    expr        = \"fiscal_quarter\"\n    synonyms    = [\"fiscal quarter\", \"financial quarter\", \"FQ\", \"budget quarter\"]\n  }\n\n  dimension \"fiscal_period\" {\n    label       = \"Fiscal Period\"\n    description = \"Period (month) number within the fiscal year (1–12).\"\n    type        = \"integer\"\n    expr        = \"fiscal_period\"\n    synonyms    = [\"fiscal month\", \"financial period\", \"accounting period\", \"fiscal month number\"]\n  }\n\n  dimension \"fiscal_week\" {\n    label       = \"Fiscal Week\"\n    description = \"Week number within the fiscal year.\"\n    type        = \"integer\"\n    expr        = \"fiscal_week\"\n    synonyms    = [\"fiscal week\", \"financial week\", \"FW\", \"budget week\"]\n  }\n\n  dimension \"fiscal_week_day\" {\n    label       = \"Fiscal Day of Week\"\n    description = \"Day of the week within the fiscal calendar (1–7).\"\n    type        = \"integer\"\n    expr        = \"fiscal_week_day\"\n    synonyms    = [\"fiscal weekday\", \"financial day of week\", \"fiscal day number\"]\n  }\n\n  dimension \"fiscal_holiday_flag\" {\n    label       = \"Fiscal Holiday\"\n    description = \"True if the date is designated as a fiscal holiday.\"\n    type        = \"bool\"\n    expr        = \"fiscal_holiday_flag\"\n    synonyms    = [\"fiscal holiday\", \"financial holiday\", \"is fiscal holiday\", \"accounting holiday\"]\n  }\n\n  # --- Inverse relationship: one date → many sales lines ---\n\n  relationship \"date_to_sales\" {\n    label = \"Sales Lines\"\n    type  = \"one_to_many\"\n    expr  = \"date_dimension.date_key = sale_return_fact.transaction_date_key\"\n  }\n}\n","platform":null}},{"fqn":"/retail/semantic_layer/time","id":"d71ff6d8-a139-11f1-b6b0-6f90300261de","folder_id":"d71f3383-a139-11f1-b6b0-6f90300261de","name":"time","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"2a59a0f5-3cff-11f1-a457-d9456ae162d8"}}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/reports/product_performance_report","id":"11c0bc9a-a152-11f1-b6b0-6f90300261de","folder_id":"d716a7cf-a139-11f1-b6b0-6f90300261de","name":"product_performance_report","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/reports/reports_semantic/semantic_csl_reporting/product\"\n\n-- Product Performance Report\n-- Demonstrates: ranking window functions and a post-aggregation filter (the semantic-SQL\n--               equivalent of HAVING once the aggregation already happened one block down)\n--               layered on top of product.AnnualProductPerformance().\n\n#+src sql ProductPerformanceReport(year, minUnits)\n#+meta {\n  :doc \"Products ranked by annual revenue, restricted to products that sold at least $minUnits\n        units.\n        $Parameters:\n          - $year: calendar year to evaluate\n          - $minUnits: minimum units sold to be included\"\n}\n#+begin\n  SELECT\n    item_name,\n    units_sold,\n    ROUND(gross_sales, 2)     AS gross_sales,\n    transactions,\n    ROUND(avg_line_value, 2)  AS avg_line_value,\n    ROW_NUMBER() OVER (ORDER BY gross_sales DESC) AS sales_rank,\n    RANK()       OVER (ORDER BY gross_sales DESC) AS sales_rank_with_gaps,\n    NTILE(4)     OVER (ORDER BY gross_sales DESC) AS sales_quartile\n  FROM\n    {{ product.AnnualProductPerformance(year) }}\n  WHERE\n    units_sold >= {{ minUnits }}\n  ORDER BY\n    gross_sales DESC\n#+end\n\n-- Runnable example\nSELECT * FROM {{ ProductPerformanceReport(2023, 100) }};\n","platform":null}},{"fqn":"/retail/sources/phone_number_country_code","id":"d71d1095-a139-11f1-b6b0-6f90300261de","folder_id":"d71b89ea-a139-11f1-b6b0-6f90300261de","name":"phone_number_country_code","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+src sql PhoneNumberCountryCode()\n#+begin\n  SELECT \n    phone_code,\n    char_length(phone_code) as phone_code_length,\n    country_code_2chars    \n  FROM (VALUES  \n    ('1', 'US'),   -- USA/Canada\n    ('49', 'DE'),  -- Germany\n    ('44', 'GB'),  -- United Kingdoms\n    ('32', 'BE'),  -- Belgium\n    ('41', 'CH'),  -- switz\n    ('353', 'IE'), -- Ireland\n    ('31', 'NL'),  -- Netherlands\n    ('65', 'SG'),  -- Singapore\n    ('60', 'MY'),  -- Malaysia\n    ('81', 'JP')   -- Japan\n  ) AS codes(phone_code, country_code_2chars)  \n#+end\n","platform":null}},{"fqn":"/retail/.actions/run_scripts/base","id":"d72267e7-a139-11f1-b6b0-6f90300261de","folder_id":"d721f2b4-a139-11f1-b6b0-6f90300261de","name":"base","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"std/test\"\n#+import \"coginiti.co/foundation/retail/base\"\n#+import \"coginiti.co/foundation/retail/base/location\"\n#+import \"coginiti.co/foundation/retail/base/touchpoint\"\n#+import \"coginiti.co/foundation/retail/base/customer\"\n#+import \"coginiti.co/foundation/retail/base/offering\"\n#+import \"coginiti.co/foundation/retail/base/datetime\"\n#+import \"coginiti.co/foundation/retail/base/sales\"\n\n{{ publication.Run(\n\n  packages=[\n    location, \n    touchpoint, \n    customer, \n    offering, \n    datetime, \n    sales\n  ],\n  blocks=[base.Batch]\n\n) }};\n\n\n{{ test.Run(\n\n  packages=[\n    location, \n    touchpoint, \n    customer, \n    offering, \n    datetime, \n    sales\n  ]\n  \n) }};","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_sql_reporting/store_rankings","id":"d715bd69-a139-11f1-b6b0-6f90300261de","folder_id":"d714d303-a139-11f1-b6b0-6f90300261de","name":"store_rankings","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"e36486b0-3cb1-11f1-a457-d9456ae162d8"},"asset_type":"SQL","content":"-- Store Rankings by Market Hierarchy\n-- Demonstrates: CTEs (WITH), RANK() OVER PARTITION BY, derived table subquery,\n--               INNER JOIN, multiple GROUP BY levels, HAVING, BETWEEN, IN\n--\n-- Ranks stores within their market region by gross sales for a configurable date range.\n-- Only active stores (no closing date) and regions with at least 3 stores are included.\n\nWITH store_sales AS (\n\n  -- Step 1: Aggregate sales at store level\n  SELECT\n    bu.market_region_name,\n    bu.market_area_name,\n    bu.district_name,\n    bu.business_unit_id              AS store_id,\n    bu.business_unit_name            AS store_name,\n    MEASURE(sf.total_sales_amount)   AS gross_sales,\n    MEASURE(sf.unique_transactions)  AS transaction_count,\n    MEASURE(sf.total_quantity)       AS units_sold,\n    bu.selling_area_size             AS store_size\n  FROM \n    sale_return_fact AS sf\n  JOIN \n    business_unit_dimension AS bu\n  JOIN \n    date_dimension AS dd\n  WHERE\n    dd.calendar_year BETWEEN 2022 AND 2023\n    AND bu.market_region_name IN ('North America', 'Europe')\n    AND bu.closing_date IS NULL\n  GROUP BY\n    bu.market_region_name,\n    bu.market_area_name,\n    bu.district_name,\n    bu.business_unit_id,\n    bu.business_unit_name,\n    bu.selling_area_size\n\n), ranked_stores AS (\n\n  -- Step 2: Rank stores within each region\n  SELECT\n    market_region_name,\n    market_area_name,\n    district_name,\n    store_id,\n    store_name,\n    gross_sales,\n    transaction_count,\n    units_sold,\n    store_size,\n\n    -- Rank within region\n    RANK() OVER (\n        PARTITION BY market_region_name\n        ORDER BY gross_sales DESC\n    ) AS region_rank,\n\n    -- Rank within market area\n    DENSE_RANK() OVER (\n        PARTITION BY market_region_name, market_area_name\n        ORDER BY gross_sales DESC\n    ) AS area_rank,\n\n    -- Sales as share of regional total (running total denominator)\n    SUM(gross_sales) OVER (\n        PARTITION BY market_region_name\n    ) AS region_total_sales,\n\n    -- Sales per square unit of selling area (efficiency metric)\n    gross_sales / NULLIF(store_size, 0) AS sales_per_size_unit\n\n  FROM \n    store_sales\n\n)\n\n-- Step 3: Filter to top-10 stores per region and add share calculation\nSELECT\n  market_region_name,\n  market_area_name,\n  district_name,\n  store_id,\n  store_name,\n  region_rank,\n  area_rank,\n  gross_sales,\n  transaction_count,\n  units_sold,\n  ROUND(gross_sales / NULLIF(region_total_sales, 0) * 100, 2) AS pct_of_region_sales,\n  ROUND(sales_per_size_unit, 2)                               AS sales_per_size_unit\nFROM \n  ranked_stores\nWHERE \n  region_rank <= 10\nORDER BY\n  market_region_name ASC,\n  region_rank        ASC\n","platform":null}},{"fqn":"/retail/mart/fact_review","id":"0521077d-a142-11f1-b6b0-6f90300261de","folder_id":"d71dacd9-a139-11f1-b6b0-6f90300261de","name":"fact_review","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base/offering\"\n#+import \"coginiti.co/foundation/retail/base/customer\"\n#+import \"coginiti.co/foundation/retail/base/datetime\"\n\n#+src sql FactReview()\n#+meta {\n  :doc \"Fact table representing customer product reviews at the product-customer grain.\n        Captures star rating, review text, date, and helpful vote count for sentiment and engagement analysis.\",\n  :publication {\n    :type \"table\",\n    :name \"fact_review\",\n    :schema \"mart\"\n  }\n}\n#+begin\n  SELECT\n    r.review_key,\n    oi.offering_item_key  AS item_key,\n    p.persona_key,\n    d.date_key            AS review_date_key,\n    r.rating,\n    r.review_text,\n    r.helpful_votes\n  FROM\n    {{ offering.OfferingReview() }} r\n  INNER JOIN {{ offering.OfferingItem() }} oi\n    ON oi.item_id = r.product_id\n  INNER JOIN {{ customer.Persona() }} p\n    ON p.customer_id = r.customer_id\n  INNER JOIN {{ datetime.Date() }} d\n    ON d.business_day_date = r.review_date\n#+end\n","platform":null}},{"fqn":"/retail/landing_ai/customers","id":"d70df607-a139-11f1-b6b0-6f90300261de","folder_id":"d70bfa31-a139-11f1-b6b0-6f90300261de","name":"customers","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/landing\"\n\n-- AI-driven customer records.\n-- Uses two bounded LLM blocks to generate realistic name and address pools,\n-- then expands them to numCustomers rows via SQL random selection.\n-- Publishes to the same landing.customers table as landing/customers.\n\n-- Pool of 200 realistic person names covering diverse cultural backgrounds.\n#+src llm PersonNamePool()\n#+meta {\n  :schema {\n    :columns [\n      {:name \"pool_id\",    :type \"INT\",\n       :description \"Sequential ID from 1 to 200\"},\n      {:name \"first_name\", :type \"STRING\",\n       :description \"Realistic given name\"},\n      {:name \"last_name\",  :type \"STRING\",\n       :description \"Realistic family name\"}\n    ]\n  },\n  :cache_results true\n}\n#+begin\nGenerate exactly 200 realistic person names. Assign sequential pool_id from 1 to 200.\n\nIMPORTANT: Use plain ASCII letters only. No accented characters, diacritics, or special letters\n(e.g. write \"Jose\" not \"José\", \"Francois\" not \"François\", \"Celine\" not \"Céline\",\n\"Gunter\" not \"Günter\", \"Bjorn\" not \"Björn\").\n\nDistribute cultural backgrounds:\n- 60 Anglo-American (James, Sarah, Michael, Emily, Robert, Jessica, David, Ashley...)\n- 30 Hispanic (Carlos, Maria, Jose, Ana, Luis, Sofia, Miguel, Isabella...)\n- 25 German / Austrian (Klaus, Anna, Hans, Petra, Stefan, Monika, Thomas, Sabine...)\n- 20 French (Pierre, Marie, Jean, Isabelle, Francois, Camille, Antoine, Celine...)\n- 20 British (Oliver, Charlotte, William, Emma, Harry, Amelia, George, Isla...)\n- 15 Singaporean / Malaysian Chinese (Wei, Mei, Jun, Hui, Jing, Ling, Xiao, Cheng...)\n- 15 Japanese names romanized (Yuki, Takashi, Haruto, Sakura, Kenji, Akiko, Ren, Hana...)\n- 15 Other European (Luca, Sofia, Pieter, Elena, Andrei, Ioana, Lars, Maja...)\n\nUse realistic first/last name combinations for each background.\n#+end\n\n-- Pool of 100 realistic city + street combinations covering the store countries.\n#+src llm CityPool()\n#+meta {\n  :schema {\n    :columns [\n      {:name \"pool_id\",     :type \"INT\",\n       :description \"Sequential ID from 1 to 100\"},\n      {:name \"street_name\", :type \"STRING\",\n       :description \"Realistic street name (e.g. 'Oak Avenue', 'Main Street', 'Hauptstraße', 'Rue de Rivoli')\"},\n      {:name \"city\",        :type \"STRING\",\n       :description \"Real city name\"}\n    ]\n  },\n  :cache_results true\n}\n#+begin\nGenerate exactly 100 address components. Assign sequential pool_id from 1 to 100.\n\nIMPORTANT: Use plain ASCII letters only. No accented characters, diacritics, or special letters\n(e.g. write \"Rue de la Paix\" not \"Rue de la Paîx\", \"Strasse\" not \"Straße\",\n\"Kurfurstendamm\" not \"Kurfürstendamm\").\n\nDistribute across cities in these countries:\n- US (30 entries): New York, Los Angeles, Chicago, Houston, Seattle, Boston, Miami, Denver, Atlanta, San Francisco\n- GB (15 entries): London, Manchester, Birmingham, Edinburgh, Bristol, Leeds\n- DE (12 entries): Berlin, Munich, Hamburg, Frankfurt, Cologne, Stuttgart\n- FR (10 entries): Paris, Lyon, Marseille, Toulouse, Bordeaux, Nice\n- CA (10 entries): Toronto, Vancouver, Montreal, Calgary, Ottawa\n- SG (8 entries): Singapore — use neighborhoods: Marina Bay, Orchard, Tampines, Jurong, Bedok\n- MY (5 entries): Kuala Lumpur, Petaling Jaya, George Town\n- IE (5 entries): Dublin, Cork, Galway\n- NL (5 entries): Amsterdam, Rotterdam, The Hague, Utrecht\n\nUse real, recognizable street names for each city.\n#+end\n\n-- Expand the two pools to numCustomers = 1000 rows using random selection.\n#+src sql Customers()\n#+meta {\n  :publication {\n    :type   \"table\",\n    :name   \"customers\",\n    :schema \"landing\"\n  }\n}\n#+begin\n  WITH\n  name_pool AS (\n    SELECT pool_id, first_name, last_name\n    FROM {{ PersonNamePool() }}\n  ),\n\n  city_pool AS (\n    SELECT pool_id, street_name, city\n    FROM {{ CityPool() }}\n  ),\n\n  phone_numbers AS (\n    SELECT\n      ROW_NUMBER() OVER ()  AS seq_number,\n      phone_number\n    FROM {{ landing.MobilePhoneNumbers(numCustomers) }}\n  ),\n\n  base AS (\n    SELECT\n      id                                                              AS seq_number,\n      (FLOOR(random() * {{ namePoolSize }})::INT + 1)::INT           AS name_idx,\n      (FLOOR(random() * {{ addrPoolSize }})::INT + 1)::INT           AS addr_idx,\n      FLOOR(random() * 1000)::INT                                    AS email_rand\n    FROM generate_series(1, {{ numCustomers }}) AS gs(id)\n  )\n\n  SELECT\n    b.seq_number                                                      AS id,\n    n.first_name,\n    n.last_name,\n    LOWER(REGEXP_REPLACE(n.first_name, '[^a-zA-Z0-9]', '', 'g'))\n      || '_'\n      || LOWER(REGEXP_REPLACE(n.last_name, '[^a-zA-Z0-9]', '', 'g'))\n      || b.email_rand::TEXT || '@' ||\n      CASE (b.seq_number % 4)\n        WHEN 0 THEN 'gmail.com'\n        WHEN 1 THEN 'hotmail.com'\n        WHEN 2 THEN 'yahoo.com'\n        ELSE        'outlook.com'\n      END                                                             AS email,\n    (b.seq_number % 999 + 1)::TEXT || ' ' || a.street_name          AS address_line_1,\n    NULL::VARCHAR                                                     AS address_line_2,\n    a.city,\n    LPAD(((b.seq_number * 97) % 90000 + 10000)::TEXT, 5, '0')        AS postal_code,\n    pn.phone_number\n  FROM      base          b\n  JOIN      name_pool     n   ON n.pool_id = b.name_idx\n  JOIN      city_pool     a   ON a.pool_id = b.addr_idx\n  JOIN      phone_numbers pn  ON pn.seq_number = b.seq_number\n#+end\n","platform":null}},{"fqn":"/retail/landing/sales","id":"d70fa3c1-a139-11f1-b6b0-6f90300261de","folder_id":"d70e1d18-a139-11f1-b6b0-6f90300261de","name":"sales","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n\n-- Sales transaction data — randomly generated for demo purposes.\n-- Produces numProducts × numSalesTransations rows:\n--   - transaction_id runs 1 to numSalesTransations (one header per transaction)\n--   - each transaction contains one line per product (line_number 1..numProducts)\n-- customer_id, store_id, and timestamp are assigned per transaction (consistent\n-- across all line items of the same transaction via the window function).\n\n#+src sql Sales()\n#+meta {\n  :publication {\n    :type \"table\",\n    :name \"sales\",\n    :schema \"landing\"\n  }\n}\n#+begin\n  SELECT\n    ROW_NUMBER() OVER ()                                                  AS id,\n    transaction_id,\n    transaction_timestamp,\n    ROW_NUMBER() OVER (PARTITION BY transaction_id ORDER BY product_id)   AS line_number,\n    customer_id,\n    store_id,\n    product_id,\n    product_price,\n    quantity\n  FROM (\n    SELECT\n      ids.id                                                              AS transaction_id,\n      '{{ transactionsStartDate }}'::TIMESTAMPTZ\n        + random() * ('{{ transactionsEndDate }}'::TIMESTAMPTZ\n                    - '{{ transactionsStartDate }}'::TIMESTAMPTZ)         AS transaction_timestamp,\n      FLOOR(random() * {{ numCustomers }})::INT + 1                       AS customer_id,\n      'ST' || (FLOOR(random() * {{ numStores }})::INT + 1)                AS store_id,\n      products.product_id,\n      products.product_price,\n      (random() * 15)::INT + 1                                            AS quantity\n    FROM (\n      SELECT\n        id AS product_id,\n        (random() * 99 + 1)::NUMERIC(18,2) AS product_price\n      FROM {{ Series(numProducts) }}\n    ) products\n    CROSS JOIN {{ Series(numSalesTransations) }} ids\n  ) t\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_ai/product_review_insights","id":"285bd4bc-a148-11f1-b6b0-6f90300261de","folder_id":"d71a2a53-a139-11f1-b6b0-6f90300261de","name":"product_review_insights","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/print\"\n#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/mart\"\n\n-- Product Review Insights\n-- Combines mart sales metrics with LLM-analyzed customer review data.\n-- ProductSalesSummary() aggregates per-product revenue, volume, and review scores.\n-- ProductInsights() feeds that CSV to the LLM, which returns a sentiment label,\n-- a dominant customer theme, and a marketing action recommendation per product.\n\n#+src sql ProductSalesSummary()\n#+meta {\n  :doc \"Joins item_dimension, sale_return_fact, and fact_review to produce per-product revenue, volume, and review quality metrics used as LLM input.\"\n}\n#+begin\n  SELECT\n    id.item_id,\n    id.item_name,\n    SUM(f.sales_quantity)                                               AS total_units_sold,\n    ROUND(SUM(f.gross_sales_amount)::DECIMAL, 2)                        AS total_revenue,\n    ROUND(AVG(f.gross_sales_amount)::DECIMAL, 2)                        AS avg_unit_price,\n    COUNT(r.review_key)                                                 AS review_count,\n    ROUND(AVG(r.rating::DECIMAL), 2)                                    AS avg_rating,\n    SUM(CASE WHEN r.rating >= 4 THEN 1 ELSE 0 END)                     AS positive_reviews,\n    SUM(CASE WHEN r.rating <= 2 THEN 1 ELSE 0 END)                     AS negative_reviews,\n    ROUND(AVG(r.helpful_votes::DECIMAL), 1)                             AS avg_helpful_votes\n  FROM {{ mart.ItemDimension() }}    AS id\n  JOIN {{ mart.FactSalesReturn() }}  AS f  ON f.item_key   = id.item_key\n  JOIN {{ mart.FactReview() }}       AS r  ON r.item_key   = id.item_key\n  GROUP BY id.item_id, id.item_name\n#+end\n\n#+src llm ProductInsights()\n#+meta {\n  :doc \"LLM block that classifies each product's review sentiment (Positive/Mixed/Negative), identifies the dominant customer theme, and returns a targeted marketing recommendation.\",\n  :schema {\n    :columns [\n      {:name \"item_name\",                :type \"STRING\",\n       :description \"Product name exactly as it appears in the input data — do not alter\"},\n      {:name \"sentiment_label\",          :type \"STRING\",\n       :description \"Overall review sentiment based on avg_rating: Positive (>= 3.8), Mixed (2.8–3.7), Negative (< 2.8)\"},\n      {:name \"key_customer_theme\",       :type \"STRING\",\n       :description \"Dominant customer perception in 4–6 words (e.g. 'Great value for money', 'Durability issues reported', 'Easy to use and reliable')\"},\n      {:name \"marketing_recommendation\", :type \"STRING\",\n       :description \"One concrete, actionable marketing or product recommendation sentence tailored to this product's review profile\"}\n    ]\n  },\n  :cache_results true\n}\n#+begin\nYou are a retail analytics expert. The table below contains per-product sales and review metrics.\nAnalyze each product's rating distribution and volume to identify the dominant customer sentiment\nand the most impactful marketing action.\n\n{{ print.Csv(ProductSalesSummary()) }}\n\nColumn guide:\n- avg_rating: 1 (worst) to 5 (best)\n- positive_reviews: count of 4- and 5-star reviews\n- negative_reviews: count of 1- and 2-star reviews\n- avg_helpful_votes: average helpful votes per review — higher means reviews are influential\n\nRules:\n- Return exactly one row per product using the exact item_name from the input — no changes.\n- sentiment_label must be exactly one of: Positive, Mixed, Negative.\n- key_customer_theme: 4–6 words, descriptive and specific (avoid generic phrases like \"good product\").\n- marketing_recommendation: one sentence, concrete and specific (e.g. \"Feature in Best Value campaign to convert browse-only visitors\", \"Add quality guarantee badge to offset negative durability perception\").\n- Use plain ASCII only. No accented characters or special symbols.\n#+end\n\n#+src sql ProductReviewInsights()\n#+meta {\n  :doc \"Final report combining LLM-generated sentiment insights with sales and review metrics, ranked by total revenue. Published to reports_ai.product_review_insights.\",\n  :publication {\n    :type  \"table\",\n    :name  \"product_review_insights\",\n    :schema \"reports_ai\"\n  }\n}\n#+begin\n  SELECT\n    pi.item_name,\n    pi.sentiment_label,\n    pi.key_customer_theme,\n    pi.marketing_recommendation,\n    ps.avg_rating,\n    ps.review_count,\n    ps.positive_reviews,\n    ps.negative_reviews,\n    ps.avg_helpful_votes,\n    ps.total_units_sold,\n    ps.total_revenue,\n    ps.avg_unit_price,\n    RANK() OVER (ORDER BY ps.total_revenue DESC) AS revenue_rank\n  FROM {{ ProductInsights() }}     AS pi\n  JOIN {{ ProductSalesSummary() }} AS ps  ON ps.item_name = pi.item_name\n  ORDER BY ps.total_revenue DESC\n#+end\n","platform":null}},{"fqn":"/retail/base/location/district","id":"d711ecc0-a139-11f1-b6b0-6f90300261de","folder_id":"d711788c-a139-11f1-b6b0-6f90300261de","name":"district","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/sources\"\n#+import \"coginiti.co/foundation/retail/base\"\n\n#+src sql District()\n#+meta {\n  :doc \"A dimensional type representing the third level of geographical grouping of stores within a Market Area used for aggregating data.\",\n  :publication {\n    :type \"table\",\n    :name \"dim_district\",\n    :schema \"base\",\n    :primary_key [\"district_key\"],\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS district_key,\n    _t.district_code AS district_id,\n    _t.district AS district_name,\n    {{ base.SurrogateKey(\"_t.market_area_nk\") }} AS market_area_key,\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      district_nk AS natural_key,\n      district_code,\n      district,\n      market_area_nk,\n      ROW_NUMBER() OVER (PARTITION BY district_code ORDER BY district_code DESC, row_hash) AS row_num\n    FROM\n      {{ sources.Stores() }}\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/reports/sales_trend_report","id":"121cbf59-a152-11f1-b6b0-6f90300261de","folder_id":"d716a7cf-a139-11f1-b6b0-6f90300261de","name":"sales_trend_report","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/reports/reports_semantic/semantic_csl_reporting/sales\"\n\n-- Monthly Sales Trend Report\n-- Demonstrates: chaining CSL blocks on top of the semantic layer\n--               (sales.MonthlySales() -> WithTrendMetrics() -> MonthlySalesTrendReport()),\n--               LAG(), running SUM() OVER, YTD SUM() OVER PARTITION BY, 3-month moving average.\n--\n-- Each block reference below compiles to a CTE (WITH _MonthlySales AS (...), WITH\n-- _WithTrendMetrics AS (...), ...) nested inside the single SELECT that runs\n-- MonthlySalesTrendReport(). The chain has to stay inside one statement end-to-end: the\n-- semantic layer connection has no temp/permanent tables to fall back to if the CTE nesting\n-- ever became too complex for a single WITH chain.\n\n#+src sql WithTrendMetrics(yearFrom)\n#+meta {\n  :doc \"Adds running total, YTD, moving average and prior-month comparison to\n        sales.MonthlySales().\"\n}\n#+begin\n  SELECT\n    calendar_year,\n    calendar_month,\n    gross_sales,\n    transactions,\n    units_sold,\n\n    -- Running cumulative total from the beginning of the series\n    SUM(gross_sales) OVER (\n      ORDER BY calendar_year, calendar_month\n      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n    ) AS running_total_sales,\n\n    -- Year-to-date total (resets each calendar year)\n    SUM(gross_sales) OVER (\n      PARTITION BY calendar_year\n      ORDER BY calendar_month\n      ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW\n    ) AS ytd_sales,\n\n    -- 3-month centred moving average\n    AVG(gross_sales) OVER (\n      ORDER BY calendar_year, calendar_month\n      ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING\n    ) AS ma3_sales,\n\n    -- Previous month's sales (defaults to 0 for the first row)\n    LAG(gross_sales, 1, 0) OVER (\n      ORDER BY calendar_year, calendar_month\n    ) AS prev_month_sales\n  FROM\n    {{ sales.MonthlySales(yearFrom) }}\n#+end\n\n#+src sql MonthlySalesTrendReport(yearFrom)\n#+meta {\n  :doc \"Final formatted monthly sales trend report.\n        $Parameters:\n          - $yearFrom: earliest calendar year (inclusive) to include.\"\n}\n#+begin\n  SELECT\n    calendar_year,\n    calendar_month,\n    ROUND(gross_sales, 2)         AS gross_sales,\n    ROUND(running_total_sales, 2) AS running_total_sales,\n    ROUND(ytd_sales, 2)           AS ytd_sales,\n    ROUND(ma3_sales, 2)           AS ma3_sales,\n    ROUND(prev_month_sales, 2)    AS prev_month_sales,\n    transactions,\n    units_sold\n  FROM\n    {{ WithTrendMetrics(yearFrom) }}\n  ORDER BY\n    calendar_year ASC,\n    calendar_month ASC\n#+end\n\n-- Runnable example\nSELECT * FROM {{ MonthlySalesTrendReport(2021) }};\n","platform":null}},{"fqn":"/retail/sources/countries","id":"d71d5eb7-a139-11f1-b6b0-6f90300261de","folder_id":"d71b89ea-a139-11f1-b6b0-6f90300261de","name":"countries","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+src sql Countries()\n#+begin\n   SELECT\n    country_code_2chars AS iso_2_code,\n    country_code_3chars AS iso_3_code,\n    country_num_code,\n    name\n  FROM\n    landing.countries\n#+end","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/reports/channel_mix_report_test","id":"d716cee0-a139-11f1-b6b0-6f90300261de","folder_id":"d716a7cf-a139-11f1-b6b0-6f90300261de","name":"channel_mix_report_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the channel mix report.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_ChannelMixReport_HasData()\n#+meta {\n  :doc \"Fails if the report returns no rows for fiscal years 2022–2023.\"\n}\n#+begin\n  SELECT\n    COUNT(*) AS row_count\n  FROM\n    {{ ChannelMixReport(2022, 2023) }}\n  HAVING\n    COUNT(*) = 0\n#+end\n\n#+test sql Test_ChannelMixReport_TotalsMatchDetail()\n#+meta {\n  :doc \"Fails if a fiscal year's 'total' row doesn't match the sum of its 'detail' rows\n        (beyond rounding), indicating the UNION ALL branches in ChannelMixReport() have\n        drifted out of sync.\"\n}\n#+begin\n  SELECT\n    d.fiscal_year,\n    d.detail_total,\n    t.gross_sales AS total_row_amount\n  FROM\n    (\n      SELECT\n        fiscal_year,\n        SUM(gross_sales) AS detail_total\n      FROM\n        {{ ChannelMixReport(2022, 2023) }}\n      WHERE\n        row_type = 'detail'\n      GROUP BY\n        fiscal_year\n    ) AS d\n  JOIN\n    (\n      SELECT\n        fiscal_year,\n        gross_sales\n      FROM\n        {{ ChannelMixReport(2022, 2023) }}\n      WHERE\n        row_type = 'total'\n    ) AS t\n    ON t.fiscal_year = d.fiscal_year\n  WHERE\n    ABS(d.detail_total - t.gross_sales) > 0.05\n#+end\n","platform":null}},{"fqn":"/retail/landing_ai/products","id":"d70ce494-a139-11f1-b6b0-6f90300261de","folder_id":"d70bfa31-a139-11f1-b6b0-6f90300261de","name":"products","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n\n-- AI-driven product catalog.\n-- Generates 100 realistic products with real brand names, meaningful descriptions,\n-- and category-appropriate prices. Publishes to the same landing.products table\n-- as the SQL-based landing/products script — run one or the other, not both.\n\n#+src llm Products()\n#+meta {\n  :schema {\n    :columns [\n      {:name \"id\", :type \"INT\", :description \"Sequential product ID from 1 to 100\"},\n      {:name \"name\", :type \"STRING\", :description \"Realistic product name with brand where applicable, e.g. 'Samsung 55\\\" QLED TV', 'Organic Whole Milk 1L', 'The Great Gatsby'\"},\n      {:name \"category_code\", :type \"STRING\", :description \"Exactly one of: ELE, GRO, BOO, TOL, TOY, GAR, SPO\"},\n      {:name \"category_name\", :type \"STRING\", :description \"Full category name matching the code — Electronics, Grocery, Books, Tools, Toys, Garden, Sport\"}\n    ]\n  },\n  :publication {\n    :type   \"table\",\n    :name   \"products\",\n    :schema \"landing\"\n  },\n  :cache_results true\n}\n#+begin\nGenerate exactly 100 realistic retail products. Assign sequential id values from 1 to 100.\n\nIMPORTANT: Use plain ASCII letters only. No accented characters, diacritics, or special letters\n(e.g. write \"Nespresso\" not \"Nëspresso\", \"Oster\" not \"Östér\").\n\nDistribute across categories:\n- 20 Electronics (id 1–20): TVs, smartphones, laptops, headphones, tablets, cameras, smart speakers.\n  Use real brands: Samsung, Sony, Apple, LG, Bose, Dell, Canon.\n- 15 Grocery (id 21–35): Everyday staples — milk, bread, coffee, pasta, olive oil, cereals, juice.\n  Use realistic package sizes (e.g. \"Organic Whole Milk 1L\", \"Barilla Spaghetti 500g\").\n- 15 Books (id 36–50): Fiction, non-fiction, science, history.\n  Use real or highly plausible titles with authors (e.g. \"Atomic Habits - James Clear\", \"Dune - Frank Herbert\").\n- 10 Tools (id 51–60): Power tools and hand tools.\n  Use real brands: DeWalt, Bosch, Stanley, Makita (e.g. \"DeWalt 20V Cordless Drill\", \"Stanley 16oz Claw Hammer\").\n- 15 Toys (id 61–75): LEGO sets, board games, action figures, educational kits, outdoor toys.\n  Use real brands where appropriate: LEGO, Hasbro, Mattel (e.g. \"LEGO City Police Station 60316\").\n- 10 Garden (id 76–85): Planters, garden tools, seeds packets, outdoor furniture, irrigation kits.\n- 15 Sport (id 86–100): Yoga mats, dumbbells, running shoes, bicycles, team sport equipment.\n  Use real brands: Nike, Adidas, Decathlon (e.g. \"Nike Air Zoom Pegasus 40\").\n\nProduct names must be specific and realistic — never generic like \"Product 1\" or \"Item A\".\n#+end\n","platform":null}},{"fqn":"/retail/reports/reports_semantic","id":"764740bf-a151-11f1-b6b0-6f90300261de","folder_id":"d71918dc-a139-11f1-b6b0-6f90300261de","name":"reports_semantic","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/reports/reports_semantic/semantic_sql_reporting","id":"d714d303-a139-11f1-b6b0-6f90300261de","folder_id":"764740bf-a151-11f1-b6b0-6f90300261de","name":"semantic_sql_reporting","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"e36486af-3cb1-11f1-a457-d9456ae162d8"}}},{"fqn":"/retail/reports/reports_regular/daily_snapshot","id":"d7193fed-a139-11f1-b6b0-6f90300261de","folder_id":"8f049129-a151-11f1-b6b0-6f90300261de","name":"daily_snapshot","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"cd8b5759-845a-11f1-a626-557cda040604"},"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/mart\"\n\n-- Daily Sales Snapshot\n-- Goal: Produce a point-in-time sales summary for a single snapshot date, looking back\n--       a configurable number of days. The output is written to rpt_daily_snapshot_current\n--       and is intentionally overwritten on each run, so it always reflects the latest\n--       requested window rather than accumulating historical rows.\n--\n-- Parameters:\n--   $snapshot_date   – Anchor date for the snapshot (e.g. '2023-01-31').\n--                      All lookback is measured relative to this date.\n--   $lookback_days   – How many calendar days before snapshot_date to include\n--                      (e.g. 30 = last 30 days up to and including snapshot_date).\n--   $snapshot_type   – Descriptive label stored in the output to identify the\n--                      granularity intent: 'daily', 'weekly', or 'monthly'.\n--\n-- Output grain: one row per business day within the lookback window.\n-- Key metrics per day: transaction count, unique customers, unique stores,\n--                      total quantity sold, total sales amount, average transaction value.\n--\n-- Typical consumers: operations dashboards, daily trading reports, alerting pipelines.\n\n#+src sql DailySnapshot()\n#+meta {\n  :doc \"Daily sales snapshot - refreshed with different date ranges.\n        This table is intentionally overwritten by design.\n        $Parameters:\n          - $snapshot_date: The date for the snapshot (e.g., '2023-01-01')\n          - $lookback_days: Number of days to look back (default 30)\n          - $snapshot_type: Type of snapshot (daily, weekly, monthly)\",\n  :publication {\n    :type \"table\",\n    :name \"rpt_daily_snapshot_current\",\n    :schema \"reports\"\n  }\n}\n#+begin\n  WITH snapshot_config AS (\n    -- Materialise parameters into a single-row config CTE so they are\n    -- referenced by name throughout the query rather than repeated inline.\n    SELECT\n      '$snapshot_date'::DATE AS snapshot_date,\n      $lookback_days AS lookback_days,\n      '$snapshot_type' AS snapshot_type\n  )\n\n  SELECT\n    sc.snapshot_date,\n    sc.lookback_days,\n    sc.snapshot_type,\n    CURRENT_TIMESTAMP AS snapshot_generated_at,   -- audit: when this run was produced\n    d.business_day_date AS sale_date,\n    d.calendar_year,\n    d.calendar_quarter,\n    d.calendar_month,\n    d.calendar_week,\n    COUNT(DISTINCT f.transaction_id) AS transaction_count,\n    COUNT(DISTINCT f.persona_key) AS unique_customers,\n    COUNT(DISTINCT f.business_unit_key) AS unique_stores,\n    SUM(f.sales_quantity) AS total_quantity,\n    SUM(f.gross_sales_amount) AS total_sales_amount,\n    ROUND(AVG(f.gross_sales_amount), 2) AS avg_transaction_amount\n  FROM\n    snapshot_config sc\n  CROSS JOIN {{ mart.FactSalesReturn() }} f\n  INNER JOIN {{ mart.DateDimension() }} d\n    ON d.date_key = f.transaction_date_key\n  WHERE\n    -- Restrict to the lookback window ending on snapshot_date\n    d.business_day_date BETWEEN (sc.snapshot_date - (sc.lookback_days || ' days')::INTERVAL) AND sc.snapshot_date\n  GROUP BY\n    sc.snapshot_date,\n    sc.lookback_days,\n    sc.snapshot_type,\n    d.business_day_date,\n    d.calendar_year,\n    d.calendar_quarter,\n    d.calendar_month,\n    d.calendar_week\n  ORDER BY\n    d.business_day_date DESC\n  ;\n#+end;\n","platform":null}},{"fqn":"/retail/base/customer/persona","id":"d7106716-a139-11f1-b6b0-6f90300261de","folder_id":"d7104005-a139-11f1-b6b0-6f90300261de","name":"persona","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/base\"\n#+import \"coginiti.co/foundation/retail/sources\"\n\n#+src sql Persona()\n#+meta {\n  :doc `A dimensional type representing a customer as it is known to a source system.\n        Generally, the \"PERSONA\" will be identified by some source system generated identifier.\n        This identifier should be persistent and should never be destroyed.`,\n  :publication {\n    :type \"table\",\n    :name \"dim_persona\",\n    :schema \"base\",\n    :incremental \"merge\",\n    :unique_key [\"persona_key\"],\n    :update_on_changes_in [\"first_name\", \"last_name\", \"postal_address_key\", \"phone_number_key\", \"email_address_key\"]\n  }\n}\n#+begin\n  SELECT\n    {{ base.SurrogateKey(\"_t.natural_key\") }} AS persona_key,\n    _t.customer_id,\n    _t.first_name,\n    _t.last_name,\n    {{ base.SurrogateKey(\"_t.postal_address_nk\") }} AS postal_address_key,\n    {{ base.SurrogateKey(\"_t.phone_number_nk\") }} AS phone_number_key,\n    {{ base.SurrogateKey(\"_t.email_address_nk\") }} AS email_address_key,\n    b.system_timestamp AS start_datetime,\n    b.batch_number AS batch_number\n  FROM (\n    SELECT\n      persona_nk AS natural_key,\n      customer_id,\n      first_name,\n      last_name,\n      postal_address_nk,\n      phone_number_nk,\n      email_address_nk,\n      ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY customer_id DESC, row_hash) AS row_num\n    FROM\n      {{ sources.Customers() }}\n  ) _t\n  CROSS JOIN {{ base.Batch() }} b\n  WHERE\n    _t.row_num = 1\n#+end\n","platform":null}},{"fqn":"/retail/semantic_layer/offering/item_dimension.smdl","id":"d7215670-a139-11f1-b6b0-6f90300261de","folder_id":"d721084f-a139-11f1-b6b0-6f90300261de","name":"item_dimension.smdl","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"b5b1e5a7-8454-11f1-a626-557cda040604"},"asset_type":"SQL","content":"entity \"item_dimension\" {\n  label       = \"Product\"\n  description = \"Product catalogue dimension. Each row represents one sellable offering item.\"\n  table_name  = \"item_dimension\"\n  schema_name = \"mart\"\n  synonyms    = [\"product\", \"item\", \"sku\", \"merchandise\", \"offering\", \"article\"]\n\n  # --- Surrogate key (used in relationships) ---\n\n  dimension \"item_key\" {\n    label    = \"Item Key\"\n    type     = \"text\"\n    expr     = \"item_key\"\n    synonyms = [\"item key\", \"product key\", \"sku key\", \"product surrogate key\"]\n  }\n\n  # --- Descriptive dimensions ---\n\n  dimension \"item_id\" {\n    label       = \"Item ID\"\n    description = \"Natural business key for the product (format: PRD^<id>).\"\n    type        = \"text\"\n    expr        = \"item_id\"\n    synonyms    = [\"item id\", \"product id\", \"product number\", \"sku id\", \"article number\"]\n  }\n\n  dimension \"item_name\" {\n    label       = \"Item Name\"\n    description = \"Display name of the product.\"\n    type        = \"text\"\n    expr        = \"item_name\"\n    synonyms    = [\"item name\", \"product name\", \"product description\", \"sku name\", \"article name\"]\n  }\n\n  # --- Measures ---\n\n  measure \"unique_products\" {\n    label            = \"Unique Products\"\n    description      = \"Count of distinct products in scope.\"\n    type             = \"number\"\n    aggregation_type = \"count_distinct\"\n    expr             = \"item_key\"\n    synonyms         = [\"distinct products\", \"number of products\", \"product count\", \"sku count\", \"total items\"]\n  }\n\n  # --- Inverse relationship: one product → many sales lines ---\n\n  relationship \"item_to_sales\" {\n    label = \"Sales Lines\"\n    type  = \"one_to_many\"\n    expr  = \"item_dimension.item_key = sale_return_fact.item_key\"\n  }\n}\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_csl_reporting/reports/channel_mix_report","id":"115f148b-a152-11f1-b6b0-6f90300261de","folder_id":"d716a7cf-a139-11f1-b6b0-6f90300261de","name":"channel_mix_report","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/reports/reports_semantic/semantic_csl_reporting/sales\"\n#+import \"coginiti.co/foundation/retail/reports/reports_semantic/semantic_csl_reporting/common\"\n\n-- Channel Mix Report\n-- Demonstrates: layering window-function ranking and a macro-driven share calculation on top\n--               of sales.SalesByChannelFiscalYear(), then UNION ALL-ing in a grand-total row —\n--               still one statement, so it still compiles to a single CTE chain.\n--\n-- sales.SalesByChannelFiscalYear(yearFrom, yearTo) is referenced twice below with identical\n-- arguments: once indirectly through WithChannelRanking(), and once directly in the\n-- grand-total branch. Per CSL's result-caching rule, both references share one cached\n-- CTE — the block still only executes once.\n\n#+src sql WithChannelRanking(yearFrom, yearTo)\n#+meta {\n  :doc \"Adds cumulative sales share inputs, percentile rank and cumulative distribution per\n        fiscal year to sales.SalesByChannelFiscalYear().\"\n}\n#+begin\n  SELECT\n    fiscal_year,\n    channel_code,\n    channel_name,\n    gross_sales,\n    transactions,\n    units_sold,\n    avg_basket,\n    SUM(gross_sales) OVER (PARTITION BY fiscal_year) AS year_total,\n    PERCENT_RANK() OVER (PARTITION BY fiscal_year ORDER BY gross_sales) AS percentile_rank,\n    CUME_DIST()    OVER (PARTITION BY fiscal_year ORDER BY gross_sales) AS cume_dist\n  FROM\n    {{ sales.SalesByChannelFiscalYear(yearFrom, yearTo) }}\n#+end\n\n#+src sql ChannelMixReport(yearFrom, yearTo)\n#+meta {\n  :doc \"Final channel mix report: per-channel detail rows plus a grand-total row per fiscal year.\n        $Parameters:\n          - $yearFrom: earliest fiscal year (inclusive)\n          - $yearTo: latest fiscal year (inclusive)\"\n}\n#+begin\n  SELECT\n    fiscal_year,\n    channel_code,\n    channel_name,\n    ROUND(gross_sales, 2) AS gross_sales,\n    transactions,\n    units_sold,\n    ROUND(avg_basket, 2)  AS avg_basket,\n    {{ common.PctShare(numeratorExpr=\"gross_sales\", denominatorExpr=\"year_total\") }} AS pct_of_year_sales,\n    ROUND(percentile_rank, 3) AS percentile_rank,\n    ROUND(cume_dist, 3)       AS cume_dist,\n    'detail' AS row_type\n  FROM\n    {{ WithChannelRanking(yearFrom, yearTo) }}\n\n  UNION ALL\n\n  SELECT\n    fiscal_year,\n    'ALL'          AS channel_code,\n    'All Channels' AS channel_name,\n    ROUND(SUM(gross_sales), 2) AS gross_sales,\n    SUM(transactions)          AS transactions,\n    SUM(units_sold)            AS units_sold,\n    ROUND(AVG(avg_basket), 2)  AS avg_basket,\n    CAST(100.0 AS DOUBLE)      AS pct_of_year_sales,\n    NULL AS percentile_rank,\n    NULL AS cume_dist,\n    'total' AS row_type\n  FROM\n    {{ sales.SalesByChannelFiscalYear(yearFrom, yearTo) }}\n  GROUP BY\n    fiscal_year\n#+end\n\n-- Runnable example\nSELECT * FROM {{ ChannelMixReport(2022, 2023) }}\nORDER BY fiscal_year ASC, row_type DESC, gross_sales DESC;\n","platform":null}},{"fqn":"/retail/reports/reports_semantic/semantic_sql_reporting/customer_rfm_analysis","id":"d7154836-a139-11f1-b6b0-6f90300261de","folder_id":"d714d303-a139-11f1-b6b0-6f90300261de","name":"customer_rfm_analysis","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":{"uuid":"e36486b1-3cb1-11f1-a457-d9456ae162d8"},"asset_type":"SQL","content":"-- Customer RFM Segmentation Analysis\n-- Demonstrates: explicit JOIN across multiple entities, CASE WHEN with multiple conditions,\n--               aggregate window (AVG OVER, SUM OVER), NULLIF, ROUND, IN predicate\n--\n-- Analyses customer RFM segment distribution and compares each segment's average\n-- spend to the overall average.\n\nWITH segment_stats AS (\n\n    -- Aggregate RFM metrics by segment\n    SELECT\n      rfm_segment,\n      MEASURE(pda.customer_count)        AS customer_count,\n      MEASURE(pda.sum_lifetime_sales)    AS segment_total_sales,\n      MEASURE(pda.avg_lifetime_sales)    AS avg_lifetime_sales,\n      MEASURE(pda.max_lifetime_sales)    AS max_lifetime_sales,\n      MEASURE(pda.min_lifetime_sales)    AS min_lifetime_sales,\n      MEASURE(pda.avg_order_frequency)   AS avg_orders\n    FROM \n      persona_derived_attributes AS pda\n    GROUP BY \n      rfm_segment\n\n), segment_with_share AS (\n\n  -- Add segment share of total customers and cross-segment average comparison\n  SELECT\n    rfm_segment,\n    customer_count,\n    segment_total_sales,\n    avg_lifetime_sales,\n    max_lifetime_sales,\n    min_lifetime_sales,\n    avg_orders,\n\n    -- Share of total customer base\n    ROUND(\n      customer_count * 100.0 / NULLIF(SUM(customer_count) OVER (), 0),\n      2\n    ) AS pct_of_customers,\n\n    -- Compare segment average to overall average (index: >100 = above average)\n    ROUND(\n      avg_lifetime_sales / NULLIF(AVG(avg_lifetime_sales) OVER (), 0) * 100,\n      1\n    ) AS spend_index,\n\n    -- Risk classification\n    CASE\n      WHEN rfm_segment IN ('Cannot lose', 'Potential churners') THEN 'At Risk'\n      WHEN rfm_segment = 'Active fans'                          THEN 'Healthy'\n      WHEN rfm_segment = 'Promising newbies'                    THEN 'Growth'\n      ELSE 'Other'\n    END AS risk_tier\n  FROM \n    segment_stats\n)\n\nSELECT\n  rfm_segment,\n  risk_tier,\n  customer_count,\n  pct_of_customers,\n  ROUND(segment_total_sales, 2) AS segment_total_sales,\n  ROUND(avg_lifetime_sales, 2)  AS avg_lifetime_sales,\n  ROUND(max_lifetime_sales, 2)  AS max_lifetime_sales,\n  ROUND(min_lifetime_sales, 2)  AS min_lifetime_sales,\n  spend_index,\n  ROUND(avg_orders, 1)          AS avg_orders\nFROM \n  segment_with_share\nORDER BY\n    avg_lifetime_sales DESC\n","platform":null}},{"fqn":"/retail/sources/date_calendar","id":"d71c7451-a139-11f1-b6b0-6f90300261de","folder_id":"d71b89ea-a139-11f1-b6b0-6f90300261de","name":"date_calendar","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+src sql DateCalendar()\n#+begin\n  SELECT\n    d.business_day_date,\n    d.calendar_year,\n    d.calendar_quarter,\n    d.calendar_month,\n    d.calendar_week,\n    d.calendar_week_day,\n    d.calendar_holiday_flag,\n    d.fiscal_year,\n    d.fiscal_quarter,\n    d.fiscal_period,\n    d.fiscal_week,\n    d.fiscal_week_day,\n    d.fiscal_holiday_flag,\n    {{ NaturalKey(\"DATE^\", [\"business_day_date\"]) }} AS date_nk\n  FROM\n    landing.date_calendar d\n#+end\n","platform":null}},{"fqn":"/retail/base/location","id":"d711788c-a139-11f1-b6b0-6f90300261de","folder_id":"d71018f4-a139-11f1-b6b0-6f90300261de","name":"location","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":null}},{"fqn":"/retail/reports/reports_ai/store_performance_narratives_test","id":"d71b14b7-a139-11f1-b6b0-6f90300261de","folder_id":"d71a2a53-a139-11f1-b6b0-6f90300261de","name":"store_performance_narratives_test","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"-- Data quality tests for the store performance narratives report.\n-- Tests pass when they return an empty result set.\n\n#+test sql Test_StorePerformanceNarratives_HasData()\n#+meta {\n  :doc \"Fails if the report is empty, indicating no stores were ranked or the LLM returned no rows.\"\n}\n#+begin\n  SELECT \n    COUNT(*) AS row_count\n  FROM \n    {{ StorePerformanceNarratives() }}\n  HAVING \n    COUNT(*) = 0\n#+end\n\n#+test sql Test_StorePerformanceNarratives_UniqueStores()\n#+meta {\n  :doc \"Fails if any store appears more than once, indicating a duplicate join between narratives and performance metrics.\"\n}\n#+begin\n  SELECT \n    business_unit_name, \n    COUNT(*) AS cnt\n  FROM \n    {{ StorePerformanceNarratives() }}\n  GROUP BY \n    business_unit_name\n  HAVING \n    COUNT(*) > 1\n#+end\n\n#+test sql Test_StorePerformanceNarratives_ValidPerformanceTiers()\n#+meta {\n  :doc \"Fails if the LLM returned a performance_tier outside the allowed set: Star Performer, Underperformer.\"\n}\n#+begin\n  SELECT \n    business_unit_name, \n    performance_tier\n  FROM \n    {{ StorePerformanceNarratives() }}\n  WHERE \n    performance_tier NOT IN ('Star Performer', 'Underperformer')\n#+end\n\n#+test sql Test_StorePerformanceNarratives_NoNullNarratives()\n#+meta {\n  :doc \"Fails if any LLM-generated column (narrative_insight, recommended_action) is null.\"\n}\n#+begin\n  SELECT \n    *\n  FROM \n    {{ StorePerformanceNarratives() }}\n  WHERE \n    narrative_insight IS NULL\n    OR recommended_action IS NULL\n#+end\n\n#+test sql Test_StorePerformanceNarratives_PositiveRevenue()\n#+meta {\n  :doc \"Fails if any store row has a non-positive total_revenue, indicating a fact table join error.\"\n}\n#+begin\n  SELECT \n    business_unit_name, \n    total_revenue\n  FROM \n    {{ StorePerformanceNarratives() }}\n  WHERE \n    total_revenue <= 0\n#+end\n\n#+test sql Test_StorePerformanceNarratives_RankBounds()\n#+meta {\n  :doc \"Fails if any store has a revenue_rank outside the valid range (1 to total_store_count), indicating a window function error.\"\n}\n#+begin\n  SELECT \n    business_unit_name, \n    revenue_rank, \n    total_store_count\n  FROM \n    {{ StorePerformanceNarratives() }}\n  WHERE \n    revenue_rank <= 0\n    OR revenue_rank > total_store_count\n#+end\n","platform":null}},{"fqn":"/retail/landing/products","id":"d70e924a-a139-11f1-b6b0-6f90300261de","folder_id":"d70e1d18-a139-11f1-b6b0-6f90300261de","name":"products","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n\n-- Product catalog — randomly generated for demo purposes.\n-- Products are named generically (\"Product N\") with random category assignment.\n-- Count driven by numProducts in _config (default 50).\n\n#+src sql categories()\n#+begin\n  SELECT\n    ROW_NUMBER() OVER () AS category_id,\n    category_code,\n    category_name\n  FROM (\n    SELECT 'ELE' AS category_code, 'Electronics' AS category_name\n    UNION ALL SELECT 'GRO', 'Grocery'\n    UNION ALL SELECT 'BOO', 'Books'\n    UNION ALL SELECT 'TOL', 'Tools'\n    UNION ALL SELECT 'TOY', 'Toys'\n    UNION ALL SELECT 'GAR', 'Garden'\n    UNION ALL SELECT 'SPO', 'Sport'\n  ) categories;\n#+end\n\n#+src sql Products()\n#+meta {\n  :publication {\n    :type \"table\",\n    :name \"products\",\n    :schema \"landing\"\n  }\n}\n#+begin\n  WITH products AS (\n    SELECT\n      ROW_NUMBER() OVER ()                                                   AS id,\n      'Product ' || ROW_NUMBER() OVER ()                                     AS name,\n      (random() * (SELECT COUNT(*) - 1 FROM {{ categories() }}))::int + 1    AS category_id\n    FROM {{ Series(numProducts) }} AS s\n  )\n\n  SELECT\n    p.id,\n    p.name,\n    c.category_code,\n    c.category_name\n  FROM products p\n  INNER JOIN {{ categories() }} c\n    ON c.category_id = p.category_id\n#+end\n","platform":null}},{"fqn":"/retail/derived_attributes/persona_rfm","id":"d72415a2-a139-11f1-b6b0-6f90300261de","folder_id":"d723ee91-a139-11f1-b6b0-6f90300261de","name":"persona_rfm","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base/sales\"\n\n#+src sql PersonaRFMValues()\n#+meta {\n  :doc \"Calculate customer RFM values.\"\n}\n#+begin\n  SELECT\n    persona_key,\n    MIN(sh.transaction_datetime) AS first_order,\n    MAX(sh.transaction_datetime) AS recent_order,\n    COUNT(sh.transaction_id) AS total_orders,\n    SUM(sd.unit_quantity * sd.unit_price_amount) AS total_sales\n  FROM\n    {{ sales.SalesDetail() }} sd\n  INNER JOIN {{ sales.SalesHeader() }} sh\n    ON sh.sales_header_key = sd.sales_header_key\n  GROUP BY\n    persona_key\n#+end\n\n#+src sql PersonaRFMSegments()\n#+meta {\n  :doc \"Calculate customer RFM segment.\"\n}\n#+begin\n  WITH t AS (\n    SELECT\n      persona_key,\n      rfm_recency,\n      rfm_frequency,\n      rfm_monetary,\n      rfm_recency * 100 + rfm_frequency * 10 + rfm_monetary AS rfm_cell\n    FROM\n      {{ rfmQuantiles() }}\n  )\n  SELECT\n    persona_key,\n    rfm_recency,\n    rfm_frequency,\n    rfm_monetary,\n    rfm_cell,\n    CASE\n      WHEN rfm_cell IN (355,255) THEN 'Cannot lose'\n      WHEN rfm_cell IN (543,542,453,452) THEN 'Active fans'\n      WHEN rfm_cell IN (525,524,515,514) THEN 'Promising newbies'\n      WHEN rfm_cell IN (335,334,325,324) THEN 'Potential churners'\n      ELSE 'Other'\n    END AS rfm_segment\n  FROM\n    t\n  ORDER BY 6 DESC\n#+end\n\n#+src sql rfmQuantiles()\n#+begin\n  SELECT\n    persona_key,\n    NTILE(5) OVER ( ORDER BY recent_order ) AS rfm_recency,\n    NTILE(5) OVER ( ORDER BY total_orders ) AS rfm_frequency,\n    NTILE(5) OVER ( ORDER BY total_sales ) AS rfm_monetary\n  FROM\n    {{ PersonaRFMValues() }} AS p\n  ORDER BY 2 DESC\n#+end\n","platform":null}},{"fqn":"/retail/semantic_layer/offering","id":"d721084f-a139-11f1-b6b0-6f90300261de","folder_id":"d71f3383-a139-11f1-b6b0-6f90300261de","name":"offering","entity_type":"folder","entity_version":"yuejdx2WRvwKW+oWUZvn3t+tBPch+AlttiMAQqrWNc0=","data":{"folder_type":"REGULAR","copied_from_id":{"uuid":"2a59a0f1-3cff-11f1-a457-d9456ae162d8"}}},{"fqn":"/retail/landing_ai/sales","id":"d70c6f62-a139-11f1-b6b0-6f90300261de","folder_id":"d70bfa31-a139-11f1-b6b0-6f90300261de","name":"sales","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/print\"\n#+import \"std/publication\"\n#+import \"coginiti.co/foundation/retail/landing\"\n\n-- AI-driven sales data with realistic product prices.\n-- ProductPrices() receives the actual product catalog from Products() and\n-- asks the LLM to assign a market-appropriate price to each specific item.\n-- Sales() uses those prices instead of the random 1–100 USD range.\n-- Publishes to the same landing.sales table.\n\n#+src llm ProductPrices()\n#+meta {\n  :schema {\n    :columns [\n      {:name \"product_id\", :type \"INT\", :description \"Product ID matching the catalog\"},\n      {:name \"unit_price\", :type \"DECIMAL\", :description \"Realistic retail price in USD, e.g. 49.99\"}\n    ]\n  },\n  :cache_results true\n}\n#+begin\nBelow is a retail product catalog. For every row assign a realistic, market-appropriate\nretail price in USD.\n\n{{ print.Csv(landing.Products()) }}\n\nRules:\n- Return exactly one row per product_id — same IDs as in the catalog above.\n- Prices must be positive numbers with up to 2 decimal places.\n- Use realistic retail prices (e.g. 49.99, 129.00, 1299.99) — not plain round numbers.\n- Vary prices within the same category — do not assign the same price to all items.\n- Use plain ASCII only.\n\nTypical price ranges by category (USD):\n  Electronics  : 29.99–1499.99  (budget accessories on the low end, flagship phones/TVs on the high end)\n  Grocery      : 1.49–18.99\n  Books        : 8.99–34.99\n  Tools        : 14.99–349.99   (hand tools low, power tools high)\n  Toys         : 9.99–149.99\n  Garden       : 4.99–299.99\n  Sport        : 14.99–899.99   (small gear low, bicycles high)\n#+end;\n\n\n#+src sql Sales()\n#+meta {\n  :publication {\n    :type \"table\",\n    :name \"sales\",\n    :schema \"landing\"\n  }\n}\n#+begin\n  WITH\n  -- One row per transaction: header attributes + random line item count (1–5)\n  tx AS (\n    SELECT\n      id                                                                    AS transaction_id,\n      '{{ transactionsStartDate }}'::TIMESTAMPTZ\n        + random() * ('{{ transactionsEndDate }}'::TIMESTAMPTZ\n                    - '{{ transactionsStartDate }}'::TIMESTAMPTZ)           AS transaction_timestamp,\n      FLOOR(random() * {{ numCustomers }})::INT + 1                         AS customer_id,\n      'ST' || (FLOOR(random() * {{ numStores }})::INT + 1)                  AS store_id,\n      FLOOR(random() * 5)::INT + 1                                          AS num_items\n    FROM {{ landing.Series(numSalesTransations) }}\n  ),\n\n  -- Expand each transaction to its line item slots (max 5 slots, trimmed to num_items)\n  lines AS (\n    SELECT\n      tx.transaction_id,\n      tx.transaction_timestamp,\n      tx.customer_id,\n      tx.store_id,\n      slot.n                                                                AS line_slot\n    FROM tx\n    CROSS JOIN (VALUES (1),(2),(3),(4),(5)) AS slot(n)\n    WHERE slot.n <= tx.num_items\n  ),\n\n  -- Assign a random product and quantity to each line slot\n  line_products AS (\n    SELECT\n      transaction_id,\n      transaction_timestamp,\n      customer_id,\n      store_id,\n      line_slot,\n      FLOOR(random() * {{ numProducts }})::INT + 1                          AS product_id,\n      (random() * 15)::INT + 1                                              AS quantity\n    FROM lines\n  )\n\n  SELECT\n    ROW_NUMBER() OVER ()                                                    AS id,\n    lp.transaction_id,\n    lp.transaction_timestamp,\n    ROW_NUMBER() OVER (PARTITION BY lp.transaction_id ORDER BY lp.line_slot) AS line_number,\n    lp.customer_id,\n    lp.store_id,\n    lp.product_id,\n    pp.unit_price                                                           AS product_price,\n    lp.quantity\n  FROM line_products lp\n  JOIN {{ ProductPrices() }} pp ON pp.product_id = lp.product_id\n#+end\n","platform":null}},{"fqn":"/retail/mart/date_dimension","id":"d71e973f-a139-11f1-b6b0-6f90300261de","folder_id":"d71dacd9-a139-11f1-b6b0-6f90300261de","name":"date_dimension","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"coginiti.co/foundation/retail/base/datetime\"\n\n#+src sql DateDimension()\n#+meta {\n  :doc \"This dimension stores all available DATE AND TIME hierarchies associated with a date.\",\n  :publication {\n    :type \"table\",\n    :name \"date_dimension\",\n    :schema \"mart\"\n  }\n}\n#+begin\n  SELECT\n    d.date_key,\n    d.business_day_date,\n    d.calendar_year,\n    d.calendar_quarter,\n    d.calendar_month,\n    d.calendar_week,\n    d.calendar_week_day,\n    d.calendar_holiday_flag,\n    d.fiscal_year,\n    d.fiscal_quarter,\n    d.fiscal_period,\n    d.fiscal_week,\n    d.fiscal_week_day,\n    d.fiscal_holiday_flag\n  FROM\n    {{ datetime.Date() }} d\n#+end\n","platform":null}},{"fqn":"/retail/landing/countries","id":"d70fcad2-a139-11f1-b6b0-6f90300261de","folder_id":"d70e1d18-a139-11f1-b6b0-6f90300261de","name":"countries","entity_type":"sql_entity","entity_version":"PYP6lsrfBDejJ/EjgUlwaNgHo8R4LDRYiMVxU8nR+8k=","data":{"executed_count":0,"executed_at":null,"copied_from_id":null,"asset_type":"CSL","content":"#+import \"std/publication\"\n\n-- Country reference data with ISO codes and regional classification.\n-- Static dataset — 250 countries, no random generation.\n\n#+src sql Countries()\n#+meta {\n  :publication {\n    :type \"table\",\n    :name \"countries\",\n    :schema \"landing\"\n  }\n}\n#+begin\n  CREATE TEMPORARY TABLE tmp_countries(\n    country_code_2chars CHAR(2)      NOT NULL,\n    country_code_3chars CHAR(3)      NOT NULL,\n    \"name\"              VARCHAR(255) NOT NULL,\n    country_num_code    INTEGER      NOT NULL,\n    region              VARCHAR(255) NOT NULL\n  );\n\n  INSERT INTO tmp_countries (country_code_2chars, country_code_3chars, \"name\", country_num_code, region) VALUES\n    ('AF','AFG','Afghanistan',4,'Asia'),\n    ('AX','ALA','Åland Islands',248,'Europe'),\n    ('AL','ALB','Albania',8,'Europe'),\n    ('DZ','DZA','Algeria',12,'Africa'),\n    ('AS','ASM','American Samoa',16,'Oceania'),\n    ('AD','AND','Andorra',20,'Europe'),\n    ('AO','AGO','Angola',24,'Africa'),\n    ('AI','AIA','Anguilla',660,'Americas'),\n    ('AQ','ATA','Antarctica',10,'Antarctica'),\n    ('AG','ATG','Antigua and Barbuda',28,'Americas'),\n    ('AR','ARG','Argentina',32,'Americas'),\n    ('AM','ARM','Armenia',51,'Asia'),\n    ('AW','ABW','Aruba',533,'Americas'),\n    ('AU','AUS','Australia',36,'Oceania'),\n    ('AT','AUT','Austria',40,'Europe'),\n    ('AZ','AZE','Azerbaijan',31,'Asia'),\n    ('BS','BHS','Bahamas',44,'Americas'),\n    ('BH','BHR','Bahrain',48,'Asia'),\n    ('BD','BGD','Bangladesh',50,'Asia'),\n    ('BB','BRB','Barbados',52,'Americas'),\n    ('BY','BLR','Belarus',112,'Europe'),\n    ('BE','BEL','Belgium',56,'Europe'),\n    ('BZ','BLZ','Belize',84,'Americas'),\n    ('BJ','BEN','Benin',204,'Africa'),\n    ('BM','BMU','Bermuda',60,'Americas'),\n    ('BT','BTN','Bhutan',64,'Asia'),\n    ('BO','BOL','Bolivia',68,'Americas'),\n    ('BA','BIH','Bosnia and Herzegovina',70,'Europe'),\n    ('BW','BWA','Botswana',72,'Africa'),\n    ('BV','BVT','Bouvet Island',74,'Antarctica'),\n    ('BR','BRA','Brazil',76,'Americas'),\n    ('IO','IOT','British Indian Ocean Territory',86,'Asia'),\n    ('BN','BRN','Brunei',96,'Asia'),\n    ('BG','BGR','Bulgaria',100,'Europe'),\n    ('BF','BFA','Burkina Faso',854,'Africa'),\n    ('BI','BDI','Burundi',108,'Africa'),\n    ('KH','KHM','Cambodia',116,'Asia'),\n    ('CM','CMR','Cameroon',120,'Africa'),\n    ('CA','CAN','Canada',124,'Americas'),\n    ('CV','CPV','Cape Verde',132,'Africa'),\n    ('KY','CYM','Cayman Islands',136,'Americas'),\n    ('CF','CAF','Central African Republic',140,'Africa'),\n    ('TD','TCD','Chad',148,'Africa'),\n    ('CL','CHL','Chile',152,'Americas'),\n    ('CN','CHN','China',156,'Asia'),\n    ('CX','CXR','Christmas Island',162,'Oceania'),\n    ('CC','CCK','Cocos (Keeling) Islands',166,'Oceania'),\n    ('CO','COL','Colombia',170,'Americas'),\n    ('KM','COM','Comoros',174,'Africa'),\n    ('CG','COG','Congo',178,'Africa'),\n    ('CD','COD','Congo, the Democratic Republic of the',180,'Africa'),\n    ('CK','COK','Cook Islands',184,'Oceania'),\n    ('CR','CRI','Costa Rica',188,'Americas'),\n    ('CI','CIV','Côte d''Ivoire',384,'Africa'),\n    ('HR','HRV','Croatia',191,'Europe'),\n    ('CU','CUB','Cuba',192,'Americas'),\n    ('CY','CYP','Cyprus',196,'Europe'),\n    ('CZ','CZE','Czech Republic',203,'Europe'),\n    ('DK','DNK','Denmark',208,'Europe'),\n    ('DJ','DJI','Djibouti',262,'Africa'),\n    ('DM','DMA','Dominica',212,'Americas'),\n    ('DO','DOM','Dominican Republic',214,'Americas'),\n    ('EC','ECU','Ecuador',218,'Americas'),\n    ('EG','EGY','Egypt',818,'Africa'),\n    ('SV','SLV','El Salvador',222,'Americas'),\n    ('GQ','GNQ','Equatorial Guinea',226,'Africa'),\n    ('ER','ERI','Eritrea